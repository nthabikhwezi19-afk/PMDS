@model PMDSSystems.Models.ChangePasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "First Time Login";
}
@{
    ViewData["Title"] = "First Time Login";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  
    <title>First Time Login - PMDS</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: #f3f6f4;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 20px;
            color: #1f2937;
        }

        /* =========================
               MAIN CARD
            ========================= */

        .change-password-card {
            width: 100%;
            max-width: 560px;
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 45px rgba(0, 77, 43, 0.12);
        }

        /* =========================
               HEADER
            ========================= */

        .brand-header {
            background: linear-gradient( 135deg, #004d2b 0%, #006838 55%, #087a4c 100% );
            color: white;
            text-align: center;
            padding: 32px 30px 30px;
        }

        .brand-logo {
            width: 75px;
            height: 75px;
            object-fit: contain;
            margin-bottom: 15px;
        }

        .brand-header h1 {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 7px;
        }

            .brand-header h1 span {
                color: #e3c568;
            }

        .brand-header p {
            font-size: 0.9rem;
            opacity: 0.9;
            margin: 0;
        }

        /* =========================
               FORM AREA
            ========================= */

        .form-section {
            padding: 38px 42px 32px;
        }

        .form-heading {
            text-align: left;
            margin-bottom: 25px;
        }

            .form-heading h2 {
                color: #006838;
                font-size: 1.55rem;
                font-weight: 750;
                margin-bottom: 7px;
            }

            .form-heading p {
                color: #667085;
                font-size: 0.92rem;
                line-height: 1.5;
                margin: 0;
            }

        /* =========================
               WARNING
            ========================= */

        .warning-box {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            background: #fff9e9;
            border: 1px solid #f2dfad;
            border-left: 4px solid #d9a441;
            border-radius: 10px;
            padding: 15px 16px;
            margin-bottom: 28px;
            color: #795b20;
            font-size: 0.86rem;
            line-height: 1.55;
        }

        .warning-icon {
            color: #d59b2d;
            font-size: 1rem;
            margin-top: 2px;
            flex-shrink: 0;
        }

        /* =========================
               VALIDATION
            ========================= */

        .validation-summary {
            background: #fff1f0;
            border: 1px solid #f3c2bf;
            border-radius: 10px;
            padding: 12px 15px;
            margin-bottom: 22px;
            color: #b42318;
            font-size: 0.85rem;
        }

            .validation-summary ul {
                margin: 0;
                padding-left: 18px;
            }

        /* =========================
               FORM GROUP
            ========================= */

        .form-group {
            margin-bottom: 21px;
        }

            .form-group label {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 0.88rem;
                font-weight: 650;
                color: #344054;
                margin-bottom: 8px;
            }

                .form-group label i {
                    width: 17px;
                    text-align: center;
                    color: #006838;
                    font-size: 0.9rem;
                }

        /* =========================
               INPUTS
            ========================= */

        .input-wrapper {
            position: relative;
            width: 100%;
        }

        .form-control {
            width: 100%;
            height: 48px;
            border: 1px solid #d9e2dc;
            border-radius: 10px;
            background: #fbfcfb;
            padding: 0 15px;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            color: #1f2937;
            transition: all 0.2s ease;
        }

            .form-control::placeholder {
                color: #98a2b3;
            }

            .form-control:hover {
                border-color: #b8cabe;
                background: #ffffff;
            }

            .form-control:focus {
                outline: none;
                border-color: #006838;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(0, 104, 56, 0.10);
            }

        /* =========================
               PASSWORD REQUIREMENT
            ========================= */

        .password-hint {
            margin-top: 7px;
            font-size: 0.76rem;
            color: #98a2b3;
        }

        /* =========================
               BUTTON
            ========================= */

        .btn-save {
            width: 100%;
            height: 50px;
            margin-top: 5px;
            border: none;
            border-radius: 10px;
            background: #006838;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            transition: all 0.2s ease;
        }

            .btn-save:hover {
                background: #004d2b;
                box-shadow: 0 6px 15px rgba(0, 77, 43, 0.18);
                transform: translateY(-1px);
            }

            .btn-save:active {
                transform: translateY(0);
            }

            .btn-save i {
                font-size: 0.9rem;
            }

        /* =========================
               FOOTER
            ========================= */

        .footer {
            border-top: 1px solid #edf1ee;
            margin-top: 30px;
            padding-top: 18px;
            text-align: center;
            color: #98a2b3;
            font-size: 0.75rem;
        }

            .footer i {
                color: #006838;
                margin-right: 5px;
            }

        /* =========================
               MOBILE
            ========================= */

        @@media (max-width: 600px) {

            body {
                padding: 15px;
                align-items: flex-start;
                padding-top: 25px;
            }

            .change-password-card {
                border-radius: 16px;
            }

            .brand-header {
                padding: 27px 20px;
            }

            .brand-logo {
                width: 65px;
                height: 65px;
            }

            .brand-header h1 {
                font-size: 1.65rem;
            }

            .form-section {
                padding: 30px 24px 25px;
            }

            .form-heading h2 {
                font-size: 1.4rem;
            }

            .warning-box {
                font-size: 0.82rem;
            }
        }

    </style>
   

</head>

<body>

   
    <div class="change-password-card">

        <!-- =========================
             PMDS HEADER
        ========================== -->

        <div class="brand-header">

            <img src="~/images/dcslogo.png"
                 alt="Department of Correctional Services Logo"
                 class="brand-logo" />

            <h1>
                Welcome to <span>PMDS</span>
            </h1>

            <p>
                Department of Correctional Services
            </p>

        </div>


        <!-- =========================
             FORM SECTION
        ========================== -->

        <div class="form-section">

            <div class="form-heading">

                <h2>
                    First Time Login
                </h2>

                <p>
                    Please change your temporary password before continuing.
                </p>

            </div>


            <!-- =========================
                 WARNING
            ========================== -->

            <div class="warning-box">

                <i class="fa-solid fa-triangle-exclamation warning-icon"></i>

                <div>
                    This account is currently using a temporary password
                    supplied by the system administrator. For security reasons,
                    you must create your own password.
                </div>

            </div>


            <!-- =========================
                 FORM
            ========================== -->

            <form asp-controller="Account"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="userId"
                       value="@Model.UserId" />


                <!-- VALIDATION -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">

                        @Html.ValidationSummary(false)

                    </div>
                }


                <!-- TEMPORARY PASSWORD -->

                <div class="form-group">

                    <label for="currentPassword">

                        <i class="fa-solid fa-key"></i>

                        Temporary Password

                    </label>

                    <input type="password"
                           id="currentPassword"
                           name="currentPassword"
                           class="form-control"
                           placeholder="Enter your temporary password"
                           autocomplete="current-password"
                           required />

                </div>


                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label for="newPassword">

                        <i class="fa-solid fa-lock"></i>

                        New Password

                    </label>

                    <input type="password"
                           id="newPassword"
                           name="newPassword"
                           class="form-control"
                           placeholder="Enter your new password"
                           minlength="6"
                           autocomplete="new-password"
                           required />

                    <div class="password-hint">
                        Password must contain at least 6 characters.
                    </div>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label for="confirmPassword">

                        <i class="fa-solid fa-shield-halved"></i>

                        Confirm Password

                    </label>

                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           class="form-control"
                           placeholder="Confirm your new password"
                           minlength="6"
                           autocomplete="new-password"
                           required />

                </div>


                <!-- BUTTON -->

                <button type="submit"
                        class="btn-save">

                    <i class="fa-solid fa-check"></i>

                    Change Password

                </button>

            </form>


            <!-- =========================
                 FOOTER
            ========================== -->

            <div class="footer">

                <i class="fa-solid fa-shield-halved"></i>

                PMDS &bull; Department of Correctional Services

            </div>

        </div>

    </div>

</body>
</html>
