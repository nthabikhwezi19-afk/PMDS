
@model PMDSSystems.ViewModels.CyclesViewModel

@{
    ViewData["Title"] = "PMDS Performance Cycles";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>PMDS Cycles</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          rel="stylesheet" />

    <style>

        /* =========================================================
                   GENERAL
                ========================================================= */

        body {
            background: #f4f6f9;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #333;
        }

        .container {
            max-width: 1200px;
        }


        /* =========================================================
                   HEADER
                ========================================================= */

        .header {
            background: linear-gradient(135deg, #006838, #004d2b);
            color: white;
            padding: 30px 35px;
            border-radius: 15px;
            margin-top: 30px;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

            .header h2 {
                font-weight: 700;
                margin-bottom: 8px;
                font-size: 28px;
            }

            .header p {
                opacity: .95;
                font-size: 15px;
            }


        /* =========================================================
                   EMPLOYEE INFORMATION CARD
                ========================================================= */

        .employee-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-top: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
        }

        .employee-info-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 22px;
        }

        .employee-info-title {
            color: #006838;
            font-size: 21px;
            font-weight: 700;
            margin: 0;
        }

        .employee-info-subtitle {
            display: block;
            margin-top: 5px;
            color: #6c757d;
            font-size: 14px;
        }


        /* =========================================================
                   EDIT MY DETAILS BUTTON
                ========================================================= */

        .btn-edit-profile {
            background-color: #006838;
            color: #ffffff !important;
            border: 1px solid #006838;
            padding: 10px 18px;
            border-radius: 8px;
            text-decoration: none !important;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            cursor: pointer;
        }

            .btn-edit-profile:hover {
                background-color: #004d2b;
                border-color: #004d2b;
                color: #ffffff !important;
            }

        /* =========================================================
                   EMPLOYEE DETAILS
                ========================================================= */

        .employee-detail {
            background: #f8faf9;
            border: 1px solid #e1e9e4;
            border-radius: 9px;
            padding: 14px 16px;
            min-height: 78px;
            height: 100%;
            transition: all .2s ease;
        }

            .employee-detail:hover {
                background: #f3f9f6;
                border-color: #b9d8c7;
            }

        .detail-label {
            display: block;
            color: #006838;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
        }

            .detail-label i {
                width: 20px;
                margin-right: 4px;
            }

        .detail-value {
            display: block;
            color: #333;
            font-size: 15px;
            font-weight: 500;
            line-height: 1.4;
            word-break: break-word;
        }


        /* =========================================================
                   PERFORMANCE CYCLE SECTION
                ========================================================= */

        .cycles-section {
            margin-top: 25px;
        }

        .cycle-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
            transition: .3s;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

            .cycle-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0,0,0,.12);
            }

        .cycle-title {
            color: #006838;
            font-weight: 700;
            margin-bottom: 15px;
            font-size: 21px;
        }

        .cycle-icon {
            font-size: 26px;
            margin-right: 8px;
        }

        .cycle-card p {
            color: #555;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .cycle-button-area {
            margin-top: auto;
        }


        /* =========================================================
                   START BUTTON
                ========================================================= */

        .btn-start {
            background: #006838;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: .3s;
        }

            .btn-start:hover {
                background: #004d2b;
                color: white;
                transform: translateY(-2px);
            }


        /* =========================================================
                   ASSIGNED EMPLOYEES
                ========================================================= */

        .assigned-section {
            margin-top: 25px;
        }

        .assigned-card {
            background: white;
            border-radius: 15px;
            padding: 22px 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
        }

        .assigned-employees-link {
            color: #006838;
            text-decoration: none;
            font-weight: 700;
            font-size: 18px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: .2s ease;
        }

            .assigned-employees-link:hover {
                color: #004d2b;
                text-decoration: none;
            }

        .assigned-arrow {
            transition: transform .2s ease;
        }

        .assigned-employees-link:hover .assigned-arrow {
            transform: translateX(5px);
        }


        /* =========================================================
                   ASSIGNED EMPLOYEES TABLE
                ========================================================= */

        .employees-table {
            margin-top: 15px;
        }

            .employees-table thead th {
                background: #006838 !important;
                color: white;
                font-weight: 600;
                vertical-align: middle;
            }

            .employees-table tbody td {
                vertical-align: middle;
            }

            .employees-table tbody tr:hover {
                background: #f0f8f4;
            }


        /* =========================================================
                   VIEW EMPLOYEE BUTTON
                ========================================================= */

        .btn-view {
            background: #006838;
            color: white;
            border: none;
            padding: 7px 15px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: .3s;
        }

            .btn-view:hover {
                background: #004d2b;
                color: white;
                transform: translateY(-2px);
            }


        /* =========================================================
                   NO EMPLOYEES MESSAGE
                ========================================================= */

        .no-employees {
            border-left: 5px solid #006838;
            background: #f0f8f4;
            padding: 15px 20px;
            border-radius: 8px;
            color: #333;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 768px) {

            .header {
                padding: 25px 20px;
                margin-top: 20px;
            }

                .header h2 {
                    font-size: 23px;
                }

            .employee-card {
                padding: 20px;
            }

            .employee-info-header {
                align-items: flex-start;
            }

            .employee-info-title {
                font-size: 19px;
            }

            .btn-edit-profile {
                padding: 9px 14px;
                font-size: 13px;
            }

            .cycle-card {
                padding: 25px;
            }
        }


        @@media (max-width: 576px) {

            .employee-info-header {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-edit-profile {
                width: 100%;
            }

            .btn-start {
                width: 100%;
            }

            .cycle-title {
                font-size: 19px;
            }

            .assigned-card {
                padding: 20px;
            }
        }

    </style>

</head>


<body>

    <div class="container">


        <!-- =====================================================
             WELCOME HEADER
        ====================================================== -->

        <div class="header">

            <h2>

                <i class="fa-solid fa-user me-2"></i>

                Welcome,
                @Model.Employee.FirstName
                @Model.Employee.LastName

            </h2>

            <p class="mb-0">

                Performance Management and Development System

            </p>

        </div>


        <!-- =====================================================
             EMPLOYEE INFORMATION
        ====================================================== -->

        <div class="employee-card">

            <div class="employee-info-header">

                <div>

                    <h4 class="employee-info-title">

                        <i class="fa-solid fa-id-card me-2"></i>

                        Employee Information

                    </h4>

                    <span class="employee-info-subtitle">

                        Your personal and employment details

                    </span>

                </div>


                <a href="@Url.Action("Edit", "Employee", new { id = Model.Employee.Id })"
                   class="btn-edit-profile">
                    <i class="fa-solid fa-pen-to-square"></i>
                    Edit My Details
                </a>

            </div>


            <!-- =================================================
                 EMPLOYEE DETAILS
            ================================================== -->

            <div class="row g-3">

                <!-- Persal Number -->

                <div class="col-md-6">

                    <div class="employee-detail">

                        <span class="detail-label">

                            <i class="fa-solid fa-id-badge"></i>

                            Persal Number

                        </span>

                        <span class="detail-value">

                            @Model.Employee.PersalNumber

                        </span>

                    </div>

                </div>


                <!-- Email -->

                <div class="col-md-6">

                    <div class="employee-detail">

                        <span class="detail-label">

                            <i class="fa-solid fa-envelope"></i>

                            Email

                        </span>

                        <span class="detail-value">

                            @Model.Employee.Email

                        </span>

                    </div>

                </div>


                <!-- Position -->

                <div class="col-md-6">

                    <div class="employee-detail">

                        <span class="detail-label">

                            <i class="fa-solid fa-briefcase"></i>

                            Position

                        </span>

                        <span class="detail-value">

                            @Model.Employee.Position

                        </span>

                    </div>

                </div>


                <!-- Department -->

                <div class="col-md-6">

                    <div class="employee-detail">

                        <span class="detail-label">

                            <i class="fa-solid fa-building"></i>

                            Department

                        </span>

                        <span class="detail-value">

                            @Model.Employee.Department

                        </span>

                    </div>

                </div>


                <!-- Supervisor -->

                <div class="col-md-6">

                    <div class="employee-detail">

                        <span class="detail-label">

                            <i class="fa-solid fa-user-tie"></i>

                            Supervisor

                        </span>

                        <span class="detail-value">

                            @Model.Employee.SupervisorSurnameInitials

                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PERFORMANCE CYCLES
        ====================================================== -->

        <div class="cycles-section">

            <div class="row g-4">


                <!-- =================================================
                     PERFORMANCE AGREEMENT
                ================================================== -->

                <div class="col-md-6">

                    <div class="cycle-card">

                        <h3 class="cycle-title">

                            <i class="fa-solid fa-calendar-check cycle-icon"></i>

                            Performance Agreement

                        </h3>

                        <p>

                            Complete your Performance Agreement,
                            Development Plan and all required
                            PMDS documents.

                        </p>

                        <div class="cycle-button-area">

                            <a href="/PMDS/Create"
                               class="btn-start">

                                <i class="fa-solid fa-play"></i>

                                Start Performance Agreement

                            </a>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     MID-TERM REVIEW
                ================================================== -->

                <div class="col-md-6">

                    <div class="cycle-card">

                        <h3 class="cycle-title">

                            <i class="fa-solid fa-calendar cycle-icon"></i>

                            Mid-Term Review & Annual Assessment

                        </h3>

                        <p>

                            This cycle will become available
                            once the first cycle has been completed.

                        </p>

                        <div class="cycle-button-area">

                            <a href="/PMDS/MidTermReview"
                               class="btn-start">

                                <i class="fa-solid fa-play"></i>

                                Start Mid-Term Review

                            </a>

                        </div>

                    </div>

                </div>


            </div>

        </div>


        <!-- =====================================================
             MY ASSIGNED EMPLOYEES
             APPEARS UNDER PERFORMANCE CYCLES
             ONLY FOR SUPERVISORS WITH ASSIGNED EMPLOYEES
        ====================================================== -->
        @if (Model.MyEmployees != null && Model.MyEmployees.Any())
        {

            <div class="assigned-section">

                <div class="assigned-card">

                    <a href="@Url.Action("MyAssignedEmployees", "Supervisor")"
                       class="assigned-employees-link">

                        <i class="fa-solid fa-users"></i>

                        <span>My Assigned Employees</span>

                        <i class="fa-solid fa-arrow-right assigned-arrow"></i>

                    </a>

                </div>

            </div>

        }


        <!-- =====================================================
             FOOTER SPACE
        ====================================================== -->

        <div style="height: 40px;"></div>


    </div>


    <!-- =========================================================
         BOOTSTRAP JAVASCRIPT
    ========================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>

