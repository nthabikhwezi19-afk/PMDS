@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background: #f4f6f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dashboard-container {
        padding: 40px;
        max-width: 1200px;
        margin: auto;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

        .dashboard-header h1 {
            color: #004d2b;
            font-weight: 800;
        }

        .dashboard-header p {
            color: #6b7280;
        }

    /* GRID */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 25px;
    }

    /* CARD */
    .dashboard-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
        transition: 0.3s ease;
        border-left: 6px solid #006838;
    }

        .dashboard-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0, 104, 56, 0.15);
        }

    .card-icon {
        font-size: 28px;
        margin-bottom: 15px;
        color: #006838;
    }

    .dashboard-card h4 {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .dashboard-card p {
        color: #6b7280;
        font-size: 0.95rem;
        margin-bottom: 20px;
    }

    .dashboard-card a {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-green {
        background: #006838;
        color: white;
    }

        .btn-green:hover {
            background: #004d2b;
        }

    .btn-outline {
        border: 2px solid #006838;
        color: #006838;
    }

        .btn-outline:hover {
            background: #006838;
            color: white;
        }

    /* STATS BOX */
    .stats-box {
        background: linear-gradient(135deg, #004d2b, #006838);
        color: white;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 30px;
    }

        .stats-box h2 {
            font-weight: 800;
        }

</style>

<div class="dashboard-container">

    <!-- HEADER -->
    <div class="dashboard-header">
        <h1>Admin Dashboard</h1>
        <p>Manage employees, monitor system activity, and control PMDS operations.</p>
    </div>

    <!-- OPTIONAL STATS -->
    <div class="stats-box">
        <h2>Total Employees: @ViewBag.TotalEmployees</h2>
        <p>Overview of registered employees in the system</p>
    </div>

    <!-- ACTION CARDS -->
    <div class="dashboard-grid">

        <!-- CREATE EMPLOYEE -->
        <div class="dashboard-card">
            <div class="card-icon">👤➕</div>
            <h4>Create Employee</h4>
            <p>Add a new employee into the PMDS system.</p>
            <a href="/Employee/Create">Add Employee</a>
            <a asp-area="Admin" asp-controller="Employee" asp-action="Create" class="btn btn-primary">
                Add Employee
            </a>
        </div>

        <!-- VIEW EMPLOYEES -->
        <div class="dashboard-card">
            <div class="card-icon">📋</div>
            <h4>View Employees</h4>
            <p>See all employees and manage their records.</p>
            <a href="/Employee/Index">View Employees</a>

            <a asp-area="Admin" asp-controller="Employee" asp-action="Index" class="btn btn-success">
                View Employees
            </a>
        </div>

        <!-- FUTURE FEATURE -->
        <div class="dashboard-card">
            <div class="card-icon">📊</div>
            <h4>Reports</h4>
            <p>Generate performance and system reports.</p>

            <a href="#" class="btn-outline">
                Coming Soon
            </a>
        </div>

    </div>

</div>