@{
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
    ViewData["Title"] = "Welcome";
}

<style>

    body {
        background: #f4f6f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* ===== TOP GOV HEADER ===== */
    .gov-header {
        background: #004d2b;
        color: white;
        padding: 12px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .gov-header img {
            height: 45px;
        }

        .gov-header span {
            font-size: 0.95rem;
            opacity: 0.9;
        }

    /* ===== MAIN WRAPPER ===== */
    .welcome-wrapper {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
    }

    .welcome-card {
        width: 100%;
        max-width: 1200px;
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
    }

    /* ===== HERO SECTION ===== */
    .welcome-top {
        background: linear-gradient(135deg, #004d2b, #006838);
        color: white;
        padding: 60px;
        position: relative;
    }

        .welcome-top::after {
            content: "";
            position: absolute;
            bottom: -30px;
            left: 0;
            width: 100%;
            height: 60px;
            background: white;
            border-top-left-radius: 40px;
            border-top-right-radius: 40px;
        }

        .welcome-top img {
            width: 85px;
            margin-bottom: 20px;
        }

        .welcome-top h1 {
            font-size: 2.8rem;
            font-weight: 800;
            margin-bottom: 15px;
        }

            .welcome-top h1 span {
                color: #e2c36d;
            }

        .welcome-top p {
            max-width: 600px;
            line-height: 1.7;
            opacity: 0.9;
        }

    /* FEATURES */
    .feature-row {
        margin-top: 30px;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .feature {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 0.85rem;
    }

        .feature i {
            color: #e2c36d;
            margin-right: 6px;
        }

    /* ===== ACTION SECTION ===== */
    .welcome-bottom {
        padding: 60px;
    }

        .welcome-bottom h2 {
            color: #004d2b;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .welcome-bottom .intro {
            color: #6b7280;
            margin-bottom: 30px;
        }

    .action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .action-card {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 25px;
        transition: 0.3s ease;
        background: #fff;
    }

        .action-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0, 104, 56, 0.12);
        }

    .action-icon {
        width: 50px;
        height: 50px;
        background: #e8f4ed;
        color: #006838;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        font-size: 1.3rem;
    }

    .action-card h5 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .action-card p {
        color: #6b7280;
        font-size: 0.95rem;
        margin-bottom: 18px;
    }

    /* BUTTONS */
    .btn-register {
        background: #006838;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

        .btn-register:hover {
            background: #004d2b;
            color: white;
        }

    .btn-login {
        border: 2px solid #006838;
        color: #006838;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-login:hover {
            background: #006838;
            color: white;
        }

    /* FOOTER STYLE */
    .gov-footer {
        text-align: center;
        padding: 15px;
        font-size: 0.85rem;
        color: #6b7280;
    }

    @@media(max-width:768px) {
        .welcome-top,
        .welcome-bottom {
            padding: 30px;
        }

            .welcome-top h1 {
                font-size: 2rem;
            }
    }

</style>
<!-- HEADER -->



<!-- MAIN -->

<div class="welcome-wrapper">

    <div class="welcome-card">

        <!-- HERO -->
        <div class="welcome-top">
            <h1>Welcome to <span>PMDS</span></h1>

            <p>
                The Performance Management and Development System enables structured
                management of employee performance, development planning, and
                performance agreements within the Department.
            </p>

            <div class="feature-row">
                <div class="feature">Agreements</div>
                <div class="feature">Reviews</div>
                <div class="feature">Development</div>
            </div>
        </div>

        <!-- LOGIN -->
        <div class="welcome-bottom">
            <h2>Access the System</h2>
            <p class="intro">Sign in to continue</p>

            <div class="action-card">
                <div class="action-icon">
                    <i class="fa-solid fa-right-to-bracket"></i>
                </div>

                <h5>User Login</h5>
                <p>Use your credentials to access the system.</p>

                <a href="/Account/Login" class="btn-login">
                    Login
                </a>
            </div>
        </div>

    </div>

@* <!-- ===== FOOTER ===== -->
<div class="gov-footer">
    © @DateTime.Now.Year Department of Correctional Services. All Rights Reserved.
</div> *@