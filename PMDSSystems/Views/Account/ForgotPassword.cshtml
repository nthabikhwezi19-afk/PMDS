@model PMDSSystems.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Forgot Password - PMDS</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter',sans-serif;
            background: linear-gradient(135deg,#f4f7f5,#eef5f1);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 25px;
        }

        .login-card {
            width: 100%;
            max-width: 520px;
            background: white;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,80,40,.12);
        }

        .login-brand {
            background: linear-gradient(145deg,#004d2b,#006838,#0b7a4b);
            color: white;
            text-align: center;
            padding: 40px;
        }

            .login-brand img {
                width: 90px;
                margin-bottom: 15px;
            }

            .login-brand h1 {
                font-size: 2.2rem;
                font-weight: 800;
            }

            .login-brand span {
                color: #e2c36d;
            }

            .login-brand p {
                margin-top: 10px;
                opacity: .9;
            }

        .login-form {
            padding: 40px;
        }

        h2 {
            color: #006838;
            margin-bottom: 10px;
            font-size: 1.9rem;
        }

        .intro {
            color: #667085;
            margin-bottom: 25px;
            line-height: 1.6;
        }

        .info {
            background: #eef8f2;
            border-left: 5px solid #006838;
            padding: 15px;
            border-radius: 12px;
            color: #14532d;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

            label i {
                color: #006838;
                width: 20px;
            }

        .form-control {
            width: 100%;
            padding: 14px 16px;
            border-radius: 14px;
            border: 1.5px solid #dfe7e2;
            background: #fafcfa;
            font-size: 15px;
        }

            .form-control:focus {
                outline: none;
                border-color: #006838;
                box-shadow: 0 0 0 4px rgba(0,104,56,.15);
                background: white;
            }

        .btn-save {
            width: 100%;
            background: #006838;
            color: white;
            border: none;
            border-radius: 14px;
            padding: 15px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: .3s;
        }

            .btn-save:hover {
                background: #004d2b;
                transform: translateY(-2px);
            }

        .validation-summary {
            margin-bottom: 20px;
            color: #c0392b;
        }

        .back {
            text-align: center;
            margin-top: 20px;
        }

            .back a {
                color: #006838;
                text-decoration: none;
                font-weight: 700;
            }

                .back a:hover {
                    text-decoration: underline;
                }

        .footer {
            margin-top: 25px;
            text-align: center;
            color: #98a2b3;
            font-size: .8rem;
        }

    </style>

</head>

<body>

    <div class="login-card">

        <div class="login-brand">

            <img src="~/images/dcslogo.png" />

            <h1>Welcome to <span>PMDS</span></h1>

            <p>Department of Correctional Services</p>

        </div>

        <div class="login-form">

            <h2>Forgot Password</h2>

            <p class="intro">
                Enter your registered email address and we'll send you a secure password reset link.
            </p>

            <div class="info">

                <i class="fa-solid fa-envelope-circle-check"></i>

                The reset link is valid for a limited time for your security.

            </div>

            <form asp-action="ForgotPassword" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="validation-summary"></div>

                <div class="form-group">

                    <label asp-for="Email">

                        <i class="fa-solid fa-envelope"></i>

                        Email Address

                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="you@dcs.gov.za" />

                </div>

                <button class="btn-save">

                    <i class="fa-solid fa-paper-plane"></i>

                    Send Reset Link

                </button>

            </form>

            <div class="back">

                <a href="/Account/Login">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Login

                </a>

            </div>

            <div class="footer">

                <i class="fa-solid fa-shield-halved"></i>

                PMDS • Department of Correctional Services

            </div>

        </div>

    </div>

</body>
</html>