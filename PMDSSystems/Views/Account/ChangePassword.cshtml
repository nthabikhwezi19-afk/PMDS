@model PMDSSystems.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "First Time Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>First Time Login - PMDS</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter',sans-serif;
            background: linear-gradient(135deg,#f4f7f5,#eef5f1);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 25px;
        }

        .login-card {
            width: 100%;
            max-width: 520px;
            background: #fff;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,80,40,.12);
        }

        .login-brand {
            background: linear-gradient(145deg,#004d2b,#006838,#0b7a4b);
            color: white;
            text-align: center;
            padding: 40px;
        }

            .login-brand img {
                width: 90px;
                margin-bottom: 15px;
            }

            .login-brand h1 {
                font-size: 2.2rem;
                font-weight: 800;
            }

            .login-brand span {
                color: #e2c36d;
            }

            .login-brand p {
                margin-top: 10px;
                opacity: .9;
            }

        .login-form {
            padding: 40px;
        }

        h2 {
            color: #006838;
            font-size: 1.8rem;
            margin-bottom: 8px;
        }

        .intro {
            color: #667085;
            margin-bottom: 25px;
        }

        .warning {
            background: #fff8e8;
            border-left: 5px solid #f0ad4e;
            color: #8a6d3b;
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
            color: #1f2937;
        }

            label i {
                color: #006838;
                width: 20px;
            }

        .form-control {
            width: 100%;
            border: 1.5px solid #e4ece7;
            border-radius: 14px;
            padding: 14px 16px;
            font-size: 1rem;
            background: #fafcfa;
        }

            .form-control:focus {
                outline: none;
                border-color: #006838;
                box-shadow: 0 0 0 4px rgba(0,104,56,.15);
                background: white;
            }

        .btn-save {
            width: 100%;
            border: none;
            background: #006838;
            color: white;
            padding: 15px;
            border-radius: 14px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: .3s;
        }

            .btn-save:hover {
                background: #004d2b;
                transform: translateY(-2px);
            }

        .validation-summary {
            margin-bottom: 20px;
            color: #b42318;
        }

        .footer {
            margin-top: 25px;
            text-align: center;
            color: #98a2b3;
            font-size: .8rem;
        }

    </style>

</head>

<body>

    <div class="login-card">

        <div class="login-brand">

            <img src="~/images/dcslogo.png" />

            <h1>Welcome to <span>PMDS</span></h1>

            <p>Department of Correctional Services</p>

        </div>

        <div class="login-form">

            <h2>First Time Login</h2>

            <p class="intro">

                Change your temporary password before continuing.

            </p>

            <div class="warning">

                <i class="fa-solid fa-triangle-exclamation"></i>

                This account is using a temporary password supplied by the system administrator.

                For security reasons you must create your own password.

            </div>

            <form asp-action="ChangePassword" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="userId"
                       value="@Model.UserId" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">
                        @Html.ValidationSummary(false)
                    </div>
                }

                <div class="form-group">

                    <label for="currentPassword">

                        <i class="fa-solid fa-key"></i>

                        Temporary Password

                    </label>

                    <input type="password"
                           id="currentPassword"
                           name="currentPassword"
                           class="form-control"
                           placeholder="Enter your temporary password"
                           required />

                </div>

                <div class="form-group">

                    <label for="newPassword">

                        <i class="fa-solid fa-lock"></i>

                        New Password

                    </label>

                    <input type="password"
                           id="newPassword"
                           name="newPassword"
                           class="form-control"
                           placeholder="Enter your new password"
                           minlength="6"
                           required />

                </div>

                <div class="form-group">

                    <label for="confirmPassword">

                        <i class="fa-solid fa-lock"></i>

                        Confirm Password

                    </label>

                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           class="form-control"
                           placeholder="Confirm your new password"
                           minlength="6"
                           required />

                </div>

                <button type="submit" class="btn-save">

                    <i class="fa-solid fa-check"></i>

                    Change Password

                </button>

            </form>

            <div class="footer">

                <i class="fa-solid fa-shield-halved"></i>

                PMDS • Department of Correctional Services

            </div>

        </div>

    </div>

 

</body>
</html>