@model PMDSSystems.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "First Time Login";
}

<!DOCTYPE html>

<html lang="en">
<head>


    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>First Time Login - PMDS</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f4f7f5, #eef5f1);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 25px;
        }

        .login-card {
            width: 100%;
            max-width: 520px;
            background: #fff;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 80, 40, .12);
        }

        .login-brand {
            background: linear-gradient(145deg, #004d2b, #006838, #0b7a4b);
            color: white;
            text-align: center;
            padding: 40px;
        }

            .login-brand img {
                width: 90px;
                margin-bottom: 15px;
            }

            .login-brand h1 {
                font-size: 2.2rem;
                font-weight: 800;
            }

            .login-brand span {
                color: #e2c36d;
            }

            .login-brand p {
                margin-top: 10px;
                opacity: .9;
            }

        .login-form {
            padding: 40px;
        }

        h2 {
            color: #006838;
            font-size: 1.8rem;
            margin-bottom: 8px;
        }

        .intro {
            color: #667085;
            margin-bottom: 20px;
        }

        /* EMAIL ACCOUNT */

        .account-email {
            background: #eef8f2;
            border: 1px solid #d5eadc;
            color: #006838;
            padding: 14px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: .95rem;
            word-break: break-word;
        }

            .account-email i {
                margin-right: 8px;
            }

        /* WARNING */

        .warning {
            background: #fff8e8;
            border-left: 5px solid #f0ad4e;
            color: #8a6d3b;
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 25px;
            line-height: 1.5;
        }

            .warning i {
                margin-right: 6px;
            }

        /* FORM */

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
            color: #1f2937;
        }

            label i {
                color: #006838;
                width: 20px;
            }

        .form-control {
            width: 100%;
            border: 1.5px solid #e4ece7;
            border-radius: 14px;
            padding: 14px 16px;
            font-size: 1rem;
            background: #fafcfa;
        }

            .form-control:focus {
                outline: none;
                border-color: #006838;
                box-shadow: 0 0 0 4px rgba(0, 104, 56, .15);
                background: white;
            }

        /* BUTTON */

        .btn-save {
            width: 100%;
            border: none;
            background: #006838;
            color: white;
            padding: 15px;
            border-radius: 14px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: .3s;
        }

            .btn-save:hover {
                background: #004d2b;
                transform: translateY(-2px);
            }

        /* VALIDATION */

        .validation-summary {
            margin-bottom: 20px;
            padding: 12px 15px;
            background: #fff1f0;
            border: 1px solid #f5c2c0;
            border-radius: 10px;
            color: #b42318;
        }

            .validation-summary ul {
                margin: 0;
                padding-left: 20px;
            }

        /* FOOTER */

        .footer {
            margin-top: 25px;
            text-align: center;
            color: #98a2b3;
            font-size: .8rem;
        }

    </style>
   

</head>

<body>

   
    <div class="login-card">

        <!-- HEADER -->

        <div class="login-brand">

            <img src="~/images/dcslogo.png"
                 alt="Department of Correctional Services Logo" />

            <h1>
                Welcome to <span>PMDS</span>
            </h1>

            <p>
                Department of Correctional Services
            </p>

        </div>


        <!-- FORM AREA -->

        <div class="login-form">

            <h2>
                First Time Login
            </h2>

            <p class="intro">
                Change your temporary password before continuing.
            </p>


            <!-- ACCOUNT EMAIL -->

            <div class="account-email">

                <i class="fa-solid fa-envelope"></i>

                <strong>
                    Account:
                </strong>

                @Model.Email

            </div>


            <!-- WARNING -->

            <div class="warning">

                <i class="fa-solid fa-triangle-exclamation"></i>

                <strong>Temporary Password</strong>

                <br />

                This account is using a temporary password supplied by
                the system administrator.

                For security reasons, you must create your own password.

            </div>


            <!-- CHANGE PASSWORD FORM -->

            <form asp-controller="Account"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="UserId" type="hidden" />

                <input asp-for="CurrentPassword"
                       type="password"
                       class="form-control"
                       required />

                <input asp-for="NewPassword"
                       type="password"
                       class="form-control"
                       required />

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control"
                       required />

                <button type="submit" class="btn btn-success">
                    Change Password
                </button>

            </form>
                <!-- USER ID -->

                <input type="hidden"
                       name="userId"
                       value="@Model.UserId" />


                <!-- VALIDATION -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">

                        @Html.ValidationSummary(false)

                    </div>
                }


                <!-- TEMPORARY PASSWORD -->

                <div class="form-group">

                    <label for="currentPassword">

                        <i class="fa-solid fa-key"></i>

                        Temporary Password

                    </label>

                    <input type="password"
                           id="currentPassword"
                           name="currentPassword"
                           class="form-control"
                           placeholder="Enter your temporary password"
                           autocomplete="current-password"
                           required />

                </div>


                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label for="newPassword">

                        <i class="fa-solid fa-lock"></i>

                        New Password

                    </label>

                    <input type="password"
                           id="newPassword"
                           name="newPassword"
                           class="form-control"
                           placeholder="Enter your new password"
                           autocomplete="new-password"
                           minlength="6"
                           required />

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label for="confirmPassword">

                        <i class="fa-solid fa-lock"></i>

                        Confirm New Password

                    </label>

                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           class="form-control"
                           placeholder="Confirm your new password"
                           autocomplete="new-password"
                           minlength="6"
                           required />

                </div>


                <!-- SUBMIT -->

                <button type="submit"
                        class="btn-save">

                    <i class="fa-solid fa-check"></i>

                    Change Password

                </button>

            </form>


            <!-- FOOTER -->

            <div class="footer">

                <i class="fa-solid fa-shield-halved"></i>

                PMDS • Department of Correctional Services

            </div>

        </div>

    </div>

</body>
</html>
