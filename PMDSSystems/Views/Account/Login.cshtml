@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>PMDS | Login</title>


    <!-- =========================================
         FONT AWESOME
    ========================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- =========================================
         GOOGLE FONT
    ========================================== -->

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />


    <style>

        /* =========================================
                   RESET
                ========================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
        }


        /* =========================================
                   BODY
                ========================================== */

        body {
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: linear-gradient( 135deg, #f3f7f5 0%, #e9f1ed 100% );
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
            color: #26352d;
        }


        /* =========================================
                   MAIN LOGIN CONTAINER

                   This keeps the design centered and
                   prevents it from filling the whole screen.
                ========================================== */

        .login-page {
            width: 100%;
            max-width: 680px;
            background: #ffffff;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 25px 70px rgba(0, 70, 40, 0.15);
            margin: auto;
        }


        /* =========================================
                   TOP GREEN PMDS SECTION
                ========================================== */

        .login-brand {
            width: 100%;
            min-height: 300px;
            background: linear-gradient( 135deg, #003d22 0%, #005b33 50%, #007a46 100% );
            color: #ffffff;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            text-align: center;
            position: relative;
            overflow: hidden;
            padding: 42px 25px 35px;
        }


            /* =========================================
                   DECORATIVE CIRCLE - TOP LEFT
                ========================================== */

            .login-brand::before {
                content: "";
                position: absolute;
                width: 350px;
                height: 350px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.035);
                top: -220px;
                left: -120px;
            }


            /* =========================================
                   DECORATIVE CIRCLE - BOTTOM RIGHT
                ========================================== */

            .login-brand::after {
                content: "";
                position: absolute;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.035);
                bottom: -310px;
                right: -120px;
            }


        /* =========================================
                   BRAND CONTENT
                ========================================== */

        .brand-content {
            width: 100%;
            position: relative;
            z-index: 2;
        }


        /* =========================================
                   DCS LOGO
                ========================================== */

        .logo-box {
            width: 92px;
            height: 92px;
            margin: 0 auto 17px;
            background: #ffffff;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
        }


            .logo-box img {
                width: 72px;
                height: 72px;
                object-fit: contain;
            }


        /* =========================================
                   PMDS TITLE
                ========================================== */

        .brand-title {
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: 2px;
            margin-bottom: 10px;
        }


            .brand-title span {
                color: #e2c36d;
            }


        /* =========================================
                   DESCRIPTION
                ========================================== */

        .brand-description {
            max-width: 400px;
            margin: 0 auto;
            color: rgba(255, 255, 255, 0.88);
            font-size: 14px;
            line-height: 1.6;
        }


        /* =========================================
                   GOLD LINE
                ========================================== */

        .brand-line {
            width: 55px;
            height: 3px;
            background: #e2c36d;
            margin: 18px auto 14px;
            border-radius: 10px;
        }


        /* =========================================
                   DEPARTMENT TEXT
                ========================================== */

        .brand-small-text {
            font-size: 11px;
            color: rgba(255, 255, 255, 0.70);
        }


        /* =========================================
                   BOTTOM WHITE LOGIN SECTION
                ========================================== */

        .login-form {
            width: 100%;
            background: #ffffff;
            display: flex;
            justify-content: center;
            padding: 38px 50px 35px;
        }


        /* =========================================
                   LOGIN CONTENT
                ========================================== */

        .login-content {
            width: 100%;
            max-width: 420px;
            margin: 0 auto;
        }


        /* =========================================
                   LOGIN HEADER
                ========================================== */

        .login-header {
            text-align: center;
            margin-bottom: 25px;
        }


        /* =========================================
                   LOGIN ICON
                ========================================== */

        .login-icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 11px;
            border-radius: 50%;
            background: #eaf5ef;
            color: #006838;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }


        /* =========================================
                   SIGN IN HEADING
                ========================================== */

        .login-header h2 {
            color: #006838;
            font-size: 27px;
            font-weight: 800;
            margin-bottom: 6px;
        }


        /* =========================================
                   SIGN IN DESCRIPTION
                ========================================== */

        .login-header p {
            color: #7c8882;
            font-size: 12px;
            line-height: 1.5;
        }


        /* =========================================
                   FORM GROUP
                ========================================== */

        .form-group {
            margin-bottom: 18px;
        }


            /* =========================================
                   LABEL
                ========================================== */

            .form-group label {
                display: block;
                margin-bottom: 7px;
                color: #26352d;
                font-size: 13px;
                font-weight: 600;
            }


        /* =========================================
                   INPUT WRAPPER
                ========================================== */

        .input-wrapper {
            position: relative;
            width: 100%;
        }


            /* =========================================
                   INPUT ICON
                ========================================== */

            .input-wrapper > i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #006838;
                font-size: 14px;
                pointer-events: none;
            }


        /* =========================================
                   INPUT
                ========================================== */

        .login-input {
            width: 100%;
            height: 49px;
            padding: 0 15px 0 43px;
            border: 1px solid #dce5df;
            border-radius: 9px;
            background: #f9fbfa;
            color: #26352d;
            font-family: inherit;
            font-size: 13px;
            outline: none;
            transition: all 0.2s ease;
        }


            /* =========================================
                   INPUT HOVER
                ========================================== */

            .login-input:hover {
                border-color: #b9c9bf;
            }


            /* =========================================
                   INPUT FOCUS
                ========================================== */

            .login-input:focus {
                background: #ffffff;
                border-color: #006838;
                box-shadow: 0 0 0 3px rgba(0, 104, 56, 0.10);
            }


            /* =========================================
                   PLACEHOLDER
                ========================================== */

            .login-input::placeholder {
                color: #a1ada6;
            }


        /* =========================================
                   LOGIN BUTTON
                ========================================== */

        .login-button {
            width: 100%;
            height: 49px;
            margin-top: 2px;
            border: none;
            border-radius: 9px;
            background: #006838;
            color: #ffffff;
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 7px 18px rgba(0, 104, 56, 0.18);
            transition: all 0.25s ease;
        }


            /* =========================================
                   LOGIN BUTTON HOVER
                ========================================== */

            .login-button:hover {
                background: #004d2b;
                transform: translateY(-1px);
                box-shadow: 0 10px 22px rgba(0, 104, 56, 0.24);
            }


            /* =========================================
                   LOGIN BUTTON ACTIVE
                ========================================== */

            .login-button:active {
                transform: translateY(0);
            }


        /* =========================================
                   VALIDATION SUMMARY
                ========================================== */

        .validation-summary {
            margin-top: 17px;
            padding: 11px 14px;
            border-radius: 8px;
            background: #fff5f4;
            border-left: 4px solid #c0392b;
            color: #8b3a32;
            font-size: 12px;
        }


            .validation-summary ul {
                margin: 0;
                padding-left: 18px;
            }


        /* =========================================
                   LOGIN FOOTER
                ========================================== */

        .login-footer {
            text-align: center;
            margin-top: 20px;
            padding-top: 13px;
            border-top: 1px solid #edf1ef;
            color: #9aa59f;
            font-size: 10px;
        }


            .login-footer i {
                color: #006838;
                margin-right: 5px;
            }


        /* =========================================
                   TABLET
                ========================================== */

        @@media (max-width: 700px) {

            body {
                padding: 20px 15px;
            }


            .login-page {
                max-width: 600px;
            }


            .login-brand {
                min-height: 285px;
                padding: 38px 20px 32px;
            }


            .login-form {
                padding: 35px 35px 32px;
            }
        }


        /* =========================================
                   MOBILE
                ========================================== */

        @@media (max-width: 480px) {

            body {
                padding: 15px 10px;
            }


            .login-page {
                border-radius: 18px;
            }


            .login-brand {
                min-height: 270px;
                padding: 32px 18px 28px;
            }


            .logo-box {
                width: 82px;
                height: 82px;
                border-radius: 14px;
            }


                .logo-box img {
                    width: 64px;
                    height: 64px;
                }


            .brand-title {
                font-size: 2rem;
                letter-spacing: 1px;
            }


            .brand-description {
                font-size: 13px;
            }


            .login-form {
                padding: 32px 22px 30px;
            }


            .login-header h2 {
                font-size: 24px;
            }


            .login-header p {
                font-size: 11px;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================
         MAIN CENTERED LOGIN PAGE
    ========================================== -->

    <div class="login-page">


        <!-- =====================================
             TOP GREEN PMDS SECTION
        ====================================== -->

        <section class="login-brand">

            <div class="brand-content">


                <!-- =================================
                     DCS LOGO
                ================================== -->

                <div class="logo-box">

                    <img src="~/images/dcslogo.png"
                         alt="Department of Correctional Services" />

                </div>


                <!-- =================================
                     PMDS TITLE
                ================================== -->

                <h1 class="brand-title">

                    <span>PMDS</span>

                </h1>


                <!-- =================================
                     DESCRIPTION
                ================================== -->

                <p class="brand-description">

                    Performance Management
                    &amp; Development System

                </p>


                <!-- =================================
                     GOLD LINE
                ================================== -->

                <div class="brand-line"></div>


                <!-- =================================
                     DEPARTMENT
                ================================== -->

                <p class="brand-small-text">

                    Department of Correctional Services

                </p>

            </div>

        </section>



        <!-- =====================================
             BOTTOM WHITE LOGIN SECTION
        ====================================== -->

        <section class="login-form">

            <div class="login-content">


                <!-- =================================
                     LOGIN HEADER
                ================================== -->

                <div class="login-header">


                    <div class="login-icon">

                        <i class="fa-solid fa-user"></i>

                    </div>


                    <h2>

                        Sign In

                    </h2>


                    <p>

                        Enter your details to access your account

                    </p>

                </div>



                <!-- =================================
                     LOGIN FORM
                ================================== -->

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- =============================
                         USERNAME / EMAIL
                    ============================== -->

                    <div class="form-group">

                        <label for="email">

                            Username or Email

                        </label>


                        <div class="input-wrapper">

                            <i class="fa-solid fa-user"></i>


                            <input type="text"
                                   id="email"
                                   name="email"
                                   class="login-input"
                                   placeholder="Enter username or email"
                                   autocomplete="username"
                                   required />

                        </div>

                    </div>



                    <!-- =============================
                         PASSWORD
                    ============================== -->

                    <div class="form-group">

                        <label for="password">

                            Password

                        </label>


                        <div class="input-wrapper">

                            <i class="fa-solid fa-lock"></i>


                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="login-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />

                        </div>

                    </div>



                    <!-- =============================
                         LOGIN BUTTON
                    ============================== -->

                    <button type="submit"
                            class="login-button">

                        <i class="fa-solid fa-right-to-bracket"></i>

                        Login

                    </button>

                </form>



                <!-- =================================
                     VALIDATION MESSAGE
                ================================== -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">

                        @Html.ValidationSummary()

                    </div>
                }



                <!-- =================================
                     FOOTER
                ================================== -->

                <div class="login-footer">

                    <i class="fa-regular fa-circle-check"></i>

                    PMDS · Department of Correctional Services

                </div>


            </div>

        </section>


    </div>


</body>

</html>