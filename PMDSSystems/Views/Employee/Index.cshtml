@model IEnumerable<PMDSSystems.Models.Employee>

<!DOCTYPE html>
<html>
<head>
    <style>
        /* Department of Correctional Services Styling */
        :root {
            --dcs-green: #006841;
            --dcs-gold: #c9a84c;
            --dcs-dark-green: #004d2f;
            --dcs-light-green: #008a55;
            --dcs-light-gray: #f5f5f5;
            --dcs-border: #dde1e6;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
            margin: 0;
            padding: 20px;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            background: white;
            padding: 35px 40px 45px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            border-top: 6px solid #006841;
            position: relative;
        }

            /* DCS Header */
            .container::before {
                content: "DEPARTMENT OF CORRECTIONAL SERVICES";
                display: block;
                text-align: center;
                font-size: 11px;
                letter-spacing: 2px;
                color: #006841;
                font-weight: 700;
                margin-bottom: 25px;
                padding-bottom: 15px;
                border-bottom: 2px solid #c9a84c;
                text-transform: uppercase;
            }

        /* Header Section */
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 15px;
        }

        h2 {
            color: #006841;
            font-size: 28px;
            font-weight: 600;
            margin: 0;
            letter-spacing: 0.5px;
        }

            h2::after {
                content: " — Staff Directory";
                font-size: 16px;
                font-weight: 300;
                color: #6b7a8f;
                letter-spacing: 1px;
            }

        /* Add Employee Button */
        .btn {
            display: inline-block;
            padding: 10px 25px;
            font-size: 14px;
            font-weight: 600;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, #006841 0%, #008a55 100%);
            color: white;
            border: 2px solid #006841;
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #008a55 0%, #006841 100%);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0, 104, 65, 0.3);
                color: white;
            }

        .btn-warning {
            background: linear-gradient(135deg, #c9a84c 0%, #b8973a 100%);
            color: white;
            border: 2px solid #c9a84c;
            padding: 6px 16px;
            font-size: 12px;
            letter-spacing: 0.5px;
        }

            .btn-warning:hover {
                background: linear-gradient(135deg, #d9b85c 0%, #c9a84c 100%);
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(201, 168, 76, 0.3);
                color: white;
            }

        .btn-sm {
            font-size: 11px;
            padding: 5px 14px;
        }

        /* Table Styling */
        .table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 14px;
        }

        .table-bordered {
            border: 2px solid #dde1e6;
        }

        .table thead {
            background: linear-gradient(135deg, #006841 0%, #008a55 100%);
            color: white;
        }

            .table thead th {
                padding: 14px 16px;
                text-align: left;
                font-weight: 600;
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border: 1px solid #006841;
            }

        .table tbody td {
            padding: 12px 16px;
            border: 1px solid #dde1e6;
            color: #006841;
        }

        .table tbody tr {
            transition: background-color 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: #f8f9fa;
            }

            .table tbody tr:nth-child(even) {
                background-color: #fafbfc;
            }

                .table tbody tr:nth-child(even):hover {
                    background-color: #f8f9fa;
                }

        /* Status Indicators */
        .table tbody td:last-child {
            text-align: center;
            min-width: 150px;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6b7a8f;
        }

            .empty-state p {
                font-size: 16px;
                margin-bottom: 20px;
            }

            .empty-state .icon {
                font-size: 48px;
                display: block;
                margin-bottom: 15px;
            }

        /* Decorative elements */
        .container::after {
            content: " DCS ";
            display: block;
            text-align: center;
            font-size: 10px;
            color: #c9a84c;
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #e8e8e8;
            letter-spacing: 3px;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .container

        {
            margin: 20px 10px;
            padding: 25px 20px 35px;
        }

        .header-section {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        h2 {
            font-size: 22px;
        }

            h2::after {
                font-size: 13px;
                display: block;
                margin-top: 5px;
            }

        .btn-primary {
            text-align: center;
        }

        .table {
            font-size: 13px;
        }

            .table thead th,
            .table tbody td {
                padding: 8px 10px;
            }

                .table tbody td:last-child {
                    min-width: 120px;
                }

        .btn-warning {
            padding: 4px 12px;
            font-size: 10px;
            display: inline-block;
            width: auto;
        }

        }

        @@media (max-width: 480px) {
            .container::before

        {
            font-size: 9px;
            letter-spacing: 1px;
        }

        .table {
            font-size: 11px;
        }

            .table thead th,
            .table tbody td {
                padding: 6px 8px;
            }

            .table thead th {
                font-size: 10px;
            }

        .btn-warning {
            padding: 3px 8px;
            font-size: 9px;
            letter-spacing: 0;
        }

        h2 {
            font-size: 18px;
        }

            h2::after {
                font-size: 11px;
            }

        }

        /* Print Styles */
        @@media print {
            body

        {
            background: white;
            padding: 0;
        }

        .container {
            box-shadow: none;
            border-top: 2px solid #006841;
            margin: 0;
        }

        .btn {
            display: none;
        }

        .table thead {
            background: #006841 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        }
        /* Supervisor Dropdown Styling */
        .supervisor-form {
            display: flex;
            align-items: center; /* vertical alignment */
            gap: 10px; /* space between dropdown & button */
        }

        /* Make dropdown take available space */
        .supervisor-select {
            flex: 1;
            min-width: 180px;
            height: 36px;
        }

        /* Align button height with dropdown */
        .btn-assign {
            height: 36px;
            white-space: nowrap;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 12px;
            font-size: 12px;
        }

        .supervisor-select {
            width: 180px;
            height: 36px;
            padding: 10px 12px;
            border-radius: 6px;
            border: 2px solid var(--dcs-border);
            font-size: 13px;
            color: var(--dcs-green);
            background-color: #fff;
            transition: all 0.3s ease;
            appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg fill='%23006841' height='20' viewBox='0 0 20 20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M5.516 7.548L10 12.032l4.484-4.484'/></svg>");
            background-repeat: no-repeat;
            background-position: right 10px center;
        }

            .supervisor-select:focus {
                outline: none;
                border-color: var(--dcs-green);
                box-shadow: 0 0 0 3px rgba(0, 104, 65, 0.15);
            }

            .supervisor-select:hover {
                border-color: var(--dcs-light-green);
            }
        /* Assign Button Upgrade */
        .btn-assign {
            background: linear-gradient(135deg, var(--dcs-gold), #b8973a);
            border: none;
            color: white;
            font-size: 12px;
            font-weight: 600;
            padding: 7px 14px;
            border-radius: 6px;
            transition: 0.3s ease;
        }

            .btn-assign:hover {
                background: linear-gradient(135deg, #d9b85c, var(--dcs-gold));
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(201, 168, 76, 0.3);
            }
    </style>
</head>
<body>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <script>
                alert("@TempData["Success"]");
            </script>
        }

        @if (TempData["Error"] != null)
        {
            <script>
                alert("@TempData["Error"]");
            </script>
        }
        <div class="header-section">
            <h2>Employees</h2>
            <!-- FIXED: Added asp-controller="Employee" -->
            <a href="@Url.Action("Create", "Employee")" class="btn btn-primary">
                ➕ Add Employee
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="table table-bordered mt-3">
                <thead>
                    <tr>
                        <th>Persal Number</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Assign Supervisor</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.PersalNumber</strong></td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.Department</td>

                            <!-- NEW COLUMN -->
                            <td>
                                <form action="/Employee/AssignSupervisor" method="post" class="supervisor-form">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@item.Id" />

                                    <select name="supervisorId" class="supervisor-select">
                                        <option value="">👤 Select Supervisor</option>

                                        @foreach (var sup in Model.Where(e => e.Id != item.Id))
                                        {
                                            <option value="@sup.Id">
                                                @sup.FirstName @sup.LastName
                                            </option>

                                        }

                                    </select>

                                    <button type="submit" class="btn-assign">
                                        ✔ Assign Supervisor
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <span class="icon">👥</span>
                <p><strong>No employees found</strong></p>
                <p style="font-size: 14px; color: #9aa9b9;">Click the "Add Employee" button to get started.</p>
            </div>
        }
    </div>

</body>
</html>