@model PMDSSystems.Models.Employee

<!DOCTYPE html>
<html>
<head>
    <style>
        /* Department of Correctional Services Styling */
        :root {
            --dcs-green: #006841;
            --dcs-gold: #c9a84c;
            --dcs-dark-green: #004d2f;
            --dcs-light-green: #008a55;
            --dcs-light-gray: #f5f5f5;
            --dcs-border: #dde1e6;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
            margin: 0;
            padding: 20px;
            min-height: 100vh;
        }

        .container {
            max-width: 600px;
            margin: 40px auto;
            background: white;
            padding: 35px 40px 45px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            border-top: 6px solid #006841;
            position: relative;
        }

            /* DCS Header */
            .container::before {
                content: "DEPARTMENT OF CORRECTIONAL SERVICES";
                display: block;
                text-align: center;
                font-size: 11px;
                letter-spacing: 2px;
                color: #006841;
                font-weight: 700;
                margin-bottom: 25px;
                padding-bottom: 15px;
                border-bottom: 2px solid #c9a84c;
                text-transform: uppercase;
            }

        h2 {
            color: #006841;
            font-size: 24px;
            font-weight: 600;
            text-align: center;
            margin-top: 0;
            margin-bottom: 30px;
            padding-bottom: 10px;
            border-bottom: 3px solid #c9a84c;
            letter-spacing: 0.5px;
        }

            h2::after {
                content: " — Supervisor Assignment";
                font-size: 14px;
                font-weight: 300;
                color: #6b7a8f;
                letter-spacing: 1px;
            }

        /* Employee Info Display */
        .employee-info {
            background: #f8f9fa;
            padding: 15px 20px;
            border-radius: 8px;
            border-left: 4px solid #c9a84c;
            margin-bottom: 25px;
        }

            .employee-info p {
                margin: 5px 0;
                color: #006841;
                font-size: 14px;
            }

            .employee-info strong {
                color: #006841;
                font-weight: 600;
            }

            .employee-info .label {
                color: #6b7a8f;
                font-weight: 300;
                text-transform: uppercase;
                font-size: 11px;
                letter-spacing: 0.5px;
            }

        label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            color: #006841;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            label::before {
                content: "▸ ";
                color: #c9a84c;
                font-size: 14px;
            }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            font-size: 15px;
            border: 2px solid #dde1e6;
            border-radius: 6px;
            background: #fafbfc;
            transition: all 0.3s ease;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #006841;
        }

            .form-control:focus {
                outline: none;
                border-color: #006841;
                background: white;
                box-shadow: 0 0 0 3px rgba(0, 104, 65, 0.1);
            }

            .form-control:hover {
                background: #f8f9fa;
            }

            .form-control option {
                padding: 8px;
            }

        .btn {
            display: inline-block;
            padding: 12px 35px;
            font-size: 15px;
            font-weight: 600;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 15px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #006841 0%, #008a55 100%);
            color: white;
            border: 2px solid #006841;
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #008a55 0%, #006841 100%);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0, 104, 65, 0.3);
            }

            .btn-primary:active {
                transform: translateY(0);
                box-shadow: 0 2px 10px rgba(0, 104, 65, 0.2);
            }

        /* Decorative elements */
        .container::after {
            content: " DCS ";
            display: block;
            text-align: center;
            font-size: 10px;
            color: #c9a84c;
            margin-top: 25px;
            padding-top: 15px;
            border-top: 1px solid #e8e8e8;
            letter-spacing: 3px;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .container

        {
            margin: 20px 10px;
            padding: 25px 20px 35px;
        }

        h2 {
            font-size: 20px;
        }

            h2::after {
                font-size: 11px;
                display: block;
                margin-top: 5px;
            }

        .btn {
            padding: 14px 20px;
            font-size: 14px;
        }

        .employee-info {
            padding: 12px 15px;
        }

        }

        @@media (max-width: 480px) {
            .container::before

        {
            font-size: 9px;
            letter-spacing: 1px;
        }

        label {
            font-size: 12px;
        }

        .form-control {
            font-size: 14px;
            padding: 8px 12px;
        }

        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Assign Supervisor</h2>

        <!-- Employee Information Display -->
        <div class="employee-info">
            <p><span class="label">Employee</span></p>
            <p><strong>@Model.FirstName @Model.LastName</strong></p>
            <p style="font-size: 13px; color: #6b7a8f; margin-top: 3px;">
                Persal: @Model.PersalNumber &nbsp;|&nbsp; @Model.Position
            </p>
        </div>

        <form method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <label>Select Supervisor</label>
            <select name="supervisorId" class="form-control">
                @foreach (var sup in ViewBag.Supervisors)
                {
                    <option value="@sup.Id">
                        @sup.FirstName @sup.LastName
                    </option>
                }
            </select>

            <br />

            <button class="btn btn-primary">Assign</button>
        </form>
    </div>

</body>
</html>