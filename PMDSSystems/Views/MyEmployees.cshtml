@model IEnumerable<PMDSSystems.Models.Employee>

@{
    ViewData["Title"] = "My Employees";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Employees</h2>
            <p class="text-muted">
                Employees assigned to you for performance management.
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <strong>No employees assigned.</strong>
            You currently have no employees assigned to you.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Persal Number</th>
                                <th>Employee Name</th>
                                <th>Position</th>
                                <th>Department</th>
                                <th>Post Level</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var employee in Model)
                            {
                                <tr>

                                    <td>
                                        @employee.PersalNumber
                                    </td>

                                    <td>
                                        <strong>
                                            @employee.FirstName
                                            @employee.LastName
                                        </strong>
                                    </td>

                                    <td>
                                        @employee.Position
                                    </td>

                                    <td>
                                        @employee.Department
                                    </td>

                                    <td>
                                        @employee.PostLevel
                                    </td>

                                    <td>

                                        <a asp-controller="Employee"
                                           asp-action="Details"
                                           asp-route-id="@employee.Id"
                                           class="btn btn-success btn-sm">
                                            View
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</div>