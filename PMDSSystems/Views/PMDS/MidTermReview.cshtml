    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        /* =========================================================
           C1 - ADD KRA
           ========================================================= */

        let c1KraIndex = 4;

        function addC1Kra() {

            const tbody = document.getElementById("c1KraBody");

            const rowNumber = c1KraIndex + 1;

            const row = document.createElement("tr");

            row.className = "c1-kra-row";
            row.setAttribute("data-kra", rowNumber);

            row.innerHTML = `
                <td>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="kra-number fw-bold text-success" style="min-width:18px;">${rowNumber}</span>
                        <input name="KraEvaluations[${c1KraIndex}].KraDescription"
                               class="form-control"
                               placeholder="Enter KRA Description..." />
                    </div>
                </td>

                <td>
                    <input name="KraEvaluations[${c1KraIndex}].Weight"
                           type="number"
                           class="form-control text-center weight-input kra-weight"
                           placeholder="Weight"
                           min="0"
                           max="100"
                           step="1"
                           inputmode="numeric" />
                </td>

                <td>
                    <textarea name="KraEvaluations[${c1KraIndex}].AchievementStandard"
                              class="form-control"
                              rows="3"
                              placeholder="Describe the standards achieved..."></textarea>
                </td>

                <td>
                    <textarea name="KraEvaluations[${c1KraIndex}].SupervisorComments"
                              class="form-control"
                              rows="3"
                              placeholder="Supervisor feedback..."></textarea>
                </td>

                <td class="text-center">
                    <button type="button"
                            class="btn-remove-kra"
                            onclick="removeC1Kra(${rowNumber})">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            c1KraIndex++;

            attachWeightCalculator();
            calculateTotalWeight();
            updateC1Numbers();
            updateC1Count();
            toggleC1RemoveButtons();
        }


        /* =========================================================
           C1 - REMOVE KRA
           ========================================================= */

        function removeC1Kra(number) {

            const rows = document.querySelectorAll("#c1KraBody tr.c1-kra-row");

            if (rows.length <= 1) {
                alert("At least 1 KRA is required.");
                return;
            }

            const row = document.querySelector(`#c1KraBody tr.c1-kra-row[data-kra="${number}"]`);

            if (row) row.remove();

            reindexC1Kras();
            attachWeightCalculator();
            calculateTotalWeight();
            updateC1Count();
            toggleC1RemoveButtons();
        }


        /* =========================================================
           C1 - UPDATE NUMBERS
           ========================================================= */

        function updateC1Numbers() {
            document.querySelectorAll("#c1KraBody tr.c1-kra-row").forEach((row, index) => {
                const numberCell = row.querySelector(".kra-number");
                if (numberCell) numberCell.innerText = index + 1;
            });
        }


        /* =========================================================
           C1 - COUNT BADGE
           ========================================================= */

        function updateC1Count() {
            const rows = document.querySelectorAll("#c1KraBody tr.c1-kra-row");
            const badge = document.getElementById("c1KraCount");
            if (badge) badge.innerText = rows.length + " KRAs";
        }


        /* =========================================================
           C1 - REINDEX
           ========================================================= */

        function reindexC1Kras() {

            const rows = document.querySelectorAll("#c1KraBody tr.c1-kra-row");

            rows.forEach((row, index) => {

                row.setAttribute("data-kra", index + 1);

                row.querySelectorAll("input, textarea, select").forEach(el => {
                    if (el.name) {
                        el.name = el.name.replace(
                            /KraEvaluations\[\d+\]/,
                            `KraEvaluations[${index}]`
                        );
                    }
                });

                const btn = row.querySelector(".btn-remove-kra");
                if (btn) btn.setAttribute("onclick", `removeC1Kra(${index + 1})`);
            });

            c1KraIndex = rows.length;
            updateC1Numbers();
        }


        /* =========================================================
           C1 - SHOW/HIDE REMOVE BUTTONS
           ========================================================= */

        function toggleC1RemoveButtons() {
            const rows = document.querySelectorAll("#c1KraBody tr.c1-kra-row");
            document.querySelectorAll("#c1KraBody .btn-remove-kra").forEach(btn => {
                btn.style.display = rows.length > 1 ? "inline-block" : "none";
            });
        }


        /* =========================================================
           C2 - ADD KRA
           ========================================================= */

        let c2KraIndex = 4;

        document.getElementById("addC2KraBtn").addEventListener("click", function () {

            const tbody = document.getElementById("c2KraBody");
            const totalRow = tbody.querySelector(".table-light");
            const rowNumber = c2KraIndex + 1;

            const row = document.createElement("tr");
            row.className = "c2-kra-row";
            row.setAttribute("data-kra", rowNumber);

            row.innerHTML = `
                <td class="kra-number">${rowNumber}</td>

                <td>
                    <div class="input-group input-group-sm mx-auto" style="max-width:100px;">
                        <select name="KraEvaluations[${c2KraIndex}].Weight"
                                class="form-select weight-input kra-weight"
                                required>
                            <option value="">—</option>
                            <option value="10">10%</option>
                            <option value="11">11%</option>
                            <option value="12">12%</option>
                            <option value="13">13%</option>
                            <option value="14">14%</option>
                            <option value="15">15%</option>
                            <option value="16">16%</option>
                            <option value="17">17%</option>
                            <option value="18">18%</option>
                            <option value="19">19%</option>
                            <option value="20">20%</option>
                            <option value="21">21%</option>
                            <option value="22">22%</option>
                            <option value="23">23%</option>
                            <option value="24">24%</option>
                            <option value="25">25%</option>
                            <option value="26">26%</option>
                            <option value="27">27%</option>
                            <option value="28">28%</option>
                            <option value="29">29%</option>
                            <option value="30">30%</option>
                        </select>
                        <span class="input-group-text">%</span>
                    </div>
                </td>

                <td>
                    <select name="KraEvaluations[${c2KraIndex}].OwnRating" class="form-control select-rating text-center">
                        <option value="">—</option>
                        <option value="1">1 – Not Effective</option>
                        <option value="2">2 – Partially Effective</option>
                        <option value="3">3 – Fully Effective</option>
                        <option value="4">4 – Highly Effective</option>
                    </select>
                </td>

                <td>
                    <select name="KraEvaluations[${c2KraIndex}].SupervisorRating" class="form-control select-rating text-center">
                        <option value="">—</option>
                        <option value="1">1 – Not Effective</option>
                        <option value="2">2 – Partially Effective</option>
                        <option value="3">3 – Fully Effective</option>
                        <option value="4">4 – Highly Effective</option>
                    </select>
                </td>

                <td>
                    <select name="KraEvaluations[${c2KraIndex}].AgreedRating"
                            class="form-control select-rating text-center"
                            style="border-color:#006838;background:#e8f5ee;">
                        <option value="">—</option>
                        <option value="1">1 – Not Effective</option>
                        <option value="2">2 – Partially Effective</option>
                        <option value="3">3 – Fully Effective</option>
                        <option value="4">4 – Highly Effective</option>
                    </select>
                </td>

                <td class="text-center">
                    <button type="button" class="btn-remove-kra remove-c2-kra">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            tbody.insertBefore(row, totalRow);

            c2KraIndex++;

            attachWeightCalculator();
            calculateTotalWeight();
            updateC2Count();
            toggleC2RemoveButtons();
        });


        /* =========================================================
           C2 - REMOVE KRA
           ========================================================= */

        document.getElementById("c2KraBody").addEventListener("click", function (e) {

            const button = e.target.closest(".remove-c2-kra");
            if (!button) return;

            const row = button.closest("tr");
            row.remove();

            reindexC2Kras();
            attachWeightCalculator();
            calculateTotalWeight();
            updateC2Count();
            toggleC2RemoveButtons();
        });


        /* =========================================================
           C2 - REINDEX
           ========================================================= */

        function reindexC2Kras() {

            const rows = document.querySelectorAll("#c2KraBody tr.c2-kra-row");

            rows.forEach((row, index) => {

                row.setAttribute("data-kra", index + 1);

                row.querySelectorAll("select, input").forEach(el => {
                    if (el.name) {
                        el.name = el.name.replace(
                            /KraEvaluations\[\d+\]/,
                            `KraEvaluations[${index}]`
                        );
                    }
                });
            });

            c2KraIndex = rows.length;
        }


        /* =========================================================
           C2 - COUNT BADGE
           ========================================================= */

        function updateC2Count() {
            const rows = document.querySelectorAll("#c2KraBody tr.c2-kra-row");
            const badge = document.getElementById("c2KraCount");
            if (badge) badge.innerText = rows.length + " KRAs";
        }


        /* =========================================================
           C2 - SHOW/HIDE REMOVE BUTTONS
           ========================================================= */

        function toggleC2RemoveButtons() {
            const rows = document.querySelectorAll("#c2KraBody tr.c2-kra-row");
            document.querySelectorAll("#c2KraBody .remove-c2-kra").forEach(btn => {
                btn.style.display = rows.length > 1 ? "inline-block" : "none";
            });
        }


        /* =========================================================
           WEIGHT CALCULATOR
           ========================================================= */

        function calculateTotalWeight() {

            let total = 0;

            document.querySelectorAll(".kra-weight").forEach(el => {
                const value = parseFloat(el.value) || 0;
                total += value;
            });

            const badge = document.getElementById("total-weight-badge");

            if (badge) {
                badge.innerText = total + "%";
                if (total === 100) {
                    badge.className = "badge bg-success fs-6";
                } else {
                    badge.className = "badge bg-danger fs-6";
                }
            }
        }


        /* =========================================================
           ATTACH WEIGHT LISTENERS
           ========================================================= */

        function attachWeightCalculator() {
            document.querySelectorAll(".kra-weight").forEach(el => {
                if (!el.dataset.listenerAttached) {
                    el.addEventListener("input", calculateTotalWeight);
                    el.addEventListener("change", calculateTotalWeight);
                    el.dataset.listenerAttached = "true";
                }
            });
        }


        /* =========================================================
           DISPUTE TOGGLE
           ========================================================= */

        document.querySelectorAll('input[name="HasDispute"]').forEach(elem => {
            elem.addEventListener("change", function (e) {
                const box = document.getElementById("disputeFields");
                box.style.display = e.target.value === "true" ? "block" : "none";
            });
        });


        /* =========================================================
           SIGNATURE PAD FACTORY
           ========================================================= */

        function createSignaturePad(canvasId, hiddenInputId, clearBtnId, label) {

            const canvas = document.getElementById(canvasId);
            const hiddenInput = document.getElementById(hiddenInputId);
            const clearButton = document.getElementById(clearBtnId);

            if (!canvas) {
                console.warn("Signature canvas not found:", canvasId);
                return null;
            }

            const ctx = canvas.getContext("2d");

            let drawing = false;
            let lastX = 0;
            let lastY = 0;

            function resizeCanvas() {
                const rect = canvas.getBoundingClientRect();
                if (rect.width === 0) return;

                const saved = hiddenInput && hiddenInput.value;

                canvas.width = rect.width;
                canvas.height = 250;

                ctx.strokeStyle = "#000000";
                ctx.fillStyle = "#000000";
                ctx.lineWidth = 2.5;
                ctx.lineCap = "round";
                ctx.lineJoin = "round";

                if (saved) {
                    const img = new Image();
                    img.onload = function () {
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    };
                    img.src = saved;
                }
            }

            function getPos(e) {
                const rect = canvas.getBoundingClientRect();
                if (e.touches && e.touches.length > 0) {
                    return { x: e.touches[0].clientX - rect.left, y: e.touches[0].clientY - rect.top };
                }
                return { x: e.clientX - rect.left, y: e.clientY - rect.top };
            }

            function start(e) {
                e.preventDefault();
                drawing = true;
                const p = getPos(e);
                lastX = p.x;
                lastY = p.y;
                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
            }

            function move(e) {
                if (!drawing) return;
                e.preventDefault();
                const p = getPos(e);
                ctx.lineTo(p.x, p.y);
                ctx.stroke();
                lastX = p.x;
                lastY = p.y;
                save();
            }

            function end(e) {
                if (!drawing) return;
                if (e) e.preventDefault();
                drawing = false;
                ctx.closePath();
                save();
            }

            function save() {
                if (hiddenInput) hiddenInput.value = canvas.toDataURL("image/png");
            }

            canvas.addEventListener("mousedown", start);
            canvas.addEventListener("mousemove", move);
            canvas.addEventListener("mouseup", end);
            canvas.addEventListener("mouseleave", end);

            canvas.addEventListener("touchstart", start, { passive: false });
            canvas.addEventListener("touchmove", move, { passive: false });
            canvas.addEventListener("touchend", end, { passive: false });
            canvas.addEventListener("touchcancel", end, { passive: false });

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    if (hiddenInput) hiddenInput.value = "";
                });
            }

            resizeCanvas();
            window.addEventListener("resize", resizeCanvas);

            return {
                canvas,
                clear: function () {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    if (hiddenInput) hiddenInput.value = "";
                }
            };
        }


        /* =========================================================
           INITIALIZE
           ========================================================= */

        document.addEventListener("DOMContentLoaded", function () {

            createSignaturePad("superviseeSignaturePad", "SuperviseeSignature", "clearSuperviseeSignature", "Supervisee");
            createSignaturePad("supervisorSignaturePad", "SupervisorSignature", "clearSupervisorSignature", "Supervisor");
            createSignaturePad("higherManagerSignaturePad", "HigherManagerSignature", "clearHigherManagerSignature", "Higher Manager");

            attachWeightCalculator();
            calculateTotalWeight();

            updateC1Numbers();
            updateC1Count();
            updateC2Count();
            toggleC1RemoveButtons();
            toggleC2RemoveButtons();

            const disputeNo = document.getElementById("disputeNo");
            if (disputeNo) disputeNo.checked = true;
        });

    </script>
</body>
</html>