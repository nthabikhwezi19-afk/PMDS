@model PMDSSystems.Models.MidTermReview

@{
    ViewData["Title"] = "Mid-Term Review";

    var kraEvaluations = Model.KraEvaluations?.ToList()
                         ?? new List<PMDSSystems.Models.MidTermKraEvaluation>();
}

<style>
    /* ============================================================
           GLOBAL
           ============================================================ */

    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .pmds-container {
        max-width: 1500px;
        margin: 30px auto;
        padding: 0 20px 50px;
    }

    .page-header {
        background: linear-gradient(135deg, #006838, #004d28);
        color: white;
        padding: 22px 28px;
        border-radius: 12px;
        margin-bottom: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.12);
    }

        .page-header h2 {
            margin: 0;
            font-weight: 700;
        }

        .page-header p {
            margin: 5px 0 0;
            opacity: 0.9;
        }

    .section-card {
        background: white;
        border-radius: 12px;
        margin-bottom: 25px;
        padding: 25px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        border: 1px solid #e1e5e9;
    }

    .section-title {
        background: #006838;
        color: white;
        padding: 12px 18px;
        border-radius: 8px;
        margin: -25px -25px 25px;
        font-weight: 700;
    }

    .sub-title {
        color: #006838;
        font-weight: 700;
        margin-top: 20px;
        margin-bottom: 15px;
    }

    label {
        font-weight: 600;
        color: #333;
    }

    .form-control,
    .form-select {
        border-radius: 7px;
        border: 1px solid #ced4da;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #006838;
            box-shadow: 0 0 0 0.15rem rgba(0,104,56,0.15);
        }

    /* ============================================================
           TABLE
           ============================================================ */

    .table-responsive {
        overflow-x: auto;
    }

    .kra-table {
        width: 100%;
        min-width: 1250px;
        border-collapse: collapse;
    }

        .kra-table th {
            background: #004d28;
            color: white;
            text-align: center;
            vertical-align: middle;
            padding: 12px;
            border: 1px solid #ddd;
        }

        .kra-table td {
            padding: 10px;
            vertical-align: top;
            border: 1px solid #ddd;
            background: white;
        }

        .kra-table textarea {
            min-height: 100px;
            resize: vertical;
        }

    /* ============================================================
           LOCKED EMPLOYEE FIELDS
           ============================================================ */

    .employee-locked {
        background-color: #f1f3f5 !important;
        color: #6c757d !important;
        border: 1px solid #ced4da !important;
        cursor: not-allowed !important;
    }

        .employee-locked:focus {
            box-shadow: none !important;
            border-color: #ced4da !important;
        }

    .locked-field-wrapper {
        position: relative;
    }

        .locked-field-wrapper::after {
            content: "🔒";
            position: absolute;
            top: 8px;
            right: 10px;
            font-size: 13px;
            opacity: 0.7;
            pointer-events: none;
        }

    select.employee-locked {
        pointer-events: none;
    }

    /* ============================================================
           SUPERVISOR LOCKED
           ============================================================ */

    .supervisor-locked {
        background-color: #f1f3f5 !important;
        color: #6c757d !important;
        cursor: not-allowed !important;
    }

        .supervisor-locked:focus {
            box-shadow: none !important;
        }

    .supervisor-signature-locked {
        position: relative;
        background: #f8f9fa;
        border: 1px solid #ced4da;
        border-radius: 8px;
        padding: 10px;
    }

    .signature-lock-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(248,249,250,0.55);
        color: #6c757d;
        font-weight: 600;
        border-radius: 8px;
        z-index: 10;
        pointer-events: none;
    }

    /* ============================================================
           HIGHER MANAGER LOCKED
           ============================================================ */

    .higher-manager-locked {
        background-color: #f1f3f5 !important;
        color: #6c757d !important;
        border-color: #ced4da !important;
        cursor: not-allowed !important;
    }

        .higher-manager-locked:focus {
            box-shadow: none !important;
        }

    .locked-signature-wrapper {
        position: relative;
        background: #f8f9fa;
        border: 1px solid #ced4da;
        border-radius: 8px;
        padding: 10px;
    }

    .locked-signature-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(248,249,250,0.60);
        color: #6c757d;
        font-weight: 600;
        border-radius: 8px;
        z-index: 20;
        pointer-events: none;
    }

    /* ============================================================
           SIGNATURE PAD
           ============================================================ */

    .signature-container {
        max-width: 500px;
    }

    .signature-pad {
        width: 100%;
        height: 180px;
        border: 2px dashed #006838;
        border-radius: 8px;
        background: white;
        touch-action: none;
        display: block;
    }

    .signature-label {
        font-weight: 700;
        color: #006838;
        margin-bottom: 8px;
    }

    /* ============================================================
           BUTTONS
           ============================================================ */

    .btn-pmds {
        background: #006838;
        border-color: #006838;
        color: white;
        font-weight: 600;
    }

        .btn-pmds:hover {
            background: #004d28;
            border-color: #004d28;
            color: white;
        }

    .btn-gold {
        background: #c9a84c;
        border-color: #c9a84c;
        color: #fff;
        font-weight: 600;
    }

        .btn-gold:hover {
            background: #b3933e;
            border-color: #b3933e;
            color: white;
        }

    .btn-danger {
        font-weight: 600;
    }

    /* ============================================================
           DISPUTE
           ============================================================ */

    #disputeFields {
        display: none;
    }

    .dispute-box {
        border: 1px solid #e2c44f;
        background: #fffdf0;
        border-radius: 10px;
        padding: 20px;
        margin-top: 15px;
    }

    /* ============================================================
           INFO BOX
           ============================================================ */

    .info-box {
        background: #f4f8f6;
        border-left: 5px solid #006838;
        padding: 15px 18px;
        border-radius: 7px;
        margin-bottom: 20px;
    }

    .lock-info {
        background: #f8f9fa;
        border-left: 4px solid #6c757d;
        padding: 10px 14px;
        border-radius: 6px;
        font-size: 14px;
        color: #666;
        margin-bottom: 15px;
    }

    /* ============================================================
           MOBILE
           ============================================================ */

    @@media (max-width: 768px) {
        .pmds-container

    {
        padding: 0 10px 30px;
    }

    .section-card {
        padding: 15px;
    }

    .section-title {
        margin: -15px -15px 20px;
    }

    .page-header {
        padding: 18px;
    }

    }
</style>


<div class="pmds-container">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">
        <h2>
            <i class="fas fa-clipboard-check me-2"></i>
            Mid-Term Review
        </h2>

        <p>
            Performance Management and Development System
        </p>
    </div>


    <form asp-controller="Pmds"
          asp-action="SaveMidTermReview"
          method="post"
          id="midTermReviewForm">

        @Html.AntiForgeryToken()

        <!-- =====================================================
             HIDDEN INFORMATION
             ===================================================== -->

        <input type="hidden"
               asp-for="Id" />

        <input type="hidden"
               asp-for="EmployeeId" />

        <input type="hidden"
               asp-for="ReviewPeriod" />


        <!-- =====================================================
             PART C1
             ===================================================== -->

        <div class="section-card">

            <div class="section-title">
                PART C1 : MID-TERM REVIEW
            </div>

            <div class="info-box">
                <strong>
                    <i class="fas fa-info-circle me-1"></i>
                    Employee Section
                </strong>

                <p class="mb-0 mt-1">
                    Enter your achievements against each Key Result Area.
                    Supervisor comments are completed by the supervisor
                    and cannot be edited by the employee.
                </p>
            </div>


            <div class="table-responsive">

                <table class="table kra-table"
                       id="c1KraTable">

                    <thead>

                        <tr>

                            <th style="width:5%;">
                                #
                            </th>

                            <th style="width:20%;">
                                Key Result Area
                            </th>

                            <th style="width:8%;">
                                Weight
                            </th>

                            <th style="width:32%;">
                                Employee Achievements
                            </th>

                            <th style="width:30%;">
                                Supervisor Comment(s)
                            </th>

                            <th style="width:5%;">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody id="c1KraBody">

                        @for (int i = 0; i < kraEvaluations.Count; i++)
                        {
                            <tr class="kra-row">

                                <td class="text-center kra-number">
                                    @(i + 1)
                                </td>


                                <!-- KRA -->

                                <td>

                                    <input type="text"
                                           class="form-control"
                                           name="KraEvaluations[@i].KraDescription"
                                           value="@kraEvaluations[i].KraDescription"
                                           readonly />

                                </td>


                                <!-- WEIGHT -->

                                <td>

                                    <input type="text"
                                           class="form-control text-center"
                                           name="KraEvaluations[@i].Weight"
                                           value="@kraEvaluations[i].Weight"
                                           readonly />

                                </td>


                                <!-- EMPLOYEE ACHIEVEMENT -->

                                <td>

                                    <textarea name="KraEvaluations[@i].AchievementStandard"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Enter your achievements...">@kraEvaluations[i].AchievementStandard</textarea>

                                </td>


                                <!-- SUPERVISOR COMMENTS LOCKED -->

                                <td>

                                    <div class="locked-field-wrapper">

                                        <textarea name="KraEvaluations[@i].SupervisorComments"
                                              class="form-control employee-locked"
                                              rows="4"
                                              placeholder="Supervisor feedback..."
                                              readonly>@kraEvaluations[i].SupervisorComments</textarea>

                                    </div>

                                </td>


                                <!-- REMOVE -->

                                <td class="text-center">

                                    @if (i > 0)
                                    {
                                        <button type="button"
                                                class="btn btn-danger btn-sm remove-c1">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="mt-3">

                <button type="button"
                        class="btn btn-gold"
                        id="addC1KraButton">

                    <i class="fas fa-plus me-1"></i>
                    Add KRA

                </button>

            </div>

        </div>


        <!-- =====================================================
             PART C2
             ===================================================== -->

        <div class="section-card">

            <div class="section-title">
                PART C2 : MID-TERM ASSESSMENT
            </div>

            <div class="info-box">

                <strong>
                    <i class="fas fa-star me-1"></i>
                    Rating Section
                </strong>

                <p class="mb-0 mt-1">
                    Select your own rating for each KRA.
                    The Supervisor Rating is completed by the supervisor
                    and is locked for the employee.
                </p>

            </div>


            <div class="table-responsive">

                <table class="table kra-table"
                       id="c2KraTable">

                    <thead>

                        <tr>

                            <th style="width:5%;">
                                #
                            </th>

                            <th style="width:25%;">
                                Key Result Area
                            </th>

                            <th style="width:10%;">
                                Weight
                            </th>

                            <th style="width:18%;">
                                Own Rating
                            </th>

                            <th style="width:18%;">
                                Supervisor Rating
                            </th>

                            <th style="width:18%;">
                                Agreed Rating
                            </th>

                            <th style="width:6%;">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody id="c2KraBody">

                        @for (int i = 0; i < kraEvaluations.Count; i++)
                        {
                            <tr class="kra-row">

                                <td class="text-center kra-number">
                                    @(i + 1)
                                </td>


                                <!-- KRA -->

                                <td>

                                    <input type="text"
                                           class="form-control"
                                           name="KraEvaluations[@i].KraDescription"
                                           value="@kraEvaluations[i].KraDescription"
                                           readonly />

                                    <input type="hidden"
                                           name="KraEvaluations[@i].Id"
                                           value="@kraEvaluations[i].Id" />

                                </td>


                                <!-- WEIGHT -->

                                <td>

                                    <input type="text"
                                           class="form-control text-center"
                                           name="KraEvaluations[@i].Weight"
                                           value="@kraEvaluations[i].Weight"
                                           readonly />

                                </td>


                                <!-- OWN RATING -->

                                <td>

                                    <select name="KraEvaluations[@i].OwnRating"
                                            class="form-select">

                                        <option value="">
                                            Select Rating
                                        </option>

                                        <option value="1"
                                                selected="@(kraEvaluations[i].OwnRating == 1)">
                                            1 - Does Not Meet
                                        </option>

                                        <option value="2"
                                                selected="@(kraEvaluations[i].OwnRating == 2)">
                                            2 - Partially Meets
                                        </option>

                                        <option value="3"
                                                selected="@(kraEvaluations[i].OwnRating == 3)">
                                            3 - Meets
                                        </option>

                                        <option value="4"
                                                selected="@(kraEvaluations[i].OwnRating == 4)">
                                            4 - Exceeds
                                        </option>

                                        <option value="5"
                                                selected="@(kraEvaluations[i].OwnRating == 5)">
                                            5 - Outstanding
                                        </option>

                                    </select>

                                </td>


                                <!-- SUPERVISOR RATING LOCKED -->

                                <td>

                                    <div class="locked-field-wrapper">

                                        <select name="KraEvaluations[@i].SupervisorRating"
                                                class="form-select employee-locked supervisor-rating"
                                                tabindex="-1"
                                                aria-disabled="true"
                                                style="pointer-events:none;">

                                            <option value="">
                                                Awaiting Supervisor
                                            </option>

                                            <option value="1"
                                                    selected="@(kraEvaluations[i].SupervisorRating == 1)">
                                                1 - Does Not Meet
                                            </option>

                                            <option value="2"
                                                    selected="@(kraEvaluations[i].SupervisorRating == 2)">
                                                2 - Partially Meets
                                            </option>

                                            <option value="3"
                                                    selected="@(kraEvaluations[i].SupervisorRating == 3)">
                                                3 - Meets
                                            </option>

                                            <option value="4"
                                                    selected="@(kraEvaluations[i].SupervisorRating == 4)">
                                                4 - Exceeds
                                            </option>

                                            <option value="5"
                                                    selected="@(kraEvaluations[i].SupervisorRating == 5)">
                                                5 - Outstanding
                                            </option>

                                        </select>

                                    </div>

                                </td>


                                <!-- AGREED RATING -->

                                <td>

                                    <select name="KraEvaluations[@i].AgreedRating"
                                            class="form-select">

                                        <option value="">
                                            Select Rating
                                        </option>

                                        <option value="1"
                                                selected="@(kraEvaluations[i].AgreedRating == 1)">
                                            1 - Does Not Meet
                                        </option>

                                        <option value="2"
                                                selected="@(kraEvaluations[i].AgreedRating == 2)">
                                            2 - Partially Meets
                                        </option>

                                        <option value="3"
                                                selected="@(kraEvaluations[i].AgreedRating == 3)">
                                            3 - Meets
                                        </option>

                                        <option value="4"
                                                selected="@(kraEvaluations[i].AgreedRating == 4)">
                                            4 - Exceeds
                                        </option>

                                        <option value="5"
                                                selected="@(kraEvaluations[i].AgreedRating == 5)">
                                            5 - Outstanding
                                        </option>

                                    </select>

                                </td>


                                <!-- REMOVE -->

                                <td class="text-center">

                                    @if (i > 0)
                                    {
                                        <button type="button"
                                                class="btn btn-danger btn-sm remove-c2">

                                            <i class="fas fa-trash"></i>

                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="mt-3">

                <button type="button"
                        class="btn btn-gold"
                        id="addC2KraButton">

                    <i class="fas fa-plus me-1"></i>
                    Add KRA

                </button>

            </div>

        </div>


        <!-- =====================================================
             DISPUTE PROTOCOL
             ===================================================== -->

        <div class="section-card">

            <div class="section-title">
                DISPUTE PROTOCOL
            </div>


            <div class="info-box">

                <strong>
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    Dispute Information
                </strong>

                <p class="mb-0 mt-1">
                    If there is a disagreement during the review process,
                    indicate the disputed KRA below. Resolution by the
                    Next Higher Line Manager is not editable by the employee.
                </p>

            </div>


            <!-- HAS DISPUTE -->

            <div class="row mb-3">

                <div class="col-md-6">

                    <label class="form-label">
                        Is there a dispute?
                    </label>

                    <div>

                        <div class="form-check form-check-inline">

                            <input class="form-check-input"
                                   type="radio"
                                   name="HasDispute"
                                   id="hasDisputeYes"
                                   value="true"
                                   @(Model.HasDispute ? "checked" : "") />

                            <label class="form-check-label"
                                   for="hasDisputeYes">

                                Yes

                            </label>

                        </div>


                        <div class="form-check form-check-inline">

                            <input class="form-check-input"
                                   type="radio"
                                   name="HasDispute"
                                   id="hasDisputeNo"
                                   value="false"
                                   @(!Model.HasDispute ? "checked" : "") />

                            <label class="form-check-label"
                                   for="hasDisputeNo">

                                No

                            </label>

                        </div>

                    </div>

                </div>

            </div>


            <div id="disputeFields"
                 class="dispute-box">

                <!-- DISPUTED KRA -->

                <div class="mb-4">

                    <label class="form-label">
                        Disputed KRA Number(s)
                    </label>

                    <input type="text"
                           name="DisputedKraNumbers"
                           class="form-control"
                           value="@Model.DisputedKraNumbers"
                           placeholder="Example: KRA 2, KRA 4" />

                </div>


                <!-- HIGHER MANAGER DECISION LOCKED -->

                <div class="mb-4">

                    <label class="form-label">
                        Decision of Next Higher Line Manager
                    </label>

                    <div class="locked-field-wrapper">

                        <textarea name="HigherManagerDecision"
                                  class="form-control higher-manager-locked"
                                  rows="4"
                                  placeholder="To be completed by Next Higher Line Manager..."
                                  readonly>@Model.HigherManagerDecision</textarea>

                    </div>

                </div>


                <!-- SURNAME INITIALS LOCKED -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Next Higher Line Manager Surname &amp; Initials
                        </label>

                        <div class="locked-field-wrapper">

                            <input type="text"
                                   name="HigherManagerSurnameInitials"
                                   class="form-control higher-manager-locked"
                                   value="@Model.HigherManagerSurnameInitials"
                                   placeholder="To be completed by Next Higher Line Manager"
                                   readonly />

                        </div>

                    </div>


                    <!-- DATE LOCKED -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Date
                        </label>

                        <div class="locked-field-wrapper">

                            <input type="date"
                                   name="HigherManagerSignDate"
                                   class="form-control higher-manager-locked"
                                   value="@(Model.HigherManagerSignDate.HasValue? Model.HigherManagerSignDate.Value.ToString("yyyy-MM-dd") : "")"
                                   readonly />

                        </div>

                    </div>

                </div>


                <!-- HIGHER MANAGER SIGNATURE -->

                <div class="mt-3">

                    <label class="signature-label">
                        Next Higher Line Manager Signature
                    </label>


                    <div class="locked-signature-wrapper">

                        <canvas id="higherManagerSignaturePad"
                                class="signature-pad"></canvas>


                        <div class="locked-signature-overlay">

                            <span>
                                <i class="fas fa-lock me-1"></i>
                                Signature completed by Next Higher Line Manager
                            </span>

                        </div>


                        <input type="hidden"
                               id="HigherManagerSignature"
                               name="HigherManagerSignature"
                               value="@Model.HigherManagerSignature" />

                    </div>


                    <button type="button"
                            id="clearHigherManagerSignature"
                            class="btn btn-secondary btn-sm mt-2"
                            disabled>

                        <i class="fas fa-eraser me-1"></i>
                        Clear Signature

                    </button>

                </div>

            </div>

        </div>


        <!-- =====================================================
        SIGNATURES
        ===================================================== -->

        <div class="section-card">

            <div class="section-title">
                SIGNATURES
            </div>

            <div class="row">

                <!-- =================================================
                     EMPLOYEE / SUPERVISEE SIGNATURE
                     ================================================= -->

                <div class="col-md-6 mb-4">

                    <div class="signature-container">

                        <div class="signature-label">

                            <i class="fas fa-user me-1"></i>

                            Job Holder / Supervisee Signature

                        </div>

                        <canvas id="superviseeSignaturePad"
                                class="signature-pad"></canvas>

                        <!-- IMPORTANT:
                             Your model property is SuperviseeSignature
                             -->

                        <input type="hidden"
                               id="SuperviseeSignature"
                               name="SuperviseeSignature"
                               value="@Model.SuperviseeSignature" />

                        <button type="button"
                                id="clearSuperviseeSignature"
                                class="btn btn-danger btn-sm mt-2">

                            <i class="fas fa-eraser me-1"></i>

                            Clear Signature

                        </button>

                        <div class="mt-3">

                            <label class="form-label">
                                Supervisee Sign Date
                            </label>

                            <input type="date"
                                   name="SuperviseeSignDate"
                                   class="form-control"
                                   value="@(Model.SuperviseeSignDate.HasValue
                                                                       ? Model.SuperviseeSignDate.Value.ToString("yyyy-MM-dd")
                                                                       : "")" />

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SUPERVISOR SIGNATURE - LOCKED
                     ================================================= -->

                <div class="col-md-6 mb-4">

                    <div class="signature-container">

                        <div class="signature-label">

                            <i class="fas fa-user-tie me-1"></i>

                            Supervisor Signature

                        </div>

                        <div class="supervisor-signature-locked">

                            <canvas id="supervisorSignaturePad"
                                    class="signature-pad"></canvas>

                            <div class="signature-lock-overlay">

                                <span>

                                    <i class="fas fa-lock me-1"></i>

                                    Supervisor only

                                </span>

                            </div>

                            <input type="hidden"
                                   id="SupervisorSignature"
                                   name="SupervisorSignature"
                                   value="@Model.SupervisorSignature" />

                        </div>

                        <button type="button"
                                id="clearSupervisorSignature"
                                class="btn btn-secondary btn-sm mt-2"
                                disabled>

                            <i class="fas fa-eraser me-1"></i>

                            Clear Signature

                        </button>

                        <div class="mt-3">

                            <label class="form-label">
                                Supervisor Sign Date
                            </label>

                            <input type="date"
                                   name="SupervisorSignDate"
                                   class="form-control supervisor-locked"
                                   value="@(Model.SupervisorSignDate.HasValue
                                                                       ? Model.SupervisorSignDate.Value.ToString("yyyy-MM-dd")
                                                                       : "")"
                                   readonly />

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SAVE BUTTONS
             ===================================================== -->

