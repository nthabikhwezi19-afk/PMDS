            rows.forEach(function (row, index) {

                const number =
                    row.querySelector(".kra-number");

                if (number) {
                    number.textContent = index + 1;
                }


                row.querySelectorAll(
                    "input, textarea, select"
                ).forEach(function (input) {

                    if (input.name) {

                        input.name =
