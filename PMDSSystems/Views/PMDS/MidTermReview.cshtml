            }


            if (surname) {

                surname.readOnly = true;
                surname.classList.add(
                    "higher-manager-locked"
                );

            }


            if (date) {

                date.readOnly = true;
                date.classList.add(
                    "higher-manager-locked"
                );

            }


            if (canvas) {

                canvas.style.pointerEvents = "none";
                canvas.style.cursor = "not-allowed";

            }


            if (clearButton) {

                clearButton.disabled = true;

            }

        }


