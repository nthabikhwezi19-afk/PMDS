    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        /* =========================================================
           C1 - ADD KRA
           ========================================================= */

        let c1KraIndex = 3;

        document.getElementById("addC1KraBtn").addEventListener("click", function () {

            const tbody = document.getElementById("c1KraBody");

            const rowNumber = c1KraIndex + 1;

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="ps-3 fw-bold text-success kra-number">
                    ${rowNumber}
                </td>

                <td>
                    <input name="KraEvaluations[${c1KraIndex}].KraDescription"
                           class="form-control border-0 bg-transparent fw-semibold"
                           placeholder="Enter KRA Description..." />
                </td>

                <td>
                    <div class="input-group input-group-sm mx-auto"
                         style="max-width:90px;">

                        <input name="KraEvaluations[${c1KraIndex}].Weight"
                               type="number"
                               class="form-control text-center kra-weight"
                               placeholder="0" />

                        <span class="input-group-text">%</span>

                    </div>
                </td>

                <td>
                    <textarea name="KraEvaluations[${c1KraIndex}].AchievementStandard"
                              class="form-control form-control-sm"
                              rows="3"
                              placeholder="Describe the standards achieved..."></textarea>
                </td>

                <td>
                    <textarea name="KraEvaluations[${c1KraIndex}].SupervisorComments"
                              class="form-control form-control-sm"
                              rows="3"
                              placeholder="Supervisor feedback..."></textarea>
                </td>

                <td class="text-center">
                    <button type="button"
                            class="btn btn-outline-danger btn-sm remove-kra">

                        <i class="bi bi-trash"></i>

                    </button>
                </td>
            `;

            tbody.appendChild(row);

            c1KraIndex++;

            updateC1Numbers();

        });


        /* =========================================================
           C1 - REMOVE KRA
           ========================================================= */

        document.getElementById("c1KraBody").addEventListener("click", function (e) {

            const button = e.target.closest(".remove-kra");

            if (!button) {
                return;
            }

            const row = button.closest("tr");

            row.remove();

            reindexC1Kras();

        });


        /* =========================================================
           C1 - UPDATE NUMBERS
           ========================================================= */

        function updateC1Numbers() {

            const rows = document.querySelectorAll("#c1KraBody tr");

            rows.forEach((row, index) => {

                const numberCell = row.querySelector(".kra-number");

                if (numberCell) {
                    numberCell.innerText = index + 1;
                }

            });

        }


        /* =========================================================
           C1 - REINDEX
           ========================================================= */

        function reindexC1Kras() {

            const rows = document.querySelectorAll("#c1KraBody tr");

            rows.forEach((row, index) => {

                row.querySelectorAll("input, textarea").forEach(input => {

                    if (input.name) {

                        input.name = input.name.replace(
                            /KraEvaluations\[\d+\]/,
                            `KraEvaluations[${index}]`
                        );

                    }

                });

            });

            c1KraIndex = rows.length;

            updateC1Numbers();

        }


        /* =========================================================
           C2 - ADD KRA
           ========================================================= */

        let c2KraIndex = 3;

        document.getElementById("addC2KraBtn").addEventListener("click", function () {

            const tbody = document.getElementById("c2KraBody");

            const totalRow = tbody.querySelector(".table-light");

            const rowNumber = c2KraIndex + 1;

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="text-start ps-3 fw-semibold">

                    <input name="KraEvaluations[${c2KraIndex}].KraDescription"
                           class="form-control border-0 bg-transparent fw-semibold"
                           placeholder="Enter KRA ${rowNumber} Description..." />

                </td>

                <td>

                    <div class="input-group input-group-sm mx-auto"
                         style="max-width:90px;">

                        <input name="KraEvaluations[${c2KraIndex}].Weight"
                               type="number"
                               class="form-control text-center kra-weight"
                               placeholder="0" />

                        <span class="input-group-text">%</span>

                    </div>

                </td>

                <td>

                    <input name="KraEvaluations[${c2KraIndex}].OwnRating"
                           type="number"
                           class="form-control form-control-sm rating-input mx-auto"
                           placeholder="1-4"
                           min="1"
                           max="4" />

                </td>

                <td>

                    <input name="KraEvaluations[${c2KraIndex}].SupervisorRating"
                           type="number"
                           class="form-control form-control-sm rating-input mx-auto"
                           placeholder="1-4"
                           min="1"
                           max="4" />

                </td>

                <td>

                    <input name="KraEvaluations[${c2KraIndex}].AgreedRating"
                           type="number"
                           class="form-control form-control-sm rating-input mx-auto border-primary bg-primary-subtle"
                           placeholder="1-4"
                           min="1"
                           max="4" />

                </td>

                <td>

                    <button type="button"
                            class="btn btn-outline-danger btn-sm remove-c2-kra">

                        <i class="bi bi-trash"></i>

                    </button>

                </td>
            `;

            tbody.insertBefore(row, totalRow);

            c2KraIndex++;

            attachWeightCalculator();

            calculateTotalWeight();

        });


        /* =========================================================
           C2 - REMOVE KRA
           ========================================================= */

        document.getElementById("c2KraBody").addEventListener("click", function (e) {

            const button = e.target.closest(".remove-c2-kra");

            if (!button) {
                return;
            }

            const row = button.closest("tr");

            row.remove();

            reindexC2Kras();

            calculateTotalWeight();

        });


        /* =========================================================
           C2 - REINDEX
           ========================================================= */

        function reindexC2Kras() {

            const rows = document.querySelectorAll(
                "#c2KraBody tr:not(.table-light)"
            );

            rows.forEach((row, index) => {

                row.querySelectorAll("input").forEach(input => {

                    if (input.name) {

                        input.name = input.name.replace(
                            /KraEvaluations\[\d+\]/,
                            `KraEvaluations[${index}]`
                        );

                    }

                });

            });

            c2KraIndex = rows.length;

        }


        /* =========================================================
           WEIGHT CALCULATOR
           ========================================================= */

        function calculateTotalWeight() {

            let total = 0;

            document.querySelectorAll(".kra-weight").forEach(input => {

                const value = parseFloat(input.value) || 0;

                total += value;

            });

            const badge = document.getElementById("total-weight-badge");

            if (badge) {

                badge.innerText = total + "%";

                if (total === 100) {

                    badge.className = "badge bg-success fs-6";

                } else {

                    badge.className = "badge bg-danger fs-6";

                }

            }

        }


        /* =========================================================
           ATTACH WEIGHT CALCULATOR
           ========================================================= */

        function attachWeightCalculator() {

            document.querySelectorAll(".kra-weight").forEach(input => {

                if (!input.dataset.listenerAttached) {

                    input.addEventListener("input", calculateTotalWeight);

                    input.dataset.listenerAttached = "true";

                }

            });

        }


        /* =========================================================
           DISPUTE TOGGLE
           ========================================================= */

        document.querySelectorAll('input[name="HasDispute"]').forEach(elem => {

            elem.addEventListener("change", function (e) {

                const box = document.getElementById("disputeFields");

                box.style.display =
                    e.target.value === "true"
                        ? "block"
                        : "none";

            });

        });


        /* =========================================================
           INITIALIZE
           ========================================================= */

        document.addEventListener("DOMContentLoaded", function () {

            attachWeightCalculator();

            calculateTotalWeight();

            const disputeNo = document.getElementById("disputeNo");

            if (disputeNo) {
                disputeNo.checked = true;
            }

        });

    </script>
