</style>
<!-- =========================================================
     FULL PAGE
     ========================================================= -->

<div class="pap-page">

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"
               style="font-size:18px;"></i>

            <div>
                @TempData["SuccessMessage"]
            </div>

            <button type="button"
                    class="btn-close ms-auto"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <form asp-controller="Pmds"
          asp-action="SavePersonalAssistancePlan"
          method="post">

        <input type="hidden" asp-for="Id" />


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="pap-header">

            <span class="badge px-3 py-2 position-absolute top-0 end-0 m-3">
                Performance Action
            </span>

            <p class="text-uppercase tracking-wider fw-bold">
                Performance Management & Development System
            </p>

            <h2>
                Personal Assistance Plan (PAP)
            </h2>

            <p>
                To improve on unsatisfactory performance during
                mid-term and/or final assessments.
            </p>

        </div>


        <!-- =====================================================
             A. PERSONAL PARTICULARS  (NOW UNIFIED CARD)
             ===================================================== -->

        <div class="personal-particulars">

            <div class="section-header">
                <i class="bi bi-person-badge-fill"></i>
                <h5>A. Personal Particulars</h5>
            </div>

            <p class="section-description">
                Employee information – read-only fields populated from system records.
            </p>

            <div class="personal-grid">

                <!-- Employee Name -->
                <div class="personal-field">
                    <label for="EmployeeName" class="form-label-custom">
                        <i class="bi bi-person"></i>
                        Employee Full Name
                    </label>
                    <input type="text"
                           id="EmployeeName"
                           name="EmployeeName"
                           value="@Model.EmployeeName"
                           class="form-control"
                           readonly />
                </div>

                <!-- Post Designation -->
                <div class="personal-field">
                    <label for="PostDesignation" class="form-label-custom">
                        <i class="bi bi-briefcase"></i>
                        Post Designation
                    </label>
                    <input type="text"
                           id="PostDesignation"
                           name="Post"
                           value="@Model.Post"
                           class="form-control"
                           readonly />
                </div>

                <!-- Persal Number -->
                <div class="personal-field">
                    <label for="PersalNo" class="form-label-custom">
                        <i class="bi bi-hash"></i>
                        Persal No
                    </label>
                    <input type="text"
                           id="PersalNo"
                           name="PersalNo"
                           value="@Model.PersalNo"
                           class="form-control"
                           readonly />
                </div>

                <!-- Supervisor -->
                <div class="personal-field">
                    <label for="SupervisorName" class="form-label-custom">
                        <i class="bi bi-person-check"></i>
                        Name of Supervisor
                    </label>
                    <input type="text"
                           id="SupervisorName"
                           name="SupervisorName"
                           value="@Model.SupervisorName"
                           class="form-control"
                           readonly />
                </div>

            </div>

        </div>


        <!-- =====================================================
             B. REMEDIAL STEPS
             ===================================================== -->

        <div class="pap-section">

            <div class="section-header">

                <i class="bi bi-tools"></i>

                <h5>
                    B. Remedial Steps
                </h5>

            </div>


            <p class="section-description">

                Remedial steps initiated by Supervisor to improve
