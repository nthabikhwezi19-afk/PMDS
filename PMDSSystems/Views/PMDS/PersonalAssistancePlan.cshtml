        const noButton =
            document.getElementById("performanceNo");

        const nextManagerSection =
            document.getElementById("nextHigherManagerSection");


        if (yesButton &&
            noButton &&
            nextManagerSection) {

            // Always hidden when page first loads
            nextManagerSection.style.setProperty(
                "display",
                "none",
                "important"
            );


            // YES = process ends
            yesButton.addEventListener("click", function () {

                nextManagerSection.style.setProperty(
                    "display",
                    "none",
                    "important"
                );

            });


            // NO = refer to next higher line manager
            noButton.addEventListener("click", function () {

                nextManagerSection.style.setProperty(
                    "display",
                    "block",
                    "important"
                );

            });

        }


