@model PMDSSystems.ViewModels.CyclesViewModel

@{
    ViewData["Title"] = "PMDS Performance Cycles";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>PMDS Cycles</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f4f6f9;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        /* =========================
                   HEADER
                ========================= */

        .header {
            background: linear-gradient(135deg, #006838, #004d2b);
            color: white;
            padding: 30px 35px;
            border-radius: 15px;
            margin-top: 30px;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

            .header h2 {
                font-weight: bold;
                margin-bottom: 8px;
            }

            .header p {
                opacity: .95;
            }


        /* =========================
                   EMPLOYEE CARD
                ========================= */

        .employee-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-top: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
        }

            .employee-card h4 {
                font-weight: bold;
            }

            .employee-card p {
                margin-bottom: 10px;
            }


        /* =========================
                   ASSIGNED EMPLOYEES TABLE
                ========================= */

        .employees-table {
            margin-top: 10px;
        }

            .employees-table thead th {
                background: #006838 !important;
                color: white;
                font-weight: bold;
                vertical-align: middle;
            }

            .employees-table tbody td {
                vertical-align: middle;
            }

            .employees-table tbody tr:hover {
                background: #f0f8f4;
            }


        /* =========================
                   VIEW EMPLOYEE BUTTON
                ========================= */

        .btn-view {
            background: #006838;
            color: white;
            border: none;
            padding: 7px 15px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: .3s;
        }

            .btn-view:hover {
                background: #004d2b;
                color: white;
                transform: translateY(-2px);
            }


        /* =========================
                   NO EMPLOYEES MESSAGE
                ========================= */

        .no-employees {
            border-left: 5px solid #006838;
            background: #f0f8f4;
            padding: 15px 20px;
            border-radius: 8px;
            color: #333;
        }


        /* =========================
                   CYCLE CARDS
                ========================= */

        .cycle-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-top: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
            transition: .3s;
            height: 100%;
        }

            .cycle-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,.12);
            }

        .cycle-title {
            color: #006838;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .cycle-icon {
            font-size: 28px;
            margin-right: 8px;
        }


        /* =========================
                   START BUTTON
                ========================= */

        .btn-start {
            background: #006838;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            transition: .3s;
        }

            .btn-start:hover {
                background: #004d2b;
                color: white;
                transform: translateY(-2px);
            }


        /* =========================
                   RESPONSIVE
                ========================= */

        @@media (max-width: 768px) {

            .header {
                padding: 25px;
            }

            .header-content {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 20px;
            }

            .employee-card {
                padding: 20px;
            }

            .cycle-card {
                padding: 25px;
            }

            .employees-table {
                font-size: 14px;
            }
        }

    </style>

</head>

<body>

    <div class="container">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="header">

            <div class="header-content d-flex justify-content-between align-items-center">

                <!-- WELCOME MESSAGE -->

                <div>

                    <h2>

                        <i class="fa-solid fa-user"></i>

                        Welcome,
                        @Model.Employee.FirstName
                        @Model.Employee.LastName

                    </h2>

                    <p class="mb-0">

                        Performance Management and Development System

                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             EMPLOYEE INFORMATION
        ====================================================== -->

        <div class="employee-card">

            <h4 class="text-success mb-4">

                <i class="fa-solid fa-id-card"></i>

                Employee Information

            </h4>


            <div class="row">

                <!-- LEFT COLUMN -->

                <div class="col-md-6">

                    <p>
                        <strong>Persal Number:</strong>
                        @Model.Employee.PersalNumber
                    </p>

                    <p>
                        <strong>Email:</strong>
                        @Model.Employee.Email
                    </p>

                </div>


                <!-- RIGHT COLUMN -->

                <div class="col-md-6">

                    <p>
                        <strong>Position:</strong>
                        @Model.Employee.Position
                    </p>

                    <p>
                        <strong>Department:</strong>
                        @Model.Employee.Department
                    </p>

                    <p>
                        <strong>Supervisor Name:</strong>
                        @Model.Employee.SupervisorSurnameInitials
                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MY ASSIGNED EMPLOYEES
             ONLY VISIBLE TO SUPERVISORS
        ====================================================== -->
        @if (Model.MyEmployees != null && Model.MyEmployees.Any())
        {
            <div class="employee-card">

                <h4 class="text-success mb-4">

                    <i class="fa-solid fa-users"></i>

                    My Assigned Employees

                </h4>


                @if (Model.MyEmployees == null || !Model.MyEmployees.Any())
                {
                    <div class="no-employees">

                        <i class="fa-solid fa-circle-info me-2"></i>

                        <strong>No employees assigned.</strong>

                        You currently do not have any employees assigned to you.

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-bordered table-hover employees-table">

                            <thead>

                                <tr>

                                    <th>
                                        Persal Number
                                    </th>

                                    <th>
                                        Employee Name
                                    </th>

                                    <th>
                                        Position
                                    </th>

                                    <th>
                                        Department
                                    </th>

                                    <th>
                                        Post Level
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var employee in Model.MyEmployees)
                                {
                                    <tr>

                                        <td>
                                            @employee.PersalNumber
                                        </td>

                                        <td>
                                            <strong>
                                                @employee.FirstName
                                                @employee.LastName
                                            </strong>
                                        </td>

                                        <td>
                                            @employee.Position
                                        </td>

                                        <td>
                                            @employee.Department
                                        </td>

                                        <td>
                                            @employee.PostLevel
                                        </td>

                                        <td>

                                            <a asp-controller="Employee"
                                               asp-action="Details"
                                               asp-route-id="@employee.Id"
                                               class="btn-view">

                                                <i class="fa-solid fa-eye"></i>

                                                View

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>
        }


        <!-- =====================================================
             PERFORMANCE CYCLES
        ====================================================== -->

        <div class="row">

            <!-- =================================================
                 FIRST PERFORMANCE CYCLE
            ================================================== -->

            <div class="col-md-6">

                <div class="cycle-card">

                    <h3 class="cycle-title">

                        <i class="fa-solid fa-calendar-check cycle-icon"></i>

                        First Performance Cycle

                    </h3>

                    <p>

                        Complete your Performance Agreement,
                        Development Plan and all required
                        PMDS documents.

                    </p>

                    <br />

                    <a href="/PMDS/Create"
                       class="btn-start">

                        <i class="fa-solid fa-play"></i>

                        Start First Cycle

                    </a>

                </div>

            </div>


            <!-- =================================================
                 SECOND PERFORMANCE CYCLE
            ================================================== -->

            <div class="col-md-6">

                <div class="cycle-card">

                    <h3 class="cycle-title">

                        <i class="fa-solid fa-calendar cycle-icon"></i>

                        Second Performance Cycle

                    </h3>

                    <p>

                        This cycle will become available
                        once the first cycle has been completed.

                    </p>

                    <br />

                    <a href="/PMDS/MidTermReview"
                       class="btn-start">

                        <i class="fa-solid fa-play"></i>

                        Start Second Cycle

                    </a>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FOOTER SPACE
        ====================================================== -->

        <div style="height: 40px;"></div>

    </div>


    <!-- =========================================================
         BOOTSTRAP JAVASCRIPT
    ========================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>