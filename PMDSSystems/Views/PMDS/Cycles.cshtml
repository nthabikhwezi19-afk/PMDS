@model PMDSSystems.Models.Employee

@{
    ViewData["Title"] = "PMDS Performance Cycles";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>PMDS Cycles</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f4f6f9;
            font-family: Segoe UI;
        }

        .header {
            background: linear-gradient(135deg,#006838,#004d2b);
            color: white;
            padding: 35px;
            border-radius: 15px;
            margin-top: 30px;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

            .header h2 {
                font-weight: bold;
            }

        .employee-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-top: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
        }

        .cycle-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-top: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
            transition: .3s;
        }

            .cycle-card:hover {
                transform: translateY(-5px);
            }

        .cycle-title {
            color: #006838;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .btn-start {
            background: #006838;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
        }

            .btn-start:hover {
                background: #004d2b;
                color: white;
            }

        .coming-soon {
            background: #e9ecef;
            color: #666;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: bold;
        }

    </style>

</head>

<body>

    <div class="container">

        <div class="header">

            <h2>
                <i class="fa-solid fa-user"></i>

                Welcome,
                @Model.FirstName @Model.LastName
            </h2>

            <p class="mb-0">

                Performance Management and Development System

            </p>

        </div>


        <div class="employee-card">

            <h4 class="text-success mb-4">

                Employee Information

            </h4>

            <div class="row">

                <div class="col-md-6">

                    <p><strong>Persal Number:</strong> @Model.PersalNumber</p>

                    <p><strong>Email:</strong> @Model.Email</p>

                </div>

                <div class="col-md-6">

                    <p><strong>Position:</strong> @Model.Position</p>

                    <p><strong>Department:</strong> @Model.Department</p>
                    <p><strong>Supervisor Name:</strong> @Model.SupervisorSurnameInitials</p>

                </div>

            </div>

        </div>


        <div class="row">

            <div class="col-md-6">

                <div class="cycle-card">

                    <h3 class="cycle-title">

                        <i class="fa-solid fa-calendar-check"></i>

                        First Performance Cycle

                    </h3>

                    <p>

                        Complete your Performance Agreement,
                        Development Plan and all required
                        PMDS documents.

                    </p>

                    <br />

                    <a href="/PMDS/Create" class="btn-start">
                        Start First Cycle
                    </a>

                </div>

            </div>


            <div class="col-md-6">

                <div class="cycle-card">

                    <h3 class="cycle-title">

                        <i class="fa-solid fa-calendar"></i>

                        Second Performance Cycle

                    </h3>

                    <p>

                        This cycle will become available
                        once the first cycle has been completed.

                    </p>

                    <br />

                    <a href="/PMDS/MidTermReview" class="btn-start">
                        Start Second Cycle
                    </a>

                </div>

            </div>

        </div>

    </div>

</body>

</html>