                               id="Surname"
                               name="Surname"
                               value="@Model.Surname"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Supervisor's Position</label>
                        <input type="text"
                               id="SupervisorPosition"
                               name="SupervisorPosition"
                               value="@Model.SupervisorPosition"
                               class="form-control"
                               readonly />
                    </div>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Persal No</label>
                        <input type="text"
                               id="PersalNo"
                               name="PersalNo"
                               value="@Model.PersalNo"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Directorate / Section</label>
                        <input type="text"
                               id="Directorate"
                               name="Directorate"
                               value="@Model.Directorate"
                               class="form-control"
                               readonly />
                    </div>
                </div>
            </div>

            <!-- Row 3 -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>ID Number</label>
                        <input type="text"
                               id="IdNumber"
                               name="IdNumber"
                               value="@Model.IdNumber"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Branch / Region</label>
                        <input type="text"
                               id="Branch"
                               name="Branch"
                               value="@Model.Branch"
                               class="form-control"
                               readonly />
                    </div>
                </div>
            </div>

            <!-- Row 4 -->
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Salary Level</label>
                        <input type="number"
                               name="SalaryLevel"
                               value="@Model.SalaryLevel"
                               class="form-control"
                               readonly />
                             
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Gender</label>
                        <input type="text"
                               id="Gender"
                               name="Gender"
                               value="@Model.Gender"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Age Group</label>
                        <select name="AgeGroup" class="form-control">
                            <option value="">-- Select Age Group --</option>
                            <option value="Below 35">Below 35</option>
                            <option value="35 – 55">35 – 55</option>
                            <option value="Above 55">Above 55</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Row 5 -->
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Race</label>
                        <input type="text"
                               id="Race"
                               name="Race"
                               value="@Model.Race"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Disability</label>
                        <input type="text"
                               id="Disabled"
                               name="Disabled"
                               value="@Model.Disabled"
                               class="form-control"
                               readonly />
                    </div>
                </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Nature of Disability</label>
                        <input type="text"
                               name="DisabilityDetails"
                               class="form-control"
                               placeholder="Specify nature of disability (if applicable)" />
                    </div>
                </div>
            </div>

            <hr class="divider" />

    <!-- 2. Educational Background -->
    <div class="section-header">
        <span class="section-number">2</span>
        <h4>Educational Background</h4>
    </div>

    <div class="table-container">
        <table class="table table-bordered" id="educationTable">
            <thead>
                <tr>
                    <th>Qualification</th>
                    <th>NQF Level</th>
                    <th>Year Completed</th>
                    <th style="width: 100px;">Action</th>
                </tr>
            </thead>

            <tbody id="educationTableBody">
                <tr>
                    <td>
                        <input name="Qualification1"
                               class="form-control"
                               placeholder="Qualification" />
                    </td>

                    <td>
                        <input name="NQF1"
                               class="form-control"
                               placeholder="NQF Level" />
                    </td>

                    <td>
                        <input name="Year1"
                               class="form-control"
                               placeholder="Year" />
                    </td>

                    <td class="text-center">
                        <button type="button"
                                class="btn btn-danger btn-sm remove-education"
                                style="display: none;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Add Qualification Button -->
    <div style="margin-top: 10px; margin-bottom: 20px;">
        <button type="button"
                id="addEducation"
                class="btn btn-success">
            <i class="fas fa-plus"></i>
            Add Qualification
        </button>
    </div>

    <div class="form-group">
        <label class="sub-header">Workshops / Courses (Last 5 Years)</label>

        <textarea name="Workshops"
                  class="form-control"
                  placeholder="List workshops and courses attended in the last 5 years..."></textarea>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Current Studies</label>

                <input type="text"
                       name="CurrentStudies"
                       class="form-control"
                       placeholder="Enter current studies" />
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label>Bursary Holder?</label>

                <select name="Bursary" class="form-control">
                    <option value="">-- Select --</option>
                    <option value="No">No</option>
                    <option value="Yes">Yes</option>
                </select>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label>Bursary Duration</label>

        <input type="text"
               name="BursaryDuration"
               class="form-control"
               placeholder="Enter bursary duration (if applicable)" />
    </div>

    <hr class="divider" />

            <!-- 3. Job Requirements vs Training -->
            <div class="section-header">
                <span class="section-number">3</span>
                <h4>Job Requirements vs Training Required</h4>
            </div>

    <div class="table-container">
        <table class="table table-bordered" id="jobRequirementsTable">
            <thead>
                <tr>
                    <th>Tasks / KPA</th>
                    <th>Training Needed</th>
                    <th>Type of Learning</th>
                    <th>NQF</th>
                    <th>Cost</th>
                    <th>Impact</th>
                    <th style="width: 80px;">Action</th>
                </tr>
            </thead>

            <tbody id="jobRequirementsTableBody">
                <tr>
                    <td>
                        <input name="Task1"
                               class="form-control"
                               placeholder="Task/KPA" />
                    </td>

                    <td>
                        <input name="Training1"
                               class="form-control"
                               placeholder="Training needed" />
                    </td>

                    <td>
                        <input name="LearningType1"
                               class="form-control"
                               placeholder="Type of learning" />
                    </td>

                    <td>
                        <input name="NQFLevel1"
                               class="form-control"
                               placeholder="NQF" />
                    </td>

                    <td>
                        <input name="Cost1"
                               class="form-control"
                               placeholder="Cost" />
                    </td>

                    <td>
                        <input name="Impact1"
                               class="form-control"
                               placeholder="Impact" />
                    </td>

                    <td class="text-center">
                        <button type="button"
                                class="btn btn-danger btn-sm remove-job-requirement"
                                style="display: none;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Add Requirement Button -->
    <div style="margin-top: 10px; margin-bottom: 20px;">
        <button type="button"
                id="addJobRequirement"
                class="btn btn-success">
            <i class="fas fa-plus"></i>
            Add Requirement
        </button>
    </div>

            <hr class="divider" />

            <!-- Signatures -->
            <div class="section-header">
                <span class="section-number">4</span>
                <h4>Declaration</h4>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Employee Signature</label>
                        <input type="text" name="EmployeeSignature" class="form-control" placeholder="Employee signature" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Date</label>
                        <input type="date" name="EmployeeDate" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Supervisor Name</label>
                <input type="text" name="SupervisorName" class="form-control" placeholder="Enter supervisor name" />
            </div>

            <!-- FORM ACTIONS -->
            <hr class="divider" />

            <!-- 5. FOR OFFICE USE ONLY -->
            <div class="section-header">
                <span class="section-number">5</span>
                <h4>FOR OFFICE USE ONLY</h4>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Captured on database</label>
                        <select name="CapturedOnDatabase" class="form-control">
                            <option value="">-- Select --</option>
                            <option>Yes</option>
                            <option>No</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Date Captured</label>
                        <input type="date" name="DateCaptured" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="reset" class="btn btn-secondary">
                    <i class="fas fa-undo"></i> Reset
                </button>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Save
                </button>
            </div>

        </form>
    </div>
</div>

<!-- Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<script>
    // Add auto-resize to textareas
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('textarea').forEach(textarea => {
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = this.scrollHeight + 'px';
            });
        });

        // Form validation feedback
        document.querySelector('form').addEventListener('submit', function(e) {
            const requiredFields = this.querySelectorAll('[required]');
            let isValid = true;

            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    field.classList.add('is-invalid');
                    isValid = false;
                } else {
                    field.classList.remove('is-invalid');
                }
            });

            if (!isValid) {
                e.preventDefault();
                alert('Please fill in all required fields.');
            }
        });

        // Remove invalid class on input
        document.querySelectorAll('.form-control').forEach(field => {
            field.addEventListener('input', function() {
                this.classList.remove('is-invalid');
            });
        });
    });
        document.addEventListener('DOMContentLoaded', function () {

        const addEducationButton = document.getElementById('addEducation');
        const educationTableBody = document.getElementById('educationTableBody');

        let educationRowNumber = 1;

        addEducationButton.addEventListener('click', function () {

            educationRowNumber++;

            const newRow = document.createElement('tr');

            newRow.innerHTML = `
                <td>
                    <input name="Qualification${educationRowNumber}"
                           class="form-control"
                           placeholder="Qualification" />
                </td>

                <td>
                    <input name="NQF${educationRowNumber}"
                           class="form-control"
                           placeholder="NQF Level" />
                </td>

                <td>
                    <input name="Year${educationRowNumber}"
                           class="form-control"
                           placeholder="Year" />
                </td>

                <td class="text-center">
                    <button type="button"
                            class="btn btn-danger btn-sm remove-education">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;

            educationTableBody.appendChild(newRow);

            updateRemoveButtons();
        });

        function updateRemoveButtons() {

            const rows = educationTableBody.querySelectorAll('tr');
            const removeButtons = educationTableBody.querySelectorAll('.remove-education');

            removeButtons.forEach(function (button) {

                if (rows.length > 1) {
                    button.style.display = 'inline-flex';
                } else {
                    button.style.display = 'none';
                }

            });
        }

        educationTableBody.addEventListener('click', function (e) {

            const removeButton = e.target.closest('.remove-education');

            if (removeButton) {

                const row = removeButton.closest('tr');

                row.remove();

                updateRemoveButtons();
            }
        });

    });
        // ===============================
    // JOB REQUIREMENTS - ADD ROW
    // ===============================

    const addJobRequirementButton = document.getElementById('addJobRequirement');
    const jobRequirementsTableBody = document.getElementById('jobRequirementsTableBody');

    let jobRequirementRowNumber = 1;

    addJobRequirementButton.addEventListener('click', function () {

        jobRequirementRowNumber++;

        const newRow = document.createElement('tr');

        newRow.innerHTML = `
            <td>
                <input name="Task${jobRequirementRowNumber}"
                       class="form-control"
                       placeholder="Task/KPA" />
            </td>

            <td>
                <input name="Training${jobRequirementRowNumber}"
                       class="form-control"
                       placeholder="Training needed" />
            </td>

            <td>
                <input name="LearningType${jobRequirementRowNumber}"
                       class="form-control"
                       placeholder="Type of learning" />
            </td>

            <td>
                <input name="NQFLevel${jobRequirementRowNumber}"
                       class="form-control"
                       placeholder="NQF" />
            </td>

            <td>
                <input name="Cost${jobRequirementRowNumber}"
                       class="form-control"
                       placeholder="Cost" />
            </td>

            <td>
                <input name="Impact${jobRequirementRowNumber}"
                       class="form-control"
                       placeholder="Impact" />
            </td>

            <td class="text-center">
                <button type="button"
                        class="btn btn-danger btn-sm remove-job-requirement">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        `;

        jobRequirementsTableBody.appendChild(newRow);

        updateJobRequirementRemoveButtons();
    });


    // Show/hide remove buttons
    function updateJobRequirementRemoveButtons() {

        const rows = jobRequirementsTableBody.querySelectorAll('tr');

        const removeButtons =
            jobRequirementsTableBody.querySelectorAll('.remove-job-requirement');

        removeButtons.forEach(function (button) {

            if (rows.length > 1) {
                button.style.display = 'inline-flex';
            } else {
                button.style.display = 'none';
            }

        });
    }


    // Remove job requirement row
    jobRequirementsTableBody.addEventListener('click', function (e) {

        const removeButton =
            e.target.closest('.remove-job-requirement');

        if (removeButton) {

            const row = removeButton.closest('tr');

            row.remove();

            updateJobRequirementRemoveButtons();
        }
    });
</script>