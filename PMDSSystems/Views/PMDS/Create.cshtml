
@model PMDSSystems.Models.PMDSForm

@{
    ViewData["Title"] = "PMDS Form";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <title>PMDS Form</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f4f6f9;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #333;
        }

        .main-container {
            background: #ffffff;
            margin-top: 30px;
            margin-bottom: 30px;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.15);
        }

        .title {
            text-align: center;
            color: #006838;
            font-weight: bold;
        }

            .title h2 {
                font-weight: 700;
                margin-bottom: 5px;
            }

            .title h4 {
                font-weight: 600;
                margin-bottom: 15px;
            }

        .subtitle {
            text-align: center;
            margin-bottom: 25px;
        }

            .subtitle h4 {
                color: #333;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .subtitle h6 {
                color: #555;
                font-weight: 600;
            }

        hr {
            border: 0;
            height: 3px;
            background: #006838;
            opacity: 1;
            margin: 20px 0 25px 0;
        }

        .section-title {
            background: #006838;
            color: white;
            padding: 12px 15px;
            font-size: 17px;
            font-weight: 700;
            margin-top: 25px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .form-label {
            font-weight: 700;
            color: #333;
            margin-bottom: 7px;
        }

        .info-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            min-height: 42px;
            padding: 9px 12px;
            color: #333;
            width: 100%;
        }

        .form-control {
            border-radius: 5px;
            border: 1px solid #ced4da;
            padding: 10px 12px;
        }

            .form-control:focus {
                border-color: #006838;
                box-shadow: 0 0 0 0.2rem rgba(0, 104, 56, 0.15);
            }

        .signature-input {
            font-family: cursive;
            font-size: 20px;
        }

        .declaration-text {
            background: #f8f9fa;
            border-left: 4px solid #006838;
            padding: 15px;
            border-radius: 5px;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .button-area {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #dee2e6;
            text-align: center;
        }

        .btn {
            min-width: 150px;
            padding: 10px 20px;
            font-weight: 600;
            border-radius: 5px;
        }

        .btn-success {
            background-color: #006838;
            border-color: #006838;
        }

            .btn-success:hover {
                background-color: #00552e;
                border-color: #00552e;
            }

        .btn-outline-secondary {
            margin-right: 10px;
        }

        @@media (max-width: 768px) {
            .main-container

        {
            padding: 20px;
            margin-top: 15px;
        }

        .title h2 {
            font-size: 22px;
        }

        .title h4 {
            font-size: 17px;
        }

        .section-title {
            font-size: 15px;
        }

        .button-area .btn {
            width: 100%;
            margin-bottom: 10px;
        }

        .btn-outline-secondary {
            margin-right: 0;
        }

        }
        /* ============================= */
        /* SIGNATURE PAD */
        /* ============================= */

        .signature-wrapper {
            width: 100%;
        }

        #signatureCanvas {
            width: 100%;
            height: 180px;
            border: 2px solid #006838;
            border-radius: 6px;
            background-color: #ffffff;
            cursor: crosshair;
            touch-action: none;
            display: block;
        }

        .signature-buttons {
            margin-top: 10px;
        }

            .signature-buttons .btn {
                min-width: 120px;
            }
    </style>
</head>

<body>

    <div class="container">

        <div class="main-container">

            <!-- ============================= -->
            <!-- PAGE HEADER -->
            <!-- ============================= -->

            <div class="title">

                <h2>
                    DEPARTMENT OF CORRECTIONAL SERVICES
                </h2>

                <h4>
                    PERFORMANCE MANAGEMENT AND DEVELOPMENT SYSTEM
                </h4>

            </div>

            <hr />

            <!-- ============================= -->
            <!-- PART A -->
            <!-- ============================= -->

            <div class="subtitle">

                <h4>
                    PART A : PERSONAL PARTICULARS
                </h4>

                <h6>
                    Performance Cycle Period :
                    <strong>1 April 2025 - 31 March 2026</strong>
                </h6>

            </div>


            <form asp-action="Create" method="post">

                <!-- ============================= -->
                <!-- PERSONAL PARTICULARS -->
                <!-- ============================= -->

                <div class="section-title">
                    PERSONAL PARTICULARS
                </div>


                <!-- ROW 1 -->

                <div class="row g-4 mb-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Persal Number
                        </label>

                        <div class="info-box">
                            @Model.PersalNumber
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Division / Unit / Directorate
                        </label>

                        <div class="info-box">
                            @Model.Directorate
                        </div>

                    </div>

                </div>


                <!-- ROW 2 -->

                <div class="row g-4 mb-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Surname & Initials
                        </label>

                        <div class="info-box">
                            @Model.SurnameInitials
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Appointment / Promotion Date
                        </label>

                        <div class="info-box">
                          @*   @Model.AppointmentDateInCurrentRank *@
                        </div>

                    </div>

                </div>


                <!-- ROW 3 -->

                <div class="row g-4 mb-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Post Designation
                        </label>

                        <div class="info-box">
                            @Model.PostDesignation
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Appointment Date in DCS
                        </label>

                        <div class="info-box">
                            @Model.AppointmentDate
                        </div>

                    </div>

                </div>


                <!-- ROW 4 -->

                <div class="row g-4 mb-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Current Rank
                        </label>

                        <div class="info-box">
                            @Model.CurrentRank
                        </div>

                    </div>
                    <div class="col-md-6">

                        <label asp-for="SupervisorSurnameInitials" class="form-label">
                            Supervisor
                        </label>

                        <input asp-for="SupervisorSurnameInitials"
                               class="form-control"
                               placeholder="Enter Supervisor name and initials" />

                    </div>
                <!-- ROW 5 -->
                    <div class="col-md-6">

                        <label asp-for="SupervisorRankPostLevel" class="form-label">
                            Supervisor Rank
                        </label>

                        <input asp-for="SupervisorRankPostLevel"
                               class="form-control"
                               placeholder="Enter Supervisor Rank / Post Level" />

                    </div>
                   
                    <div class="col-md-6">

                        <label class="form-label">
                            Related OSD Description
                        </label>

                        <div class="info-box">
                            @Model.OSDDescription
                        </div>

                    </div>

                </div>


                <!-- ============================= -->
                <!-- TRANSFER DETAILS -->
                <!-- ============================= -->

                <div class="section-title">
                    TRANSFER DETAILS
                </div>


                <div class="row g-4 mb-3">

                    <!-- PREVIOUS STATION -->

                    <div class="row g-4 mb-3">

                        <div class="col-md-4">
                            <label class="form-label">Previous Station</label>

                            <div class="info-box">
                                @(Model.PreviousStation ?? "Not Available")
                            </div>
                        </div>


                    <!-- TRANSFER DATE -->

                        <div class="col-md-4">
                            <label class="form-label">Transfer Date</label>

                            <div class="info-box">
                                @(Model.TransferDate?.ToString("dd/MM/yyyy") ?? "Not Available")
                            </div>
                        </div>


                    <!-- PREVIOUS PERFORMANCE -->

                        <div class="col-md-4">
                            <label class="form-label">Previous Cycle Performance %</label>

                            <div class="info-box">
                                @(Model.PreviousCyclePerformance?.ToString() ?? "Not Available")
                            </div>
                        </div>
                    </div>

                </div>


                <!-- ============================= -->
                <!-- DECLARATION -->
                <!-- ============================= -->

                <div class="section-title">
                    DECLARATION
                </div>


                <div class="declaration-text">

                    I hereby declare that the information above is true and correct,
                    that it will be noted in the records, and I undertake to notify
                    the Local HR Personnel Office of any changes should they occur.

                </div>


                <!-- SIGNATURE + DATE -->

                <div class="row g-4">

                    <!-- EMPLOYEE SIGNATURE -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Employee Signature
                        </label>

                        <div class="signature-wrapper">

                            <canvas id="signatureCanvas"></canvas>

                            <div class="signature-buttons">
                                <button type="button"
                                        id="clearSignature"
                                        class="btn btn-outline-secondary btn-sm">
                                    Clear Signature
                                </button>
                            </div>

                        </div>

                        <!-- Hidden field that will contain the drawn signature -->
                        <input asp-for="EmployeeSignature"
                               type="hidden"
                               id="EmployeeSignature" />

                        <small class="text-muted">
                            Please draw your signature in the box above.
                        </small>

                    </div>


                    <!-- DECLARATION DATE -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Date
                        </label>

                        <input asp-for="DeclarationDate"
                               type="date"
                               class="form-control" />

                    </div>

                </div>


                <!-- ============================= -->
                <!-- BUTTONS -->
                <!-- ============================= -->

                <div class="button-area text-center">

                    <a href="/PMDS/Cycles"
                       class="btn btn-success btn-lg me-2">
                        Back
                    </a>

                    <a href="/PerformanceAgreement/Create/Agreement"
                       class="btn btn-success btn-lg">
                        Save
                    </a>

                </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">

    </script>
                <script>
                    document.addEventListener("DOMContentLoaded", function () {

                        const canvas = document.getElementById("signatureCanvas");
                        const hiddenInput = document.getElementById("EmployeeSignature");
                        const clearButton = document.getElementById("clearSignature");

                        const ctx = canvas.getContext("2d");

                        let drawing = false;

                        function resizeCanvas() {

                            const rect = canvas.getBoundingClientRect();

                            const devicePixelRatio = window.devicePixelRatio || 1;

                            canvas.width = rect.width * devicePixelRatio;
                            canvas.height = rect.height * devicePixelRatio;

                            ctx.scale(devicePixelRatio, devicePixelRatio);

                            ctx.lineWidth = 2;
                            ctx.lineCap = "round";
                            ctx.lineJoin = "round";
                            ctx.strokeStyle = "#000000";
                        }

                        resizeCanvas();

                        window.addEventListener("resize", function () {
                            resizeCanvas();
                        });


                        function getPosition(event) {

                            const rect = canvas.getBoundingClientRect();

                            return {
                                x: event.clientX - rect.left,
                                y: event.clientY - rect.top
                            };
                        }


                        canvas.addEventListener("pointerdown", function (event) {

                            drawing = true;

                            canvas.setPointerCapture(event.pointerId);

                            const position = getPosition(event);

                            ctx.beginPath();

                            ctx.moveTo(position.x, position.y);

                            event.preventDefault();
                        });


                        canvas.addEventListener("pointermove", function (event) {

                            if (!drawing) {
                                return;
                            }

                            const position = getPosition(event);

                            ctx.lineTo(position.x, position.y);

                            ctx.stroke();

                            event.preventDefault();
                        });


                        canvas.addEventListener("pointerup", function (event) {

                            drawing = false;

                            saveSignature();

                            event.preventDefault();
                        });


                        canvas.addEventListener("pointercancel", function () {

                            drawing = false;

                            saveSignature();
                        });


                        function saveSignature() {

                            const blankCanvas = document.createElement("canvas");

                            blankCanvas.width = canvas.width;
                            blankCanvas.height = canvas.height;

                            const blankContext = blankCanvas.getContext("2d");

                            if (canvas.toDataURL() === blankCanvas.toDataURL()) {

                                hiddenInput.value = "";

                                return;
                            }

                            hiddenInput.value = canvas.toDataURL("image/png");
                        }


                        clearButton.addEventListener("click", function () {

                            ctx.clearRect(
                                0,
                                0,
                                canvas.width,
                                canvas.height
                            );

                            hiddenInput.value = "";
                        });

                    });
                </script>
</body>
</html>
