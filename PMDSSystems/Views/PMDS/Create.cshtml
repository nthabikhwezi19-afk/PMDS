@model PMDSSystems.Models.PMDSForm


@{
    ViewData["Title"] = "PMDS Form";
}

<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>PMDS Form</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f4f6f9;
            font-family: 'Segoe UI';
        }

        .main-container {
            background: white;
            margin-top: 30px;
            margin-bottom: 30px;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0,0,0,.15);
        }

        .title {
            text-align: center;
            color: #006838;
            font-weight: bold;
        }

        .subtitle {
            text-align: center;
            font-weight: bold;
        }

        .section-title {
            background: #006838;
            color: white;
            padding: 10px;
            font-weight: bold;
            margin-top: 25px;
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: bold;
        }

        input {
            background: #f8f9fa !important;
        }

        textarea {
            resize: none;
        }

        hr {
            border: 2px solid #006838;
        }

    </style>

</head>

<body>

    <div class="container">

        <div class="main-container">

            <div class="title">

                <h2>DEPARTMENT OF CORRECTIONAL SERVICES</h2>

                <h4>PERFORMANCE MANAGEMENT AND DEVELOPMENT SYSTEM</h4>

            </div>

            <hr />

            <div class="subtitle">

                <h4>

                    PART A : PERSONAL PARTICULARS

                </h4>

                <h6>

                    Performance Cycle Period :

                    1 April 2025 - 31 March 2026

                </h6>

            </div>

            <form asp-action="Create" method="post">

                <div class="section-title">

                    PERSONAL PARTICULARS

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Persal Number

                        </label>

                        <p>@Model.PersalNumber</p>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">

                            Division / Unit / Directorate

                        </label>

                        <p>@Model.Directorate</p>

                    </div>

                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Surname & Initials

                        </label>

                        <p>@Model.SurnameInitials</p>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">

                            Appointment / Promotion Date

                        </label>

                        <p>@Model.AppointmentDate</p>

                    </div>

                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Post Designation

                        </label>

                        <p>@Model.PostDesignation</p>
                    </div>

                    <div class="col-md-6">

                        <label class="form-label">

                            Appointment Date in DCS

                        </label>

                        <p>@Model.AppointmentDate</p>
                    </div>

                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Current Rank

                        </label>
                        <p>@Model.CurrentRank</p>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">

                            Supervisor

                        </label>

                        <p>@Model.SupervisorName</p>

                    </div>

                </div>

                <br />

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Supervisor Rank

                        </label>

                        <p>@Model.PersalNumber</p>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">

                            Related OSD Description

                        </label>

                        <p>@Model.RelatedOSDDescription</p>

                    </div>

                </div>

                <div class="section-title">

                    TRANSFER DETAILS

                </div>

                <div class="row">

                    <div class="col-md-4">

                        <label class="form-label">

                            Previous Station

                        </label>

                        <input class="form-control"
                               value="N/A" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">

                            Transfer Date

                        </label>
                        <input asp-for="TransferDate" id="TransferDate" type="date" class="form-control" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">

                            Previous Cycle Performance %

                        </label>

                        <input asp-for="PreviousPerformancePercentage" id="PreviousPerformancePercentage" class="form-control" />

                    </div>

                </div>


                <div class="section-title">
                    DECLARATION
                </div>

                <p>
                    I hereby declare that the information above is true and correct,
                    that it will be noted in the records, and I undertake to notify
                    the Local HR Personnel Office of any changes should they occur.
                </p>

                <br />

                <div class="row">

                    <!-- SIGNATURE -->
                    <div class="col-md-6">
                        <label class="form-label">Employee Signature</label>
                        <input asp-for="EmployeeSignature"
                               class="form-control"
                               placeholder="Type full name as signature"
                               style="font-family:cursive; font-size:20px;" />
                    </div>

                    <!-- DATE -->
                    <div class="col-md-6">
                        <label class="form-label">Date</label>
                        <input asp-for="DeclarationDate"
                               type="date"
                               class="form-control" />
                    </div>

                </div>
                <br />

                <div class="text-center">
                    

                    <a href="/PMDS/Cycles" class="btn btn-outline-secondary btn-lg">
                        Back
                    </a>
                    <a href="/PerformanceAgreement/Create" class="btn btn-success btn-lg me-2">
                        Save Changes
                    </a>
                </div>

            </form>

        </div>

    </div>

