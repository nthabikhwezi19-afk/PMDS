                            <label class="multi-select-option"><input type="checkbox" class="gaf-checkbox" value="Management of Human Resources" /><span>Management of Human Resources</span></label>
                            <label class="multi-select-option"><input type="checkbox" class="gaf-checkbox" value="Leadership" /><span>Leadership</span></label>
                            <label class="multi-select-option"><input type="checkbox" class="gaf-checkbox" value="Delegation and Empowerment" /><span>Delegation and Empowerment</span></label>
                        </div>
                    </div>
                    <input type="hidden" name="KRAs[${index}].GAFs" class="gaf-hidden" />
                `;
            }

            /* ============================================================
               CREATE KRA ROW
            ============================================================ */
            function createKraRow() {
                const index = getKraCount();
                const row = document.createElement("tr");
                row.className = "kra-row";
                row.innerHTML = `
                    <td class="kra-number">${index + 1}</td>
                    <td><input type="text" name="KRAs[${index}].Name" class="form-control form-control-custom" placeholder="Enter KRA name..." required /></td>
                    <td>
                        <select name="KRAs[${index}].Weight" class="form-select form-select-custom weight-field" required>
                            ${createWeightOptions()}
                        </select>
                    </td>
                    <td><textarea name="KRAs[${index}].Activities" class="form-control form-control-custom" rows="2" placeholder="Activities..." required></textarea></td>
                    <td><textarea name="KRAs[${index}].Standards" class="form-control form-control-custom" rows="2" placeholder="Standards..." required></textarea></td>
                    <td>${createBathoPele(index)}</td>
                    <td>${createGafs(index)}</td>
                    <td style="text-align:center;"><button type="button" class="btn-remove-kra remove-kra"><i class="fas fa-trash"></i></button></td>
                `;
                tableBody.appendChild(row);
                updateKraIndexes();
                updateRemoveButtons();
                updateKraLimitButton();
                calculateTotal();
                updateGafs(row);
            }

            /* ============================================================
               UPDATE KRA INDEXES
            ============================================================ */
            function updateKraIndexes() {
                const rows = tableBody.querySelectorAll(".kra-row");
                rows.forEach(function (row, index) {
                    const number = row.querySelector(".kra-number");
                    if (number) number.textContent = index + 1;
                    const fields = row.querySelectorAll("[name]");
                    fields.forEach(function (field) {
                        let name = field.getAttribute("name");
                        if (!name) return;
                        name = name.replace(/KRAs\[\d+\]/g, "KRAs[" + index + "]");
                        field.setAttribute("name", name);
                    });
                });
            }

            /* ============================================================
               ADD KRA
            ============================================================ */
            addBtn.addEventListener("click", function () {
                const maxKras = getMaxKras();
                if (maxKras === 0) { alert("Please select a Salary Level first."); return; }
                const currentCount = getKraCount();
                if (currentCount >= maxKras) { alert("The selected Salary Level allows a maximum of " + maxKras + " KRAs."); return; }
                createKraRow();
            });

            /* ============================================================
               REMOVE KRA
            ============================================================ */
            tableBody.addEventListener("click", function (event) {
                const button = event.target.closest(".remove-kra");
                if (!button) return;
                const maxKras = getMaxKras();
                if (maxKras === 4) { alert("Salary Levels 2-7 must have exactly 4 KRAs."); return; }
                const rows = tableBody.querySelectorAll(".kra-row");
                if (rows.length <= 1) { alert("You must have at least one KRA."); return; }
                if (!confirm("Are you sure you want to remove this KRA?")) return;
                button.closest(".kra-row").remove();
                updateKraIndexes();
                updateNumberOfKras();
                updateRemoveButtons();
                updateKraLimitButton();
                calculateTotal();
            });

            /* ============================================================
               SALARY LEVEL CHANGE
            ============================================================ */
            salaryLevel.addEventListener("change", function () {
                const maxKras = getMaxKras();
                if (maxKras === 0) {
                    salaryInfo.classList.remove("show");
                    salaryInfoText.textContent = "";
                    addBtn.disabled = true;
                    addBtn.innerHTML = '<i class="fas fa-plus-circle"></i> Select Salary Level';
                    kraLimitMessage.textContent = "Select a salary level to determine the KRA limit.";
                    return;
                }
                if (maxKras === 4) {
                    salaryInfo.classList.add("show");
                    salaryInfoText.textContent = "Salary Levels 2-7 require exactly 4 KRAs.";
                    while (getKraCount() > 4) tableBody.lastElementChild.remove();
                    while (getKraCount() < 4) createKraRow();
                }
                if (maxKras === 6) {
                    salaryInfo.classList.add("show");
                    salaryInfoText.textContent = "This salary level allows up to 6 KRAs. You can add KRAs using the Add KRA button.";
                    while (getKraCount() > 6) tableBody.lastElementChild.remove();
                }
                updateKraIndexes();
                updateNumberOfKras();
                updateRemoveButtons();
                updateKraLimitButton();
                calculateTotal();
            });

            /* ============================================================
               UPDATE NUMBER
            ============================================================ */
            function updateNumberOfKras() {
                numberOfKRAs.value = getKraCount();
            }

            /* ============================================================
               UPDATE ADD BUTTON
            ============================================================ */
            function updateKraLimitButton() {
                const maxKras = getMaxKras();
                const currentCount = getKraCount();
                if (maxKras === 0) {
                    addBtn.disabled = true;
                    addBtn.innerHTML = '<i class="fas fa-plus-circle"></i> Select Salary Level';
                    kraLimitMessage.textContent = "Please select a Salary Level.";
                    return;
                }
                if (maxKras === 4) {
                    addBtn.disabled = true;
                    addBtn.innerHTML = '<i class="fas fa-lock"></i> 4 KRAs Required';
                    kraLimitMessage.textContent = "Salary Levels 2-7 require exactly 4 KRAs.";
                    return;
                }
                if (currentCount < maxKras) {
                    addBtn.disabled = false;
                    addBtn.innerHTML = '<i class="fas fa-plus-circle"></i> Add KRA';
                    kraLimitMessage.textContent = "You currently have " + currentCount + " KRAs. You can add up to " + maxKras + " KRAs.";
                } else {
                    addBtn.disabled = true;
                    addBtn.innerHTML = '<i class="fas fa-lock"></i> Maximum 6 KRAs';
                    kraLimitMessage.textContent = "You have reached the maximum of 6 KRAs.";
                }
            }

            /* ============================================================
               REMOVE BUTTONS
            ============================================================ */
            function updateRemoveButtons() {
                const maxKras = getMaxKras();
                const rows = tableBody.querySelectorAll(".kra-row");
                rows.forEach(function (row) {
                    const button = row.querySelector(".remove-kra");
                    if (!button) return;
                    if (maxKras === 4) button.style.display = "none";
                    else if (rows.length <= 1) button.style.display = "none";
                    else button.style.display = "inline-flex";
                });
            }

            /* ============================================================
               CALCULATE TOTAL  <-- UPDATED WITH EVENT LISTENERS
            ============================================================ */
            function calculateTotal() {
                let total = 0;
                let allFilled = true;
                const fields = tableBody.querySelectorAll(".weight-field");
                fields.forEach(function (field) {
                    const value = parseFloat(field.value);
                    if (!isNaN(value)) total += value;
                    if (field.value === "") allFilled = false;
                });
                total = Math.round(total * 100) / 100;
                totalDisplay.textContent = total + "%";
                if (total === 100 && allFilled && fields.length > 0) {
                    totalDisplay.style.borderColor = "#006838";
                    totalDisplay.style.backgroundColor = "#e8f5ee";
                    weightStatus.className = "weight-status success";
                    weightStatus.innerHTML = '<i class="fas fa-check-circle"></i> Perfect! Total equals 100%';
                } else if (total > 0) {
                    totalDisplay.style.borderColor = "#ffc107";
                    totalDisplay.style.backgroundColor = "#fff3cd";
                    weightStatus.className = "weight-status";
                    weightStatus.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Total should equal 100% (currently ' + total + '%)';
                } else {
                    totalDisplay.style.borderColor = "#006838";
                    totalDisplay.style.backgroundColor = "#ffffff";
                    weightStatus.className = "weight-status";
                    weightStatus.innerHTML = '<i class="fas fa-info-circle"></i> Enter weights';
                }
            }

            /* ============================================================
               WEIGHT CHANGE DETECTION (attach to table, delegated)
            ============================================================ */
            tableBody.addEventListener("change", function (event) {
                if (event.target.classList.contains("weight-field")) {
                    calculateTotal();
                }
            });

            /* ============================================================
               PREPARE SELECTIONS BEFORE SUBMIT
            ============================================================ */
            function prepareSelections() {
                const rows = tableBody.querySelectorAll(".kra-row");
                rows.forEach(function (row) {
                    updateBathoPele(row);
                    updateGafs(row);
                });
            }

            /* ============================================================
               FORM SUBMISSION
            ============================================================ */
            form.addEventListener("submit", function (event) {
                const maxKras = getMaxKras();
                const currentCount = getKraCount();
                prepareSelections();

                if (maxKras === 0) {
                    event.preventDefault();
                    alert("Please select a Salary Level.");
                    return;
                }
                if (maxKras === 4 && currentCount !== 4) {
                    event.preventDefault();
                    alert("Salary Levels 2-7 must have exactly 4 KRAs.");
                    return;
                }
                if (maxKras === 6 && currentCount > 6) {
                    event.preventDefault();
                    alert("The selected Salary Level can have a maximum of 6 KRAs.");
                    return;
                }

                let total = 0;
                let allWeightsFilled = true;
                tableBody.querySelectorAll(".weight-field").forEach(function (field) {
                    if (field.value === "") allWeightsFilled = false;
                    const value = parseFloat(field.value);
                    if (!isNaN(value)) total += value;
                });
                if (!allWeightsFilled) {
                    event.preventDefault();
                    alert("Please select a weight for every KRA.");
                    return;
                }
                if (Math.round(total) !== 100) {
                    event.preventDefault();
                    alert("The total KRA weight must equal 100%. Current total: " + total + "%");
                    return;
                }

                let allBathoSelected = true;
                tableBody.querySelectorAll(".kra-row").forEach(function (row) {
                    const selected = row.querySelectorAll(".batho-checkbox:checked");
                    if (selected.length === 0) allBathoSelected = false;
                });
                if (!allBathoSelected) {
                    event.preventDefault();
                    alert("Please select at least one Batho Pele principle for every KRA.");
                    return;
                }

                updateKraIndexes();
                updateNumberOfKras();
            });

            /* ============================================================
               INITIALISE EXISTING GAFs AND TOTAL
            ============================================================ */
            tableBody.querySelectorAll(".kra-row").forEach(function (row) {
                updateBathoPele(row);
                updateGafs(row);
            });

            updateKraIndexes();
            updateNumberOfKras();
            updateRemoveButtons();
            updateKraLimitButton();
            calculateTotal();
        });
    </script>
</body>
</html>