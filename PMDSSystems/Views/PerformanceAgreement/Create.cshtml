@model PMDSSystems.Models.PerformanceAgreement

@{
    ViewData["Title"] = "Create Performance Agreement";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Create Performance Agreement</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        /* ============================================
                   PAGE BACKGROUND & CONTAINER
                   ============================================ */

        body {
            background: #f4f7fc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-container {
            max-width: 1400px;
            margin: 30px auto;
            padding: 0 20px;
        }

        /* ============================================
                   CARD STYLES
                   ============================================ */

        .form-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            padding: 40px 45px;
            border-top: 6px solid #006838;
            transition: box-shadow 0.3s ease;
        }

            .form-card:hover {
                box-shadow: 0 12px 40px rgba(0, 104, 56, 0.12);
            }

        /* ============================================
                   HEADER
                   ============================================ */

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e9ecef;
            flex-wrap: wrap;
            gap: 15px;
        }

            .page-header h2 {
                font-weight: 700;
                color: #1a2a3a;
                margin: 0;
                font-size: 28px;
            }

                .page-header h2 i {
                    color: #006838;
                    margin-right: 12px;
                }

            .page-header .badge-cycle {
                background: #006838;
                color: white;
                padding: 8px 18px;
                border-radius: 30px;
                font-size: 14px;
                font-weight: 600;
                letter-spacing: 0.3px;
            }

        /* ============================================
                   ALERT / MESSAGE
                   ============================================ */

        .alert-custom {
            border-radius: 12px;
            padding: 16px 20px;
            border: none;
            font-weight: 500;
        }

        .alert-success-custom {
            background: #e8f5ee;
            color: #006838;
            border-left: 5px solid #006838;
        }

        .alert-danger-custom {
            background: #fde8e8;
            color: #a11f2c;
            border-left: 5px solid #dc3545;
        }

        /* ============================================
                   SECTION TITLES
                   ============================================ */

        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: #006838;
            margin-top: 30px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid #006838;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .section-title i {
                font-size: 20px;
                color: #006838;
            }

        .section-divider {
            border: 0;
            height: 2px;
            background: linear-gradient(to right, #006838, transparent);
            margin: 35px 0;
            opacity: 0.3;
        }

        /* ============================================
                   FORM LABELS
                   ============================================ */

        .form-label-custom {
            font-weight: 600;
            color: #1a2a3a;
            margin-bottom: 6px;
            font-size: 14px;
        }

            .form-label-custom .required {
                color: #dc3545;
                margin-left: 4px;
            }

        /* ============================================
                   FORM CONTROLS
                   ============================================ */

        .form-control-custom,
        .form-select-custom {
            border-radius: 8px;
            border: 1.5px solid #e2e8f0;
            padding: 8px 12px;
            font-size: 13px;
            transition: all 0.3s ease;
            background: #fafbfc;
        }

            .form-control-custom:focus,
            .form-select-custom:focus {
                border-color: #006838;
                box-shadow: 0 0 0 3px rgba(0, 104, 56, 0.12);
                background: #ffffff;
            }

            .form-control-custom::placeholder {
                color: #a0aec0;
                font-size: 12px;
            }

        textarea.form-control-custom {
            resize: vertical;
            min-height: 60px;
        }

        /* ============================================
                   KRA TABLE
                   ============================================ */

        .kra-table-container {
            overflow-x: auto;
            margin-top: 15px;
            border-radius: 12px;
            border: 1.5px solid #e9ecef;
        }

        .kra-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            min-width: 900px;
        }

            .kra-table thead th {
                background: linear-gradient(135deg, #006838 0%, #004d28 100%);
                color: white;
                padding: 12px 14px;
                text-align: left;
                font-weight: 700;
                font-size: 13px;
                letter-spacing: 0.3px;
                white-space: nowrap;
                border: 1px solid #004d28;
                position: sticky;
                top: 0;
                z-index: 10;
            }

                .kra-table thead th i {
                    margin-right: 6px;
                    font-size: 12px;
                    opacity: 0.8;
                }

            .kra-table tbody td {
                padding: 8px 10px;
                border: 1px solid #e9ecef;
                vertical-align: middle;
                background: #ffffff;
            }

            .kra-table tbody tr:hover td {
                background: #f8fafc;
            }

            .kra-table tbody tr:last-child td {
                border-bottom: 1px solid #e9ecef;
            }

        /* KRA Number Column */
        .kra-number {
            text-align: center;
            font-weight: 700;
            color: #006838;
            font-size: 14px;
            min-width: 60px;
        }

        /* Inputs inside table */
        .kra-table .form-control-custom,
        .kra-table .form-select-custom {
            border-radius: 6px;
            border: 1.5px solid #e2e8f0;
            padding: 6px 10px;
            font-size: 13px;
            width: 100%;
            min-width: 80px;
            background: #ffffff;
        }

            .kra-table .form-control-custom:focus,
            .kra-table .form-select-custom:focus {
                border-color: #006838;
                box-shadow: 0 0 0 3px rgba(0, 104, 56, 0.1);
            }

            .kra-table .form-control-custom.weight-input {
                width: 70px;
                min-width: 60px;
                text-align: center;
            }

        .kra-table textarea.form-control-custom {
            min-height: 40px;
            height: 40px;
            resize: vertical;
        }

        /* ============================================
                   TABLE ACTIONS
                   ============================================ */

        .btn-add-kra {
            background: #006838;
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            margin-top: 15px;
        }

            .btn-add-kra:hover {
                background: #004d28;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 16px rgba(0, 104, 56, 0.3);
            }

        .btn-remove-kra {
            background: #dc3545;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .btn-remove-kra:hover {
                background: #bb2d3b;
                transform: scale(1.05);
            }

            .btn-remove-kra i {
                font-size: 13px;
            }

        /* ============================================
                   TOTAL WEIGHT
                   ============================================ */

        .total-weight-container {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 20px;
            padding: 15px 20px;
            background: #f8fafc;
            border-radius: 10px;
            border: 1.5px solid #e9ecef;
        }

            .total-weight-container label {
                font-weight: 700;
                color: #1a2a3a;
                margin: 0;
                font-size: 15px;
            }

        .total-weight-display {
            font-weight: 700;
            color: #006838;
            background: #ffffff;
            border: 2px solid #006838;
            border-radius: 8px;
            padding: 6px 20px;
            font-size: 18px;
            min-width: 80px;
            text-align: center;
        }

        .weight-status {
            font-size: 14px;
            font-weight: 600;
            color: #006838;
        }

            .weight-status i {
                margin-right: 6px;
            }

            .weight-status.success {
                color: #006838;
            }

            .weight-status.warning {
                color: #856404;
            }

        /* ============================================
                   SAVE BUTTON
                   ============================================ */

        .btn-save {
            background: linear-gradient(135deg, #006838 0%, #004d28 100%);
            color: white;
            padding: 14px 50px;
            font-weight: 700;
            font-size: 17px;
            border-radius: 12px;
            border: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 4px 20px rgba(0, 104, 56, 0.3);
            cursor: pointer;
        }

            .btn-save:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 30px rgba(0, 104, 56, 0.4);
                color: white;
                background: linear-gradient(135deg, #004d28 0%, #003d1f 100%);
            }

            .btn-save:active {
                transform: translateY(0px);
            }

            .btn-save i {
                font-size: 18px;
            }

        /* ============================================
                   RESPONSIVE
                   ============================================ */

        @@media (max-width: 768px) {
            .form-card {
                padding: 20px;
            }

            .page-header h2 {
                font-size: 22px;
            }

            .page-header .badge-cycle {
                font-size: 12px;
                padding: 6px 14px;
            }

            .btn-save {
                width: 100%;
                justify-content: center;
                padding: 14px 20px;
            }

            .section-title {
                font-size: 16px;
            }

            .total-weight-container {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
            }

            .total-weight-display {
                width: 100%;
            }

            .btn-add-kra {
                width: 100%;
                justify-content: center;
            }
        }

        @@media (max-width: 480px) {
            .form-card {
                padding: 15px;
                border-radius: 10px;
            }

            .kra-table thead th {
                font-size: 11px;
                padding: 8px 6px;
            }

            .kra-table tbody td {
                padding: 4px 6px;
            }

            .kra-table .form-control-custom,
            .kra-table .form-select-custom {
                font-size: 12px;
                padding: 4px 6px;
            }

                .kra-table .form-control-custom.weight-input {
                    width: 50px;
                    min-width: 40px;
                }
        }

        /* ============================================
                   UTILITY HELPERS
                   ============================================ */

        .text-muted-small {
            font-size: 13px;
            color: #718096;
        }

        .mt-30 {
            margin-top: 30px;
        }

        .mb-30 {
            margin-bottom: 30px;
        }
    </style>
</head>

<body>

    <div class="page-container">

        <div class="form-card">

            <!-- ============================================
                 HEADER
                 ============================================ -->

            <div class="page-header">

                <h2>
                    <i class="fas fa-file-signature"></i>
                    Create Performance Agreement
                </h2>

                <span class="badge-cycle">
                    <i class="fas fa-calendar-alt me-2"></i>
                    2025/2026 Cycle
                </span>

            </div>


            <!-- ============================================
                 SUCCESS / ERROR MESSAGES
                 ============================================ -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success-custom alert-custom mb-4">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["Success"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger-custom alert-custom mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    Please fix the errors below before saving.
                </div>
            }


            <!-- ============================================
                 FORM
                 ============================================ -->

            <form asp-controller="PerformanceAgreement"
                  asp-action="Create"
                  method="post"
                  id="agreementForm">

                @Html.AntiForgeryToken()

                <input type="hidden" name="Id" value="0" />


                <!-- ============================================
                     VALIDATION SUMMARY
                     ============================================ -->

                <div asp-validation-summary="All"
                     class="alert alert-danger-custom alert-custom mb-4"
                     style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none");">
                </div>


                <!-- ============================================
                     JOB PURPOSE
                     ============================================ -->

                <div class="section-title">
                    <i class="fas fa-bullseye"></i>
                    Job Information
                </div>

                <div class="mb-4">

                    <label class="form-label-custom">
                        Job Purpose
                        <span class="required">*</span>
                    </label>

                    <textarea name="JobPurpose"
                              class="form-control form-control-custom"
                              rows="3"
                              placeholder="Summarise the overall purpose of this position..."></textarea>

                </div>


                <!-- ============================================
                     JOB RELATED TASKS
                     ============================================ -->

                <div class="mb-4">

                    <label class="form-label-custom">
                        Job Related Tasks
                        <span class="required">*</span>
                    </label>

                    <textarea name="JobRelatedTasks"
                              class="form-control form-control-custom"
                              rows="4"
                              placeholder="List the key tasks and responsibilities of this role..."></textarea>

                </div>


                <!-- ============================================
                     SALARY LEVEL & NUMBER OF KRAs
                     ============================================ -->

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="form-label-custom">
                            Salary Level
                            <span class="required">*</span>
                        </label>

                        <select name="SalaryLevel"
                                class="form-select form-select-custom">

                            <option value="">
                                -- Select Salary Level --
                            </option>

                            <option value="Production (Level 2-7)">
                                Production (Level 2-7)
                            </option>

                            <option value="Supervisor / Junior Management (Level 8-10)">
                                Supervisor / Junior Management (Level 8-10)
                            </option>

                            <option value="Middle Management / Chief (Level 11-12)">
                                Middle Management / Chief (Level 11-12)
                            </option>

                            <option value="Senior Management (Level 13-16)">
                                Senior Management (Level 13-16)
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label-custom">
                            Number of KRAs
                            <span class="required">*</span>
                        </label>

                        <input type="number"
                               name="NumberOfKRAs"
                               id="numberOfKRAs"
                               class="form-control form-control-custom"
                               value="1"
                               min="1"
                               max="10" />

                        <small class="text-muted-small">
                            <i class="fas fa-info-circle me-1"></i>
                            Each KRA should contribute to the overall job objectives.
                        </small>

                    </div>

                </div>


                <hr class="section-divider" />


                <!-- ============================================
                     WORKPLAN SECTION
                     ============================================ -->

                <div class="section-title">
                    <i class="fas fa-tasks"></i>
                    Workplan
                </div>

                <p class="text-muted-small mb-3">
                    <i class="fas fa-info-circle me-1"></i>
                    Complete each KRA with its weight, activities, standards, and relevant Batho Pele and GAF principles.
                </p>


                <!-- ============================================
                     KRA TABLE
                     ============================================ -->

                <div class="kra-table-container">

                    <table class="kra-table" id="kraTable">

                        <thead>

                            <tr>

                                <th style="min-width: 60px; text-align: center;">
                                    <i class="fas fa-hashtag"></i>
                                    #
                                </th>

                                <th style="min-width: 180px;">
                                    <i class="fas fa-tag"></i>
                                    KRA Name
                                </th>

                                <th style="min-width: 80px; text-align: center;">
                                    <i class="fas fa-percent"></i>
                                    Weight
                                </th>

                                <th style="min-width: 180px;">
                                    <i class="fas fa-list"></i>
                                    Key Activities
                                </th>

                                <th style="min-width: 180px;">
                                    <i class="fas fa-flag"></i>
                                    Performance Standards
                                </th>

                                <th style="min-width: 150px;">
                                    <i class="fas fa-handshake"></i>
                                    Batho Pele
                                </th>

                                <th style="min-width: 140px;">
                                    <i class="fas fa-star"></i>
                                    GAFs
                                </th>

                                <th style="min-width: 60px; text-align: center;">
                                    <i class="fas fa-trash"></i>
                                </th>

                            </tr>

                        </thead>

                        <tbody id="kraTableBody">

                            <!-- ============================================
                                 KRA 1
                                 ============================================ -->

                            <tr id="kraRow_0">

                                <td class="kra-number">1</td>

                                <td>
                                    <input type="text"
                                           name="KRAs[0].Name"
                                           class="form-control form-control-custom"
                                           placeholder="Enter KRA name..." />
                                </td>

                                <td>
                                    <input type="text"
                                           name="KRAs[0].Weight"
                                           class="form-control form-control-custom weight-input weight-field"
                                           placeholder="%" />
                                </td>

                                <td>
                                    <textarea name="KRAs[0].Activities"
                                              class="form-control form-control-custom"
                                              rows="2"
                                              placeholder="Activities..."></textarea>
                                </td>

                                <td>
                                    <textarea name="KRAs[0].Standards"
                                              class="form-control form-control-custom"
                                              rows="2"
                                              placeholder="Standards..."></textarea>
                                </td>

                                <td>
                                    <select name="KRAs[0].BathoPele"
                                            class="form-select form-select-custom">

                                        <option value="">-- Select --</option>
                                        <option value="Consultation">Consultation</option>
                                        <option value="Setting Service Standards">Setting Service Standards</option>
                                        <option value="Increasing Access">Increasing Access</option>
                                        <option value="Ensuring Courtesy">Ensuring Courtesy</option>
                                        <option value="Providing Information">Providing Information</option>
                                        <option value="Openness and Transparency">Openness and Transparency</option>
                                        <option value="Redress">Redress</option>
                                        <option value="Value for Money">Value for Money</option>

                                    </select>
                                </td>

                                <td>
                                    <select name="KRAs[0].GAFs"
                                            class="form-select form-select-custom">

                                        <option value="">-- Select GAF --</option>
                                        <option value="Job Knowledge">Job Knowledge</option>
                                        <option value="Acceptance of Responsibility">Acceptance of Responsibility</option>
                                        <option value="Quality of Work">Quality of Work</option>
                                        <option value="Technical Skills">Technical Skills</option>
                                        <option value="Reliability">Reliability</option>
                                        <option value="Initiative">Initiative</option>
                                        <option value="Communication">Communication</option>
                                        <option value="Interpersonal Relationships">Interpersonal Relationships</option>
                                        <option value="Flexibility">Flexibility</option>
                                        <option value="Team Work">Team Work</option>
                                        <option value="Planning and Execution">Planning and Execution</option>
                                        <option value="Management of Financial Resources">Management of Financial Resources</option>
                                        <option value="Management of Human Resources">Management of Human Resources</option>
                                        <option value="Leadership">Leadership</option>
                                        <option value="Delegation and Empowerment">Delegation and Empowerment</option>

                                    </select>
                                </td>

                                <td style="text-align: center;">
                                    <button type="button"
                                            class="btn-remove-kra remove-kra"
                                            style="display: none;"
                                            data-row="0">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

                <!-- ============================================
                     ADD KRA BUTTON
                     ============================================ -->

                <button type="button"
                        id="addKraBtn"
                        class="btn-add-kra">
                    <i class="fas fa-plus-circle"></i>
                    Add KRA
                </button>


                <!-- ============================================
                     TOTAL WEIGHT
                     ============================================ -->

                <div class="total-weight-container">

                    <label>
                        <i class="fas fa-calculator me-2"></i>
                        Total Weight:
                    </label>

                    <span class="total-weight-display" id="totalWeightDisplay">
                        0%
                    </span>

                    <span class="weight-status" id="weightStatus">
                        <i class="fas fa-info-circle"></i>
                        Enter weights to total 100%
                    </span>

                </div>


                <!-- ============================================
                     SAVE BUTTON
                     ============================================ -->

                <div class="mt-30 text-center">

                    <button type="submit"
                            class="btn-save">

                        <i class="fas fa-save"></i>

                        Save Performance Agreement

                        <i class="fas fa-chevron-right"></i>

                    </button>

                    <p class="text-muted-small mt-3">
                        <i class="fas fa-lock me-1"></i>
                        Your information is securely saved.
                    </p>

                </div>

            </form>

        </div>

    </div>


    <!-- ============================================
         VALIDATION SCRIPTS
         ============================================ -->
    @section Scripts {

        <partial name="_ValidationScriptsPartial" />

        <script>
            document.addEventListener("DOMContentLoaded", function () {

                // ============================================
                // VARIABLES
                // ============================================

                let kraCount = 1;
                const tableBody = document.getElementById("kraTableBody");
                const addBtn = document.getElementById("addKraBtn");
                const totalDisplay = document.getElementById("totalWeightDisplay");
                const weightStatus = document.getElementById("weightStatus");
                const numberOfKRAsInput = document.getElementById("numberOfKRAs");


                // ============================================
                // ADD KRA ROW
                // ============================================

                addBtn.addEventListener("click", function () {

                    const index = kraCount;
                    kraCount++;

                    const row = document.createElement("tr");
                    row.id = "kraRow_" + index;

                    row.innerHTML = `

                        <td class="kra-number">${index + 1}</td>

                        <td>
                            <input type="text"
                                   name="KRAs[${index}].Name"
                                   class="form-control form-control-custom"
                                   placeholder="Enter KRA name..." />
                        </td>

                        <td>
                            <input type="text"
                                   name="KRAs[${index}].Weight"
                                   class="form-control form-control-custom weight-input weight-field"
                                   placeholder="%" />
                        </td>

                        <td>
                            <textarea name="KRAs[${index}].Activities"
                                      class="form-control form-control-custom"
                                      rows="2"
                                      placeholder="Activities..."></textarea>
                        </td>

                        <td>
                            <textarea name="KRAs[${index}].Standards"
                                      class="form-control form-control-custom"
                                      rows="2"
                                      placeholder="Standards..."></textarea>
                        </td>

                        <td>
                            <select name="KRAs[${index}].BathoPele"
                                    class="form-select form-select-custom">

                                <option value="">-- Select --</option>
                                <option value="Consultation">Consultation</option>
                                <option value="Setting Service Standards">Setting Service Standards</option>
                                <option value="Increasing Access">Increasing Access</option>
                                <option value="Ensuring Courtesy">Ensuring Courtesy</option>
                                <option value="Providing Information">Providing Information</option>
                                <option value="Openness and Transparency">Openness and Transparency</option>
                                <option value="Redress">Redress</option>
                                <option value="Value for Money">Value for Money</option>

                            </select>
                        </td>

                        <td>
                            <select name="KRAs[${index}].GAFs"
                                    class="form-select form-select-custom">

                                <option value="">-- Select GAF --</option>
                                <option value="Job Knowledge">Job Knowledge</option>
                                <option value="Acceptance of Responsibility">Acceptance of Responsibility</option>
                                <option value="Quality of Work">Quality of Work</option>
                                <option value="Technical Skills">Technical Skills</option>
                                <option value="Reliability">Reliability</option>
                                <option value="Initiative">Initiative</option>
                                <option value="Communication">Communication</option>
                                <option value="Interpersonal Relationships">Interpersonal Relationships</option>
                                <option value="Flexibility">Flexibility</option>
                                <option value="Team Work">Team Work</option>
                                <option value="Planning and Execution">Planning and Execution</option>
                                <option value="Management of Financial Resources">Management of Financial Resources</option>
                                <option value="Management of Human Resources">Management of Human Resources</option>
                                <option value="Leadership">Leadership</option>
                                <option value="Delegation and Empowerment">Delegation and Empowerment</option>

                            </select>
                        </td>

                        <td style="text-align: center;">
                            <button type="button"
                                    class="btn-remove-kra remove-kra"
                                    data-row="${index}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>

                    `;

                    tableBody.appendChild(row);

                    // Update KRA numbers
                    updateKRANumbers();

                    // Update number of KRAs input
                    updateKraCountInput();

                    // Attach weight events
                    attachWeightEvents();

                    // Update remove buttons visibility
                    updateRemoveButtons();

                    // Calculate total
                    calculateTotal();

                });


                // ============================================
                // REMOVE KRA ROW
                // ============================================

                tableBody.addEventListener("click", function (e) {

                    const removeBtn = e.target.closest(".remove-kra");

                    if (!removeBtn) return;

                    const row = removeBtn.closest("tr");

                    if (tableBody.children.length <= 1) {
                        alert("You must have at least one KRA.");
                        return;
                    }

                    if (confirm("Are you sure you want to remove this KRA?")) {
                        row.remove();
                        updateKRANumbers();
                        updateKraCountInput();
                        updateRemoveButtons();
                        calculateTotal();
                    }

                });


                // ============================================
                // UPDATE KRA NUMBERS
                // ============================================

                function updateKRANumbers() {

                    const rows = tableBody.querySelectorAll("tr");

                    rows.forEach(function (row, index) {

                        const numberCell = row.querySelector(".kra-number");

                        if (numberCell) {
                            numberCell.textContent = index + 1;
                        }

                        // Update the data-row attribute on remove button
                        const removeBtn = row.querySelector(".remove-kra");

                        if (removeBtn) {
                            removeBtn.dataset.row = index;
                        }

                    });

                }


                // ============================================
                // UPDATE KRA COUNT INPUT
                // ============================================

                function updateKraCountInput() {

                    const count = tableBody.querySelectorAll("tr").length;

                    if (numberOfKRAsInput) {
                        numberOfKRAsInput.value = count;
                    }

                }


                // ============================================
                // UPDATE REMOVE BUTTONS VISIBILITY
                // ============================================

                function updateRemoveButtons() {

                    const rows = tableBody.querySelectorAll("tr");
                    const removeBtns = tableBody.querySelectorAll(".remove-kra");

                    removeBtns.forEach(function (btn) {

                        if (rows.length > 1) {
                            btn.style.display = "inline-flex";
                        } else {
                            btn.style.display = "none";
                        }

                    });

                }


                // ============================================
                // CALCULATE TOTAL WEIGHT
                // ============================================

                function calculateTotal() {

                    let total = 0;
                    let allFilled = true;
                    const weightFields = tableBody.querySelectorAll(".weight-field");

                    weightFields.forEach(function (input) {

                        const value = parseFloat(input.value);

                        if (!isNaN(value)) {
                            total += value;
                        }

                        if (input.value.trim() === "") {
                            allFilled = false;
                        }

                    });

                    // Round to 2 decimal places
                    total = Math.round(total * 100) / 100;

                    // Update display
                    totalDisplay.textContent = total + "%";

                    // Update status
                    if (Math.abs(total - 100) < 0.01 && allFilled && weightFields.length > 0) {

                        totalDisplay.style.borderColor = "#006838";
                        totalDisplay.style.backgroundColor = "#e8f5ee";

                        weightStatus.className = "weight-status success";
                        weightStatus.innerHTML =
                            '<i class="fas fa-check-circle"></i> ✓ Perfect! Total equals 100%';

                    } else if (total > 0) {

                        totalDisplay.style.borderColor = "#ffc107";
                        totalDisplay.style.backgroundColor = "#fff3cd";

                        weightStatus.className = "weight-status warning";
                        weightStatus.innerHTML =
                            '<i class="fas fa-exclamation-triangle"></i> Total should equal 100% (currently ' + total + '%)';

                    } else {

                        totalDisplay.style.borderColor = "#006838";
                        totalDisplay.style.backgroundColor = "#ffffff";

                        weightStatus.className = "weight-status";
                        weightStatus.innerHTML =
                            '<i class="fas fa-info-circle"></i> Enter weights to total 100%';

                    }

                }


                // ============================================
                // ATTACH WEIGHT EVENTS
                // ============================================

                function attachWeightEvents() {

                    const weightFields = tableBody.querySelectorAll(".weight-field");

                    weightFields.forEach(function (input) {

                        // Remove existing listeners to prevent duplicates
                        input.removeEventListener("input", calculateTotal);
                        input.removeEventListener("change", calculateTotal);

                        // Add new listeners
                        input.addEventListener("input", calculateTotal);
                        input.addEventListener("change", calculateTotal);

                    });

                }


                // ============================================
                // INITIALIZE
                // ============================================

                updateRemoveButtons();
                updateKraCountInput();
                attachWeightEvents();
                calculateTotal();

                // Recalculate when form is submitted (for validation)
                document.getElementById("agreementForm").addEventListener("submit", function () {
                    updateKraCountInput();
                });

            });
        </script>

    }

</body>
</html>