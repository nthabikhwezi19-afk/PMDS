    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("agreementForm");
            const tableBody = document.getElementById("kraTableBody");
            const addBtn = document.getElementById("addKraBtn");
            const salaryLevel = document.getElementById("salaryLevel");
            const numberOfKRAs = document.getElementById("numberOfKRAs");
            const totalDisplay = document.getElementById("totalWeightDisplay");
            const weightStatus = document.getElementById("weightStatus");
            const salaryInfo = document.getElementById("salaryInfo");
            const salaryInfoText = document.getElementById("salaryInfoText");
            const kraLimitMessage = document.getElementById("kraLimitMessage");

            /* COMPULSORY GAFs */
            const mandatoryGafs = ["Job Knowledge", "Acceptance of Responsibility"];

            /* ============================================================
               OPEN / CLOSE DROPDOWN
            ============================================================ */
            document.addEventListener("click", function (event) {
                const button = event.target.closest(".multi-select-button");
                if (button) {
                    const container = button.closest(".multi-select-container");
                    const menu = container.querySelector(".multi-select-menu");
                    document.querySelectorAll(".multi-select-menu.show").forEach(function (openMenu) {
                        if (openMenu !== menu) {
                            openMenu.classList.remove("show");
                            const openButton = openMenu.closest(".multi-select-container").querySelector(".multi-select-button");
                            if (openButton) openButton.classList.remove("active");
                        }
                    });
                    menu.classList.toggle("show");
                    button.classList.toggle("active", menu.classList.contains("show"));
                    return;
                }
                if (event.target.closest(".multi-select-menu")) return;
                document.querySelectorAll(".multi-select-menu.show").forEach(function (menu) {
                    menu.classList.remove("show");
                    const button = menu.closest(".multi-select-container").querySelector(".multi-select-button");
                    if (button) button.classList.remove("active");
                });
            });

            /* ============================================================
               UPDATE BATHO PELE DISPLAY
            ============================================================ */
            function updateBathoPele(row) {
                const checkboxes = row.querySelectorAll(".batho-checkbox:checked");
                const selected = Array.from(checkboxes).map(cb => cb.value);
                const hidden = row.querySelector(".batho-hidden");
                const buttonText = row.querySelector(".batho-button .selected-text");
                hidden.value = selected.join(", ");
                buttonText.textContent = selected.length === 0 ? "Select Batho Pele" : selected.join(", ");
            }

            /* ============================================================
               UPDATE GAF DISPLAY
            ============================================================ */
            function updateGafs(row) {
                mandatoryGafs.forEach(function (mandatoryGaf) {
                    const checkbox = Array.from(row.querySelectorAll(".gaf-checkbox")).find(item => item.value === mandatoryGaf);
                    if (checkbox) checkbox.checked = true;
                });
                const checkboxes = row.querySelectorAll(".gaf-checkbox:checked");
                const selected = Array.from(checkboxes).map(cb => cb.value);
                const hidden = row.querySelector(".gaf-hidden");
                const buttonText = row.querySelector(".gaf-button .selected-text");
                hidden.value = selected.join(", ");
                buttonText.textContent = selected.length === 0 ? "Select GAFs" : selected.join(", ");
            }

            /* ============================================================
               CHECKBOX CHANGE
            ============================================================ */
            tableBody.addEventListener("change", function (event) {
                const checkbox = event.target;
                const row = checkbox.closest(".kra-row");
                if (!row) return;
                if (checkbox.classList.contains("batho-checkbox")) updateBathoPele(row);
                if (checkbox.classList.contains("gaf-checkbox")) {
                    if (checkbox.classList.contains("mandatory-gaf")) checkbox.checked = true;
                    updateGafs(row);
                }
            });

            /* ============================================================
               PROTECT COMPULSORY GAFs
            ============================================================ */
            tableBody.addEventListener("click", function (event) {
                const checkbox = event.target.closest(".mandatory-gaf");
                if (!checkbox) return;
                setTimeout(function () {
                    checkbox.checked = true;
                    const row = checkbox.closest(".kra-row");
                    if (row) updateGafs(row);
                }, 0);
            });

            /* ============================================================
               GET MAX KRAs
            ============================================================ */
            function getMaxKras() {
                const value = salaryLevel.value;
                if (value === "Production (Level 2-7)") return 4;
                if (value === "Supervisor / Junior Management (Level 8-10)") return 6;
                if (value === "Middle Management / Chief (Level 11-12)") return 6;
                if (value === "Senior Management (Level 13-16)") return 6;
                return 0;
            }

            function getKraCount() {
                return tableBody.querySelectorAll(".kra-row").length;
            }

            /* ============================================================
               CREATE WEIGHT OPTIONS
            ============================================================ */
