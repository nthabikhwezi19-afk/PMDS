@model PMDSSystems.Models.MidTermReview

@{
    ViewData["Title"] = "Employee Mid-Term Review";

    var kraEvaluations = Model.KraEvaluations?.ToList()
        ?? new List<PMDSSystems.Models.MidTermKraEvaluation>();
}

<style>
    .review-page {
        max-width: 1200px;
        margin: 25px auto;
        padding: 25px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,.08);
    }

    .review-header {
        background: #006838;
        color: white;
        padding: 24px;
        border-radius: 8px;
        margin-bottom: 24px;
    }

        .review-header h2 {
            margin: 0 0 8px;
            font-weight: 700;
        }

    .section-title {
        color: #006838;
        font-weight: 700;
        border-bottom: 2px solid #c9a84c;
        padding-bottom: 10px;
        margin: 28px 0 16px;
    }

    .employee-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 15px;
    }

    .detail-card {
        background: #f7f9f8;
        border: 1px solid #e1e8e4;
        border-radius: 7px;
        padding: 15px;
        overflow-wrap: anywhere;
    }

    .detail-label {
        display: block;
        color: #666;
        font-size: .85rem;
        margin-bottom: 5px;
    }

    .detail-value {
        font-weight: 600;
        color: #222;
    }

    .table-responsive {
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .kra-table thead th {
        background: #006838;
        color: white;
        vertical-align: middle;
        white-space: nowrap;
    }

    .kra-table td {
        vertical-align: top;
        min-width: 120px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .signature-image {
        max-width: 260px;
        max-height: 100px;
        object-fit: contain;
        border: 1px solid #ddd;
        padding: 8px;
        background: #fff;
    }

    .signature-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 18px;
        min-height: 130px;
        overflow-wrap: anywhere;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .review-page {
            box-shadow: none;
            margin: 0;
            max-width: 100%;
        }
    }
</style>

<div class="review-page">

    <div class="review-header">
        <h2>
            <i class="fa-solid fa-file-lines"></i>
            Mid-Term Performance Review
        </h2>
        <div>Department of Correctional Services</div>
        <small>Employee review record</small>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 no-print mb-3">
        <a asp-controller="Supervisor"
           asp-action="MyAssignedEmployees"
           class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Assigned Employees
        </a>

        <button type="button"
                class="btn btn-success"
                onclick="window.print()">
            <i class="fa-solid fa-print"></i>
            Print Review
        </button>
    </div>

    <h4 class="section-title">Employee Information</h4>

    <div class="employee-details">
        <div class="detail-card">
            <span class="detail-label">Employee Name</span>
            <span class="detail-value">
                @(ViewBag.EmployeeName ?? "Not available")
            </span>
        </div>

        <div class="detail-card">
            <span class="detail-label">Persal Number</span>
            <span class="detail-value">
                @(ViewBag.PersalNumber ?? "Not available")
            </span>
        </div>

        <div class="detail-card">
            <span class="detail-label">Position</span>
            <span class="detail-value">
                @(ViewBag.Position ?? "Not available")
            </span>
        </div>

        <div class="detail-card">
            <span class="detail-label">Review Period</span>
            <span class="detail-value">
                @(string.IsNullOrWhiteSpace(Model.ReviewPeriod)
                                ? "Not specified"
                                : Model.ReviewPeriod)
            </span>
        </div>

        <div class="detail-card">
            <span class="detail-label">Review Reference</span>
            <span class="detail-value">@Model.Id</span>
        </div>
    </div>

    <h4 class="section-title">Key Result Areas and Evaluations</h4>

    @if (kraEvaluations.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped kra-table mb-0">
                <thead>
                    <tr>
                        <th>KRA No.</th>
                        <th>Key Result Area</th>
                        <th>Weight</th>
                        <th>Achievement Standard</th>
                        <th>Employee Achievement</th>
                        <th>Own Rating</th>
                        <th>Supervisor Comments</th>
                        <th>Supervisor Rating</th>
                        <th>Agreed Rating</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kra in kraEvaluations.OrderBy(k => k.KraNumber))
                    {
                        <tr>
                            <td>@kra.KraNumber</td>
                            <td>@kra.KraDescription</td>
                            <td>@kra.Weight</td>
                            <td>@kra.AchievementStandard</td>
                            <td>@kra.EmployeeAchievement</td>
                            <td>@kra.OwnRating</td>
                            <td>@kra.SupervisorComments</td>
                            <td>@kra.SupervisorRating</td>
                            <td>@kra.AgreedRating</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No KRA evaluations are attached to this review.
        </div>
    }

    <h4 class="section-title">Review and Dispute Details</h4>

    <div class="employee-details">
        <div class="detail-card">
            <span class="detail-label">Dispute Recorded</span>
            <span class="detail-value">
                @(Model.HasDispute ? "Yes" : "No")
            </span>
        </div>

        <div class="detail-card">
            <span class="detail-label">Disputed KRA Numbers</span>
            <span class="detail-value">
                @(string.IsNullOrWhiteSpace(Model.DisputedKraNumbers)
                                ? "None recorded"
                                : Model.DisputedKraNumbers)
            </span>
        </div>

        <div class="detail-card">
            <span class="detail-label">Higher Manager Decision</span>
            <span class="detail-value">
                @(string.IsNullOrWhiteSpace(Model.HigherManagerDecision)
                                ? "Not recorded"
                                : Model.HigherManagerDecision)
            </span>
        </div>

        <div class="detail-card">
            <span class="detail-label">Higher Manager</span>
            <span class="detail-value">
                @(string.IsNullOrWhiteSpace(Model.HigherManagerSurnameInitials)
                                ? "Not recorded"
                                : Model.HigherManagerSurnameInitials)
            </span>
        </div>
    </div>

    <h4 class="section-title">Signatures</h4>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="signature-box">
                <strong>Employee Signature</strong>
                <div class="mt-3">
                    @if (!string.IsNullOrWhiteSpace(Model.SuperviseeSignature))
                    {
                        <img src="@Model.SuperviseeSignature"
                             alt="Employee signature"
                             class="signature-image" />
                    }
                    else
                    {
                        <p class="text-muted mt-3">Not signed</p>
                    }
                </div>
                <small>
                    Date:
                    @(Model.SuperviseeSignDate?.ToString("dd MMMM yyyy")
                                        ?? "Not recorded")
                </small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="signature-box">
                <strong>Supervisor Signature</strong>
                <div class="mt-3">
                    @if (!string.IsNullOrWhiteSpace(Model.SupervisorSignature))
                    {
                        <img src="@Model.SupervisorSignature"
                             alt="Supervisor signature"
                             class="signature-image" />
                    }
                    else
                    {
                        <p class="text-muted mt-3">Not signed</p>
                    }
                </div>
                <small>
                    Date:
                    @(Model.SupervisorSignDate?.ToString("dd MMMM yyyy")
                                        ?? "Not recorded")
                </small>
            </div>
        </div>

        <div class="col-md-4">
            <div class="signature-box">
                <strong>Higher Manager Signature</strong>
                <div class="mt-3">
                    @if (!string.IsNullOrWhiteSpace(Model.HigherManagerSignature))
                    {
                        <img src="@Model.HigherManagerSignature"
                             alt="Higher manager signature"
                             class="signature-image" />
                    }
                    else
                    {
                        <p class="text-muted mt-3">Not signed</p>
                    }
                </div>
                <small>
                    Date:
                    @(Model.HigherManagerSignDate?.ToString("dd MMMM yyyy")
                                        ?? "Not recorded")
                </small>
            </div>
        </div>
    </div>

</div>
