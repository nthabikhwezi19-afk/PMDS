@model List<PMDSSystems.Models.Employee>

@{
    ViewData["Title"] = "My Assigned Employees";
}

<!DOCTYPE html>

<html lang="en">

<head>

    
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>My Assigned Employees - PMDS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f4f6f9;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .page-header {
            background: linear-gradient(135deg, #006838, #004d2b);
            color: white;
            padding: 30px 35px;
            border-radius: 15px;
            margin-top: 30px;
            margin-bottom: 25px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .12);
        }

            .page-header h2 {
                font-weight: 700;
                margin-bottom: 8px;
            }

            .page-header p {
                margin: 0;
                opacity: .9;
            }

        .employees-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .08);
        }

        .employees-title {
            color: #006838;
            font-weight: 700;
        }

        .employees-table {
            margin-top: 20px;
        }

            .employees-table thead th {
                background: #006838 !important;
                color: white;
                vertical-align: middle;
                padding: 14px;
            }

            .employees-table tbody td {
                vertical-align: middle;
                padding: 14px;
            }

            .employees-table tbody tr:hover {
                background: #f0f8f4;
            }

        .employee-name {
            color: #006838;
            font-weight: 700;
            text-decoration: none;
        }

            .employee-name:hover {
                color: #004d2b;
                text-decoration: underline;
            }

        .btn-view {
            background: #006838;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: .2s ease;
        }

            .btn-view:hover {
                background: #004d2b;
                color: white;
                transform: translateY(-1px);
            }

        .btn-back {
            color: #006838;
            text-decoration: none;
            font-weight: 600;
        }

            .btn-back:hover {
                color: #004d2b;
                text-decoration: underline;
            }

        .employee-count {
            display: inline-block;
            background: #e8f5ee;
            color: #006838;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            margin-left: 8px;
        }

        .no-employees {
            background: #f0f8f4;
            border-left: 5px solid #006838;
            padding: 18px 20px;
            border-radius: 8px;
            color: #333;
        }

    </style>


</head>

<body>

 
    <div class="container">

        <!-- HEADER -->

        <div class="page-header">

            <h2>
                <i class="fa-solid fa-users me-2"></i>
                My Assigned Employees
            </h2>

            <p>
                View all employees currently assigned to you.
            </p>

        </div>


        <!-- BACK BUTTON -->

        <div class="mb-3">

            <a asp-controller="Supervisor"
               asp-action="Index"
               class="btn-back">

                <i class="fa-solid fa-arrow-left me-2"></i>

                Back

            </a>

        </div>


        <!-- EMPLOYEE LIST -->

        <div class="employees-card">

            <h4 class="employees-title">

                <i class="fa-solid fa-user-group me-2"></i>

                Assigned Employees

                <span class="employee-count">
                    @(Model?.Count ?? 0)
                </span>

            </h4>


            @if (Model == null || !Model.Any())
            {
                <div class="no-employees mt-4">

                    <i class="fa-solid fa-circle-info me-2"></i>

                    <strong>No employees assigned.</strong>

                    You currently do not have any employees assigned to you.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover employees-table">

                        <thead>

                            <tr>

                                <th>Persal Number</th>

                                <th>Employee Name</th>

                                <th>Position</th>

                                <th>Department</th>

                                <th>Post Level</th>

                                <th>Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var employee in Model)
                            {
                                <tr>

                                    <td>
                                        @employee.PersalNumber
                                    </td>

                                    <td>

                                        <a asp-controller="Employee"
                                           asp-action="Details"
                                           asp-route-id="@employee.Id"
                                           class="employee-name">

                                            @employee.FirstName
                                            @employee.LastName

                                        </a>

                                    </td>

                                    <td>
                                        @employee.Position
                                    </td>

                                    <td>
                                        @employee.Department
                                    </td>

                                    <td>
                                        @employee.PostLevel
                                    </td>

                                    <td>

                                        <a asp-controller="Employee"
                                           asp-action="Details"
                                           asp-route-id="@employee.Id"
                                           class="btn-view">

                                            <i class="fa-solid fa-eye"></i>

                                            View Details

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

        <div style="height: 40px;"></div>

    </div>
    

</body>

</html>
