<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Auto-resize textareas
        document.querySelectorAll('textarea').forEach(textarea => {
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = this.scrollHeight + 'px';
            });
        });

        // Form validation feedback
        document.querySelector('form').addEventListener('submit', function(e) {
            const requiredFields = this.querySelectorAll('[required]');
            let isValid = true;

            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    field.classList.add('is-invalid');
                    isValid = false;
                } else {
                    field.classList.remove('is-invalid');
                }
            });

            if (!isValid) {
                e.preventDefault();
                const firstError = document.querySelector('.is-invalid');
                if (firstError) {
                    firstError.focus();
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                alert('Please fill in all required fields.');
            }
        });

        // Remove invalid class on input
        document.querySelectorAll('.form-control, .form-select').forEach(field => {
            field.addEventListener('input', function() {
                this.classList.remove('is-invalid');
            });
            field.addEventListener('change', function() {
                this.classList.remove('is-invalid');
            });
        });

        // Button loading state
        document.querySelector('.btn-primary')?.addEventListener('click', function(e) {
            this.classList.add('loading');
            this.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
            this.disabled = true;
        });
    });

        // ==========================================
    // KRA MODERATION - ADD KRA
    // ==========================================

    let kraCount = 4;

    document.getElementById("addKraBtn").addEventListener("click", function () {

        kraCount++;

        const tbody = document.getElementById("kraModerationBody");

        const row = document.createElement("tr");

        row.innerHTML = `
            <td class="kra-number">${kraCount}</td>

            <td>
                <input name="KRAComments[${kraCount}]"
                       class="form-control"
                       placeholder="Add moderation comments..." />
            </td>

            <td>
                <select name="KRAScore[${kraCount}]"
                        class="form-select">

                    <option value="">Select Rating</option>
                    <option value="1">1 - Not Effective</option>
                    <option value="2">2 - Partially Effective</option>
                    <option value="3">3 - Fully Effective</option>
                    <option value="4">4 - Highly Effective</option>

                </select>
            </td>

            <td class="text-center">
                <button type="button"
                        class="btn btn-danger btn-sm remove-kra"
                        title="Remove KRA">

                    <i class="bi bi-trash"></i>

                </button>
            </td>
        `;

        tbody.appendChild(row);

        updateKraCount();

    });
        // ==========================================
    // REMOVE KRA
    // ==========================================

    document.addEventListener("click", function (e) {

        const removeButton = e.target.closest(".remove-kra");

        if (!removeButton) {
            return;
        }

        const rows = document.querySelectorAll("#kraModerationBody tr");

        // Do not allow fewer than 4 KRAs
        if (rows.length <= 4) {
            alert("You must have at least 4 KRAs.");
            return;
        }

        removeButton.closest("tr").remove();

        renumberKRAs();
        updateKraCount();

    });
        // ==========================================
    // RENUMBER KRAs
    // ==========================================

    function renumberKRAs() {

        const rows = document.querySelectorAll("#kraModerationBody tr");

        rows.forEach(function (row, index) {

            const number = index + 1;

            // Update KRA number
            row.querySelector(".kra-number").textContent = number;

            // Update comment input name
            const commentInput = row.querySelector("input");

            if (commentInput) {
                commentInput.name = `KRAComments[${number}]`;
            }

            // Update score select name
            const scoreSelect = row.querySelector("select");

            if (scoreSelect) {
                scoreSelect.name = `KRAScore[${number}]`;
            }

        });

        kraCount = rows.length;
    }
        // ==========================================
    // UPDATE KRA COUNT
    // ==========================================

    function updateKraCount() {

        const count = document.querySelectorAll(
            "#kraModerationBody tr"
        ).length;

        document.getElementById("kraCount").textContent =
            count + (count === 1 ? " KRA" : " KRAs");

    }
</script>