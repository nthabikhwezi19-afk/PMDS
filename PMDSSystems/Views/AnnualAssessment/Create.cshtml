@model PMDSSystems.Models.AnnualAssessment

@{
    ViewData["Title"] = "Create";
}

<style>

    /* ==========================================
               GLOBAL STYLES
               ========================================== */

    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    /* ==========================================
               PERSAL NUMBER
               ========================================== */

    .personal-field {
        margin-bottom: 22px;
    }

    .form-label-custom {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        color: #006838;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    .label-icon {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #006838, #004d28);
        color: white;
        border-radius: 7px;
        box-shadow: 0 3px 8px rgba(0, 104, 56, 0.20);
    }

        .label-icon i {
            font-size: 15px;
        }

    .label-text {
        position: relative;
    }

        .label-text::after {
            content: "";
            display: block;
            width: 35px;
            height: 2px;
            background: #006838;
            margin-top: 4px;
            border-radius: 2px;
        }

    .personal-field .form-control {
        border: 2px solid #dce3e8;
        border-left: 4px solid #006838;
        background: #f8faf9;
        font-weight: 600;
        color: #333;
        height: 44px;
        border-radius: 6px;
        padding: 10px 14px;
    }

        .personal-field .form-control:focus {
            border-color: #006838;
            border-left: 4px solid #006838;
            box-shadow: 0 0 0 0.15rem rgba(0, 104, 56, 0.12);
            outline: none;
        }

    /* ==========================================
               PAGE HEADER
               ========================================== */

    .page-header {
        background: linear-gradient(135deg, #006838 0%, #004d28 100%);
        color: white;
        padding: 25px 30px;
        border-radius: 12px;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,104,56,0.25);
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(to right, #a8e6cf, #006838, #a8e6cf);
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient( circle, rgba(168,230,207,0.08) 0%, transparent 70% );
            border-radius: 50%;
            pointer-events: none;
        }

        .page-header h3 {
            font-weight: 700;
            letter-spacing: 1px;
            margin: 0;
            font-size: 24px;
            position: relative;
            z-index: 1;
        }

            .page-header h3 i {
                margin-right: 12px;
                color: #a8e6cf;
            }

        .page-header .sub-text {
            color: rgba(255,255,255,0.8);
            font-weight: 300;
            margin-top: 6px;
            font-size: 14px;
            position: relative;
            z-index: 1;
        }

    /* ==========================================
               ALERT
               ========================================== */

    .alert-success {
        background: linear-gradient( 135deg, #e8f5ee 0%, #d4ebe3 100% );
        border: none;
        border-left: 5px solid #006838;
        border-radius: 10px;
        padding: 14px 20px;
        box-shadow: 0 2px 10px rgba(0,104,56,0.1);
        color: #004d28;
        font-weight: 500;
    }

    /* ==========================================
               FORM CONTAINER
               ========================================== */

    .form-container {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 25px rgba(0,0,0,0.06);
        border-top: 5px solid #006838;
        position: relative;
        overflow: hidden;
    }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: radial-gradient( circle, rgba(0,104,56,0.03) 0%, transparent 70% );
            border-radius: 50%;
            pointer-events: none;
        }

    /* ==========================================
               SECTION HEADERS
               ========================================== */

    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 25px 0 15px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #006838;
        position: relative;
    }

        .section-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: linear-gradient( to right, #006838, transparent );
        }

        .section-header h5 {
            color: #006838;
            font-weight: 700;
            margin: 0;
            font-size: 17px;
            letter-spacing: 0.5px;
        }

        .section-header i {
            color: #006838;
            font-size: 20px;
            width: 24px;
            text-align: center;
        }

        .section-header .badge-section {
            margin-left: auto;
            background: #e8f5ee;
            color: #006838;
            padding: 2px 14px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 600;
        }

    /* ==========================================
               FORM CONTROLS
               ========================================== */

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
            display: block;
            font-size: 14px;
        }

            .form-group label .required {
                color: #dc3545;
                margin-left: 3px;
            }

    .form-control {
        border-radius: 6px;
        border: 2px solid #dce3e8;
        padding: 8px 12px;
        transition: all 0.3s ease;
        font-size: 14px;
        width: 100%;
        background: white;
        color: #333;
    }

        .form-control:focus {
            border-color: #006838;
            box-shadow: 0 0 0 0.2rem rgba(0, 104, 56, 0.15);
            outline: none;
            background: white;
        }

        .form-control::placeholder {
            color: #b0b8c0;
            font-size: 13px;
        }

        .form-control.is-invalid {
            border-color: #dc3545;
        }

    select.form-control {
        appearance: auto;
        cursor: pointer;
    }

    /* ==========================================
               TABLE
               ========================================== */

    .table-responsive {
        overflow-x: auto;
        margin: 15px 0;
        border-radius: 8px;
        border: 1px solid #e8edf0;
    }

    .table {
        margin: 0;
        border-collapse: collapse;
        width: 100%;
        font-size: 14px;
    }

        .table thead th {
            background: linear-gradient( 135deg, #006838 0%, #004d28 100% );
            color: white;
            text-align: center;
            vertical-align: middle;
            font-size: 12px;
            padding: 12px 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 1px solid #006838;
            white-space: nowrap;
        }

        .table tbody td {
            vertical-align: middle;
            padding: 8px 6px;
            border: 1px solid #dee2e6;
            background: white;
        }

        .table tbody tr:hover td {
            background-color: #f8faf9;
        }

        .table .kra-number {
            font-weight: 700;
            color: #006838;
            text-align: center;
            font-size: 16px;
            width: 50px;
        }

        .table .form-control {
            font-size: 13px;
            padding: 6px 10px;
            border-radius: 4px;
            border: 2px solid #dce3e8;
        }

            .table .form-control:focus {
                border-color: #006838;
                box-shadow: 0 0 0 0.15rem rgba(0,104,56,0.12);
            }

    .select-rating {
        min-width: 80px;
    }

    /* ==========================================
               DISPUTE
               ========================================== */

    .dispute-section {
        background: #f8faf9;
        border-radius: 8px;
        padding: 18px 20px;
        border-left: 4px solid #006838;
        margin: 20px 0;
    }

        .dispute-section .form-control {
            border-color: #006838;
        }

    /* ==========================================
               ADD KRA
               ========================================== */

    .add-kra-container {
        display: flex;
        justify-content: center;
        margin: 15px 0 25px 0;
    }

    .btn-add-kra {
        background: linear-gradient( 135deg, #006838 0%, #004d28 100% );
        color: white;
        border: none;
        border-radius: 50px;
        padding: 10px 28px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0, 104, 56, 0.25);
        transition: all 0.3s ease;
    }

        .btn-add-kra:hover {
            background: linear-gradient( 135deg, #004d28 0%, #003d1f 100% );
            transform: translateY(-2px);
            color: white;
        }

    .btn-remove-kra {
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 5px 9px;
        cursor: pointer;
        font-size: 12px;
    }

        .btn-remove-kra:hover {
            background: #bb2d3b;
        }

    /* ==========================================
               FINAL PERFORMANCE CALCULATION
               ========================================== */

    .final-calculation {
        background: linear-gradient( 135deg, #f8faf9 0%, #e8f5ee 100% );
        border: 2px solid #006838;
        border-radius: 10px;
        padding: 25px;
        margin: 25px 0;
        box-shadow: 0 4px 15px rgba(0, 104, 56, 0.12);
    }

    .final-calculation-title {
        color: #006838;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 20px;
        text-align: center;
    }

    .calculation-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .calculation-box {
        text-align: center;
        min-width: 180px;
    }

        .calculation-box label {
            display: block;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
            font-size: 13px;
        }

        .calculation-box .form-control {
            text-align: center;
            font-size: 18px;
            font-weight: 700;
            height: 48px;
            border: 2px solid #006838;
        }

    .calculation-operator {
        font-size: 25px;
        font-weight: 700;
        color: #006838;
        padding-top: 22px;
    }

    .final-percentage-box {
        background: #006838;
        color: white;
        border-radius: 8px;
        padding: 12px 20px;
        min-width: 180px;
        text-align: center;
    }

        .final-percentage-box label {
            display: block;
            color: white;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 5px;
        }

    .final-percentage-value {
        font-size: 24px;
        font-weight: 800;
    }

    .category-box {
        background: white;
        border: 2px solid #006838;
        border-radius: 8px;
        padding: 12px 20px;
        min-width: 220px;
        text-align: center;
    }

        .category-box label {
            display: block;
            color: #006838;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 5px;
        }

    .category-value {
        font-size: 18px;
        font-weight: 800;
        color: #006838;
    }

    .calculation-note {
        text-align: center;
        margin-top: 18px;
        color: #666;
        font-size: 12px;
    }

    /* ==========================================
               SIGNATURE SECTION
               ========================================== */

    .signature-section {
        background: #f8faf9;
        border-radius: 8px;
        padding: 18px 20px;
        border-left: 4px solid #006838;
        margin: 20px 0;
    }

    .signature-box {
        background: #ffffff;
        border: 1px solid #dce5df;
        border-radius: 10px;
        padding: 18px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        height: 100%;
    }

    .signature-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #006838;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 5px;
    }

        .signature-title i {
            font-size: 18px;
        }

    .signature-instruction {
        color: #7a8580;
        font-size: 12px;
        margin-bottom: 12px;
    }

    /* ==========================================
               SIGNATURE CANVAS
               ========================================== */

    .signature-canvas-wrapper {
        position: relative;
        width: 100%;
        height: 180px;
        background: #ffffff;
        border: 2px dashed #b9c9bf;
        border-radius: 8px;
        overflow: hidden;
        cursor: crosshair;
        transition: all 0.2s ease;
    }

        .signature-canvas-wrapper:hover {
            border-color: #006838;
            background: #fbfdfc;
        }

    .signature-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: block;
        cursor: crosshair;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
        background: #ffffff;
    }

    /* ==========================================
               SIGNATURE LINE
               ========================================== */

    .signature-canvas-wrapper::after {
        content: "";
        position: absolute;
        left: 25px;
        right: 25px;
        bottom: 35px;
        height: 1px;
        background: #c8d2cc;
        pointer-events: none;
    }

    .signature-canvas-wrapper::before {
        content: "Sign here";
        position: absolute;
        left: 30px;
        bottom: 12px;
        color: #a3ada7;
        font-size: 10px;
        pointer-events: none;
        z-index: 2;
    }

    .signature-canvas-wrapper.has-signature::before {
        display: none;
    }

    /* ==========================================
               SIGNATURE ACTIONS
               ========================================== */

    .signature-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 10px;
    }

    .btn-clear-signature {
        border: 1px solid #dc3545;
        background: white;
        color: #dc3545;
        border-radius: 6px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-clear-signature:hover {
            background: #dc3545;
            color: white;
        }

        .btn-clear-signature i {
            margin-right: 4px;
        }

    .signature-status {
        font-size: 11px;
        font-weight: 600;
        color: #8a9590;
    }

        .signature-status.signed {
            color: #006838;
        }

            .signature-status.signed::before {
                content: "✓ ";
                font-weight: 800;
            }

    /* ==========================================
               SAVE BUTTON
               ========================================== */

    .button-area {
        display: flex;
        justify-content: flex-end;
        margin-top: 30px;
    }

    .btn-save {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 9px !important;
        min-width: 150px;
        height: 46px;
        padding: 0 24px;
        background: #006838 !important;
        color: #ffffff !important;
        border: 2px solid #006838 !important;
        border-radius: 8px;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 104, 56, 0.20);
        transition: all 0.25s ease;
    }

        .btn-save:hover {
            background: #004d28 !important;
            border-color: #004d28 !important;
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0, 77, 40, 0.30);
            text-decoration: none !important;
        }

        .btn-save:active {
            transform: translateY(0);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
        }

        .btn-save i {
            font-size: 15px;
        }

    /* ==========================================
               RESPONSIVE
               ========================================== */

    @@media (max-width: 992px) {

        .container {
            padding: 15px;
        }

        .form-container {
            padding: 20px;
        }

        .page-header h3 {
            font-size: 20px;
        }

        .section-header h5 {
            font-size: 15px;
        }
    }

    @@media (max-width: 768px) {

        .container {
            padding: 10px;
        }

        .page-header {
            padding: 18px 20px;
        }

            .page-header h3 {
                font-size: 17px;
            }

        .form-container {
            padding: 15px;
        }

        .btn-save {
            width: 100%;
            justify-content: center;
        }

        .signature-canvas-wrapper {
            height: 160px;
        }

        .signature-box {
            padding: 14px;
        }
    }

    @@media (max-width: 576px) {

        .container {
            padding: 6px;
        }

        .form-container {
            padding: 12px;
        }

        .table thead th {
            font-size: 8px;
            padding: 4px 3px;
        }

        .table tbody td {
            padding: 3px 2px;
        }

        .signature-section {
            padding: 10px 12px;
        }
    }

    /* ==========================================
               PRINT
               ========================================== */

    @@media print {

        .button-area {
            display: none !important;
        }

        .form-container {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        .page-header {
            background: #006838 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .table thead th {
            background: #006838 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }

</style>


<div class="container">

    <!-- ==========================================
         PAGE HEADER
         ========================================== -->

    <div class="page-header">

        <h3>
            <i class="bi bi-file-check"></i>
            PART D1 & D2: Annual Assessment
        </h3>

        <div class="sub-text">

            <i class="bi bi-calendar3 me-2"></i>

            Performance Cycle:
            1 April 2024 – 31 March 2025

        </div>

    </div>


    <div class="form-container">

        <!-- SUCCESS MESSAGE -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"
                   style="color:#006838;font-size:18px;"></i>

                <div>
                    @TempData["Success"]
                </div>

                <button type="button"
                        class="btn-close ms-auto"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <!-- ==========================================
             FORM
             ========================================== -->

        <form asp-action="Create"
              method="post"
              id="annualAssessmentForm">

            @Html.AntiForgeryToken()




            <!-- ============================================================
                 PART D1 - MOTIVATION FOR KRAs
                 ============================================================ -->

            <div class="section-header">

                <i class="bi bi-list-task"></i>

                <h5>
                    Part D1: Motivation for KRA's
                </h5>

                <span class="badge-section" id="d1KraCount">
                    4 KRAs
                </span>

            </div>


            <div class="table-responsive">

                <table class="table table-bordered align-middle">

                    <thead>

                        <tr>

                            <th style="width: 30%;">
                                KRA
                            </th>

                            <th style="width: 12%;">
                                Weight
                            </th>

                            <th style="width: 28%;">
                                Achievement
                            </th>

                            <th style="width: 25%;">
                                Comment
                            </th>

                            <th style="width: 5%;">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody id="d1KraBody">


                        <!-- ====================================================
                             KRA 1
                             ==================================================== -->

                        <tr>

                            <td>

                                <input type="text"
                                       name="KRA1Name"
                                       id="D1_KRA1Name"
                                       value="@Model.KRA1Name"
                                       class="form-control d1-kra-description"
                                       readonly
                                       style="width:100%; min-width:350px;" />

                            </td>


                            <td>

                                <div class="input-group">

                                    <input type="number"
                                           name="KRA1Weight"
                                           id="D1_KRA1Weight"
                                           value="@Model.KRA1Weight"
                                           class="form-control text-center"
                                           readonly />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                            </td>


                            <td>

                                <textarea asp-for="KRA1Achievement"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Describe achievement..."></textarea>

                            </td>


                            <td>

                                <textarea asp-for="KRA1Comment"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter comment..."></textarea>

                            </td>


                            <td class="text-center">

                                <span class="text-muted">
                                    1
                                </span>

                            </td>

                        </tr>



                        <!-- ====================================================
                             KRA 2
                             ==================================================== -->

                        <tr>

                            <td>
                                <input type="text"
                                       name="KRA2Name"
                                       id="D1_KRA2Name"
                                       value="@Model.KRA2Name"
                                       class="form-control d1-kra-description"
                                       readonly
                                       style="width:100%; min-width:350px;" />

                            </td>


                            <td>

                                <div class="input-group">

                                    <input type="number"
                                           name="KRA2Weight"
                                           id="D1_KRA2Weight"
                                           value="@Model.KRA2Weight"
                                           class="form-control text-center"
                                           readonly />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                            </td>


                            <td>

                                <textarea asp-for="KRA2Achievement"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Describe achievement..."></textarea>

                            </td>


                            <td>

                                <textarea asp-for="KRA2Comment"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter comment..."></textarea>

                            </td>


                            <td class="text-center">

                                <span class="text-muted">
                                    2
                                </span>

                            </td>

                        </tr>



                        <!-- ====================================================
                             KRA 3
                             ==================================================== -->

                        <tr>

                            <td>

                                <input type="text"
                                       name="KRA3Name"
                                       id="D1_KRA3Name"
                                       value="@Model.KRA3Name"
                                       class="form-control d1-kra-description"
                                       readonly
                                       style="width:100%; min-width:350px;" />

                            </td>


                            <td>

                                <div class="input-group">

                                    <input type="number"
                                           name="KRA3Weight"
                                           id="D1_KRA3Weight"
                                           value="@Model.KRA3Weight"
                                           class="form-control text-center"
                                           readonly />

                                    <span class="input-group-text">
