<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


<script>

    // =====================================================
    // PAGE INITIALIZATION
    // =====================================================

    document.addEventListener("DOMContentLoaded", function () {

        initializePage();

    });


    function initializePage() {

        initializeSignaturePads();

        initializeFormValidation();

        initializeWeightValidation();

        initializeSaveButton();

        calculateFinalPercentage();

    }


    // =====================================================
    // SIGNATURE VARIABLES
    // =====================================================

    let employeeSignaturePad = null;

    let supervisorSignaturePad = null;


    // =====================================================
    // INITIALIZE SIGNATURE PADS
    // =====================================================

    function initializeSignaturePads() {

        employeeSignaturePad = createSignaturePad(
            "employeeSignatureCanvas",
            "EmployeeSignature",
            "employeeSignatureStatus",
            "employeeSignatureWrapper"
        );


        supervisorSignaturePad = createSignaturePad(
            "supervisorSignatureCanvas",
            "SupervisorSignature",
            "supervisorSignatureStatus",
            "supervisorSignatureWrapper"
        );

    }


    // =====================================================
    // CREATE SIGNATURE PAD
    // =====================================================

    function createSignaturePad(
        canvasId,
        hiddenInputId,
        statusId,
        wrapperId
    ) {

        const canvas =
            document.getElementById(canvasId);

        const hiddenInput =
            document.getElementById(hiddenInputId);

        const status =
            document.getElementById(statusId);

        const wrapper =
            document.getElementById(wrapperId);


        if (!canvas || !hiddenInput || !status) {

            console.error(
                "Signature elements not found:",
                canvasId
            );

            return null;

        }


        const ctx =
            canvas.getContext("2d");


        let drawing = false;

        let hasSignature = false;

        let lastX = 0;

        let lastY = 0;


        // =================================================
        // SIGNATURE STYLE
        // BLACK INK
        // =================================================

        function setSignatureStyle() {

            ctx.strokeStyle = "#000000";

            ctx.fillStyle = "#000000";

            ctx.lineWidth = 2.5;

            ctx.lineCap = "round";

            ctx.lineJoin = "round";

        }


        // =================================================
        // RESIZE CANVAS
        // =================================================

        function resizeCanvas() {

            const rect =
                canvas.getBoundingClientRect();


            if (
                rect.width === 0 ||
                rect.height === 0
            ) {

                return;

            }


            const existingSignature =
                hiddenInput.value;


            canvas.width =
                Math.floor(rect.width);

            canvas.height =
                Math.floor(rect.height);


            setSignatureStyle();


            // ---------------------------------------------
            // RESTORE EXISTING SIGNATURE
            // ---------------------------------------------

            if (existingSignature) {

                const image =
                    new Image();


                image.onload = function () {

                    ctx.drawImage(
                        image,
                        0,
                        0,
                        canvas.width,
                        canvas.height
                    );


                    hasSignature = true;

                    status.textContent =
                        "Signed";

                    status.classList.add(
                        "signed"
                    );


                    if (wrapper) {

                        wrapper.classList.add(
                            "has-signature"
                        );

                    }

                };


                image.src =
                    existingSignature;

            }

        }


        // Initial setup

        resizeCanvas();


        // Resize screen

        window.addEventListener(
            "resize",
            resizeCanvas
        );


        // =================================================
        // GET MOUSE / TOUCH POSITION
        // =================================================

        function getPosition(event) {

            const rect =
                canvas.getBoundingClientRect();


            let clientX;

            let clientY;


            // Touch

            if (
                event.touches &&
                event.touches.length > 0
            ) {

                clientX =
                    event.touches[0].clientX;

                clientY =
                    event.touches[0].clientY;

            }


            // Touch end

            else if (
                event.changedTouches &&
                event.changedTouches.length > 0
            ) {

                clientX =
                    event.changedTouches[0].clientX;

                clientY =
                    event.changedTouches[0].clientY;

            }


            // Mouse

            else {

                clientX =
                    event.clientX;

                clientY =
                    event.clientY;

            }


            return {

                x: clientX - rect.left,

                y: clientY - rect.top

            };

        }


        // =================================================
        // START DRAWING
        // =================================================

        function startDrawing(event) {

            event.preventDefault();

            drawing = true;

            setSignatureStyle();


            const position =
                getPosition(event);


            lastX =
                position.x;

            lastY =
                position.y;


            // Small BLACK dot

            ctx.beginPath();

            ctx.arc(
                lastX,
                lastY,
                1.5,
                0,
                Math.PI * 2
            );


            ctx.fillStyle =
                "#000000";


            ctx.fill();


            ctx.beginPath();

            ctx.moveTo(
                lastX,
                lastY
            );

        }


        // =================================================
        // DRAW
        // =================================================

        function draw(event) {

            if (!drawing) {

                return;

            }


            event.preventDefault();

            setSignatureStyle();


            const position =
                getPosition(event);


            ctx.beginPath();


            ctx.moveTo(
                lastX,
                lastY
            );


            ctx.lineTo(
                position.x,
                position.y
            );


            ctx.stroke();


            lastX =
                position.x;

            lastY =
                position.y;


            hasSignature =
                true;


            // Update status

            status.textContent =
                "Signature captured";


            status.classList.add(
                "signed"
            );


            if (wrapper) {

                wrapper.classList.add(
                    "has-signature"
                );

            }

        }


        // =================================================
        // STOP DRAWING
        // =================================================

        function stopDrawing(event) {

            if (!drawing) {

                return;

            }


            if (event) {

                event.preventDefault();

            }


            drawing = false;


            if (hasSignature) {

                saveSignature();

            }

        }


        // =================================================
        // SAVE SIGNATURE
        // =================================================

        function saveSignature() {

            if (!hasSignature) {

                return;

            }


            const imageData =
                canvas.toDataURL(
                    "image/png"
                );


            hiddenInput.value =
                imageData;


            status.textContent =
                "Signed";


            status.classList.add(
                "signed"
            );

        }


        // =================================================
        // MOUSE
        // =================================================

        canvas.addEventListener(
            "mousedown",
            startDrawing
        );


        canvas.addEventListener(
            "mousemove",
            draw
        );


        canvas.addEventListener(
            "mouseup",
            stopDrawing
        );


        canvas.addEventListener(
            "mouseleave",
            stopDrawing
        );


        // =================================================
        // TOUCH
        // =================================================

        canvas.addEventListener(
            "touchstart",
            startDrawing,
            { passive: false }
        );


        canvas.addEventListener(
            "touchmove",
            draw,
            { passive: false }
        );


        canvas.addEventListener(
            "touchend",
            stopDrawing,
            { passive: false }
        );


        canvas.addEventListener(
            "touchcancel",
            stopDrawing,
            { passive: false }
        );


        // =================================================
        // CLEAR
        // =================================================

        function clear() {

            ctx.clearRect(
                0,
                0,
                canvas.width,
                canvas.height
            );


            setSignatureStyle();


            hiddenInput.value =
                "";


            hasSignature =
                false;


            drawing =
                false;


            status.textContent =
                "Not signed";


            status.classList.remove(
                "signed"
            );


            if (wrapper) {

                wrapper.classList.remove(
                    "has-signature"
                );

            }

        }


        // =================================================
        // RETURN PAD
        // =================================================

        return {

            canvas: canvas,

            context: ctx,

            hiddenInput: hiddenInput,

            status: status,

            clear: clear

        };

    }


    // =====================================================
    // CLEAR SIGNATURE
    // =====================================================

    function clearSignature(type) {

        if (
            type === "employee" &&
            employeeSignaturePad
        ) {

            employeeSignaturePad.clear();

        }


        if (
            type === "supervisor" &&
            supervisorSignaturePad
        ) {

            supervisorSignaturePad.clear();

        }

    }


    // =====================================================
    // KRA COUNT
    // =====================================================

    let kraCount = 4;


    // =====================================================
    // ADD KRA
    // =====================================================

    function addKra() {

        kraCount++;


        // =================================================
        // D1
        // =================================================

        const d1Body =
            document.getElementById(
                "d1KraBody"
            );


        const d1Row =
            document.createElement("tr");


        d1Row.className =
            "d1-kra-row";


        d1Row.setAttribute(
            "data-kra",
            kraCount
        );


        d1Row.innerHTML = `

            <td class="kra-number">
                ${kraCount}
            </td>

            <td>

                <input name="KRA${kraCount}Weight"
                       type="number"
                       class="form-control text-center weight-input"
                       placeholder="Weight"
                       min="0"
                       max="100"
                       step="1"
                       inputmode="numeric" />

            </td>

            <td>

                <input name="KRA${kraCount}Achievement"
                       class="form-control"
                       placeholder="Describe achievement..." />

            </td>

            <td>

                <input name="KRA${kraCount}Comment"
                       class="form-control"
                       placeholder="Supervisor comment..." />

            </td>

            <td class="text-center">

                <button type="button"
                        class="btn-remove-kra"
                        onclick="removeKra(${kraCount})">

                    <i class="bi bi-trash"></i>

                </button>

            </td>

        `;


        d1Body.appendChild(
            d1Row
        );


        // =================================================
        // D2
        // =================================================

        const d2Body =
            document.getElementById(
                "d2KraBody"
            );


        const d2Row =
            document.createElement("tr");


        d2Row.className =
            "d2-kra-row";


        d2Row.setAttribute(
            "data-kra",
            kraCount
        );


        d2Row.innerHTML = `

            <td class="kra-number">
                ${kraCount}
            </td>

            <td>

                <select name="KRA${kraCount}_OR"
                        class="form-control select-rating text-center">

                    <option value="">—</option>

                    <option value="1">
                        1 – Not Effective
                    </option>

                    <option value="2">
                        2 – Partially Effective
                    </option>

                    <option value="3">
                        3 – Fully Effective
                    </option>

                    <option value="4">
                        4 – Highly Effective
                    </option>

                </select>

            </td>

            <td>

                <select name="KRA${kraCount}_SR"
                        class="form-control select-rating text-center">

                    <option value="">—</option>

                    <option value="1">
                        1 – Not Effective
                    </option>

                    <option value="2">
                        2 – Partially Effective
                    </option>

                    <option value="3">
                        3 – Fully Effective
                    </option>

                    <option value="4">
                        4 – Highly Effective
                    </option>

                </select>

            </td>

            <td>

                <select name="KRA${kraCount}_AR"
                        class="form-control select-rating text-center"
                        style="border-color:#006838;background:#e8f5ee;">

                    <option value="">—</option>

                    <option value="1">
                        1 – Not Effective
                    </option>

                    <option value="2">
                        2 – Partially Effective
                    </option>

                    <option value="3">
                        3 – Fully Effective
                    </option>

                    <option value="4">
                        4 – Highly Effective
                    </option>

                </select>

            </td>

            <td class="text-center">

                <button type="button"
                        class="btn-remove-kra"
                        onclick="removeKra(${kraCount})">

                    <i class="bi bi-trash"></i>

                </button>

            </td>

        `;


        d2Body.appendChild(
            d2Row
        );


        updateKraCount();

    }


    // =====================================================
    // REMOVE KRA
    // =====================================================

    function removeKra(number) {

        const d1Rows =
            document.querySelectorAll(
                ".d1-kra-row"
            );


        if (d1Rows.length <= 4) {

            alert(
                "At least 4 KRAs are required."
            );

            return;

        }


        const d1Row =
            document.querySelector(
                `.d1-kra-row[data-kra="${number}"]`
            );


        const d2Row =
            document.querySelector(
                `.d2-kra-row[data-kra="${number}"]`
            );


        if (d1Row) {

            d1Row.remove();

        }


        if (d2Row) {

            d2Row.remove();

        }


        updateKraCount();

    }


    // =====================================================
    // UPDATE KRA COUNT
    // =====================================================

    function updateKraCount() {

        const d1Rows =
            document.querySelectorAll(
                ".d1-kra-row"
            );


        const d2Rows =
            document.querySelectorAll(
                ".d2-kra-row"
            );


        const d1Counter =
            document.getElementById(
                "d1KraCount"
            );


        const d2Counter =
            document.getElementById(
                "d2KraCount"
            );


        if (d1Counter) {

            d1Counter.textContent =
                d1Rows.length + " KRAs";

        }


        if (d2Counter) {

            d2Counter.textContent =
                d2Rows.length + " KRAs";

        }

    }


    // =====================================================
    // WEIGHT VALIDATION
    // =====================================================

    function initializeWeightValidation() {

        document.addEventListener(
            "input",
            function (event) {

                if (
                    event.target.classList.contains(
                        "weight-input"
                    )
                ) {

                    event.target.value =
                        event.target.value.replace(
                            /[^0-9]/g,
                            ""
                        );


                    if (
                        event.target.value !== "" &&
                        parseInt(
                            event.target.value
                        ) > 100
                    ) {

                        event.target.value =
                            "100";

                    }

                }

            }
        );

    }


    // =====================================================
    // FINAL PERFORMANCE CALCULATION
    // =====================================================

    function calculateFinalPercentage() {

        const midTermInput =
            document.getElementById(
                "midTermPercentage"
            );


        const annualInput =
            document.getElementById(
                "annualPercentage"
            );


        const finalPercentageElement =
            document.getElementById(
                "finalPercentage"
            );


        const categoryElement =
            document.getElementById(
                "finalCategory"
            );


        if (
            !midTermInput ||
            !annualInput ||
            !finalPercentageElement ||
            !categoryElement
        ) {

            return;

        }


        let midTerm =
            parseFloat(
                midTermInput.value
            ) || 0;


        let annual =
            parseFloat(
                annualInput.value
            ) || 0;


        if (midTerm > 100) {

            midTerm = 100;

            midTermInput.value = 100;

        }


        if (annual > 100) {

            annual = 100;

            annualInput.value = 100;

        }


        const finalPercentage =
            (midTerm + annual) / 2;


        finalPercentageElement.textContent =
            finalPercentage.toFixed(2) + "%";


        let category = "";


        if (finalPercentage < 50) {

            category =
                "1 – Not Effective";

        }
        else if (finalPercentage < 75) {

            category =
                "2 – Partially Effective";

        }
        else if (finalPercentage < 100) {

            category =
                "3 – Fully Effective";

        }
        else {

            category =
                "4 – Highly Effective";

        }


        categoryElement.textContent =
            category;

    }


    // =====================================================
    // FORM VALIDATION
    // =====================================================

    function initializeFormValidation() {

        const form =
            document.getElementById(
                "annualAssessmentForm"
            );


        if (!form) {

            return;

        }


        form.addEventListener(
            "submit",
            function (event) {


                // =========================================
                // EMPLOYEE SIGNATURE
                // =========================================

                if (
                    !employeeSignaturePad ||
                    !employeeSignaturePad.hiddenInput.value
                ) {

                    event.preventDefault();


                    alert(
                        "Please provide the Employee Signature."
                    );


                    const canvas =
                        document.getElementById(
                            "employeeSignatureCanvas"
                        );


                    if (canvas) {

                        canvas.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                    }


                    return;

                }


                // =========================================
                // SUPERVISOR SIGNATURE
                // =========================================

   

    if (
        !supervisorSignaturePad ||
        !supervisorSignaturePad.hiddenInput.value
    ) {

        event.preventDefault();

        alert(
            "Please provide the Supervisor Signature."
        );

        const canvas =
            document.getElementById(
                "supervisorSignatureCanvas"
            );

        if (canvas) {

            canvas.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

        }

        return;
    }


                // =========================================
                // NORMAL REQUIRED FIELDS
                // =========================================

                const requiredFields =
                    form.querySelectorAll(
                        "[required]"
                    );


                let isValid =
                    true;


                requiredFields.forEach(
                    function (field) {

                        if (
                            !field.value ||
                            !field.value.trim()
                        ) {

                            field.classList.add(
                                "is-invalid"
                            );

                            isValid =
                                false;

                        }
                        else {

                            field.classList.remove(
                                "is-invalid"
                            );

                        }

                    }
                );


                if (!isValid) {

                    event.preventDefault();


                    const firstError =
                        form.querySelector(
                            ".is-invalid"
                        );


                    if (firstError) {

                        firstError.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });


                        firstError.focus();

                    }


                    alert(
                        "Please fill in all required fields."
                    );


                    return;

                }


                // =========================================
                // SAVE BUTTON
                // =========================================

                const saveButton =
                    document.getElementById(
                        "saveAssessmentButton"
                    );


                if (saveButton) {

                    saveButton.disabled =
                        true;


                    saveButton.innerHTML =
                        '<i class="bi bi-hourglass-split"></i> Saving...';

                }

            }
        );


        // Remove invalid state

        form.querySelectorAll(
            ".form-control"
        ).forEach(
            function (field) {

                field.addEventListener(
                    "input",
                    function () {

                        this.classList.remove(
                            "is-invalid"
                        );

                    }
                );

                field.addEventListener(
                    "change",
                    function () {

                        this.classList.remove(
                            "is-invalid"
                        );

                    }
                );

            }
        );

    }


    // =====================================================
    // SAVE BUTTON INITIALIZATION
    // =====================================================

    function initializeSaveButton() {

        const button =
            document.getElementById(
                "saveAssessmentButton"
            );


        if (!button) {

            return;

        }


        button.addEventListener(
            "click",
            function () {

                /*
                 * Do not disable the button here.
                 *
                 * The form submit handler will first
                 * validate the signatures and then disable
                 * the button.
                 */

            }
        );

    }

</script>