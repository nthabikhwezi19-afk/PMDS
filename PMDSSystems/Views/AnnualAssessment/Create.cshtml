@model PMDSSystems.Models.AnnualAssessment

@{
    ViewData["Title"] = "Create";
}

<style>
    /* ==========================================
   PERSAL NUMBER LABEL
   ========================================== */

.personal-field {
    margin-bottom: 22px;
}

.form-label-custom {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    color: #006838;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

/* Green icon box */
.label-icon {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #006838, #004d28);
    color: white;
    border-radius: 7px;
    box-shadow: 0 3px 8px rgba(0, 104, 56, 0.20);
}

.label-icon i {
    font-size: 15px;
}

/* Label text */
.label-text {
    position: relative;
}

/* Small green line underneath label */
.label-text::after {
    content: "";
    display: block;
    width: 35px;
    height: 2px;
    background: #006838;
    margin-top: 4px;
    border-radius: 2px;
}

/* Persal input */
.personal-field .form-control {
    border: 2px solid #dce3e8;
    border-left: 4px solid #006838;
    background: #f8faf9;
    font-weight: 600;
    color: #333;
    height: 44px;
    border-radius: 6px;
    padding: 10px 14px;
}

.personal-field .form-control:focus {
    border-color: #006838;
    border-left: 4px solid #006838;
    box-shadow: 0 0 0 0.15rem rgba(0, 104, 56, 0.12);
    outline: none;
}
    /* ===== GLOBAL STYLES ===== */
    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    /* ========================================== */
    /* PAGE HEADER                               */
    /* ========================================== */
    .page-header {
        background: linear-gradient(135deg, #006838 0%, #004d28 100%);
        color: white;
        padding: 25px 30px;
        border-radius: 12px;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,104,56,0.25);
    }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(to right, #a8e6cf, #006838, #a8e6cf);
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(168,230,207,0.08) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .page-header h3 {
            font-weight: 700;
            letter-spacing: 1px;
            margin: 0;
            font-size: 24px;
            position: relative;
            z-index: 1;
        }

            .page-header h3 i {
                margin-right: 12px;
                color: #a8e6cf;
            }

        .page-header .sub-text {
            color: rgba(255,255,255,0.8);
            font-weight: 300;
            margin-top: 6px;
            font-size: 14px;
            position: relative;
            z-index: 1;
        }

    /* ========================================== */
    /* ALERT STYLES                              */
    /* ========================================== */
    .alert-success {
        background: linear-gradient(135deg, #e8f5ee 0%, #d4ebe3 100%);
        border: none;
        border-left: 5px solid #006838;
        border-radius: 10px;
        padding: 14px 20px;
        box-shadow: 0 2px 10px rgba(0,104,56,0.1);
        color: #004d28;
        font-weight: 500;
    }

        .alert-success .btn-close {
            color: #006838;
            filter: brightness(0.8);
        }

            .alert-success .btn-close:hover {
                color: #004d28;
                filter: brightness(0.6);
            }

    /* ========================================== */
    /* FORM CONTAINER                            */
    /* ========================================== */
    .form-container {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 25px rgba(0,0,0,0.06);
        border-top: 5px solid #006838;
        position: relative;
        overflow: hidden;
    }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(0,104,56,0.03) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

    /* ========================================== */
    /* SECTION HEADERS                           */
    /* ========================================== */
    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 25px 0 15px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #006838;
        position: relative;
    }

        .section-header::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 60px;
            height: 2px;
            background: linear-gradient(to right, #006838, transparent);
        }

        .section-header h5 {
            color: #006838;
            font-weight: 700;
            margin: 0;
            font-size: 17px;
            letter-spacing: 0.5px;
        }

        .section-header i {
            color: #006838;
            font-size: 20px;
            width: 24px;
            text-align: center;
        }

        .section-header .badge-section {
            margin-left: auto;
            background: #e8f5ee;
            color: #006838;
            padding: 2px 14px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 600;
        }

    /* ========================================== */
    /* FORM CONTROLS                             */
    /* ========================================== */
    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
            display: block;
            font-size: 14px;
        }

            .form-group label .required {
                color: #dc3545;
                margin-left: 3px;
            }

    .form-control {
        border-radius: 6px;
        border: 2px solid #dce3e8;
        padding: 8px 12px;
        transition: all 0.3s ease;
        font-size: 14px;
        width: 100%;
        background: white;
        color: #333;
    }

        .form-control:focus {
            border-color: #006838;
            box-shadow: 0 0 0 0.2rem rgba(0, 104, 56, 0.15);
            outline: none;
            background: white;
        }

        .form-control::placeholder {
            color: #b0b8c0;
            font-size: 13px;
        }

        .form-control.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid:focus {
                border-color: #dc3545;
                box-shadow: 0 0 0 0.2rem rgba(220,53,69,0.15);
            }

    select.form-control {
        appearance: auto;
        cursor: pointer;
    }

        select.form-control option {
            padding: 8px;
        }

    /* ========================================== */
    /* TABLE STYLES                              */
    /* ========================================== */
    .table-responsive {
        overflow-x: auto;
        margin: 15px 0;
        border-radius: 8px;
        border: 1px solid #e8edf0;
    }

    .table {
        margin: 0;
        border-collapse: collapse;
        width: 100%;
        font-size: 14px;
    }

        .table thead th {
            background: linear-gradient(135deg, #006838 0%, #004d28 100%);
            color: white;
            text-align: center;
            vertical-align: middle;
            font-size: 12px;
            padding: 12px 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 1px solid #006838;
            white-space: nowrap;
        }

        .table tbody td {
            vertical-align: middle;
            padding: 8px 6px;
            border: 1px solid #dee2e6;
            background: white;
        }

        .table tbody tr:hover {
            background-color: #f8faf9;
        }

            .table tbody tr:hover td {
                background-color: #f8faf9;
            }

        .table .kra-number {
            font-weight: 700;
            color: #006838;
            text-align: center;
            font-size: 16px;
            width: 50px;
        }

        .table .form-control {
            font-size: 13px;
            padding: 6px 10px;
            border-radius: 4px;
            border: 2px solid #dce3e8;
        }

            .table .form-control:focus {
                border-color: #006838;
                box-shadow: 0 0 0 0.15rem rgba(0,104,56,0.12);
            }

        .table .form-control-sm {
            font-size: 12px;
            padding: 4px 8px;
        }

        .table .select-rating {
            min-width: 80px;
        }

    /* ========================================== */
    /* DISPUTE SECTION                           */
    /* ========================================== */
    .dispute-section {
        background: #f8faf9;
        border-radius: 8px;
        padding: 18px 20px;
        border-left: 4px solid #006838;
        margin: 20px 0;
    }

        .dispute-section .form-control {
            border-color: #006838;
        }

            .dispute-section .form-control:focus {
                border-color: #006838;
                box-shadow: 0 0 0 0.15rem rgba(0,104,56,0.12);
            }

    /* ========================================== */
    /* SIGNATURE SECTION                         */
    /* ========================================== */
    .signature-section {
        background: #f8faf9;
        border-radius: 8px;
        padding: 18px 20px;
        border-left: 4px solid #006838;
        margin: 20px 0;
    }

    /* ========================================== */
    /* SAVE BUTTON - Premium Style               */
    /* ========================================== */
    .btn-success {
        background: linear-gradient(135deg, #006838 0%, #004d28 100%);
        color: white;
        padding: 13px 45px;
        font-weight: 700;
        font-size: 15px;
        border-radius: 50px;
        border: none;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(0, 104, 56, 0.35);
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
    }

        .btn-success::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.6s ease;
        }

        .btn-success::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn-success:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 35px rgba(0, 104, 56, 0.5);
            background: linear-gradient(135deg, #004d28 0%, #003d1f 100%);
            color: white;
        }

            .btn-success:hover::before {
                left: 100%;
            }

            .btn-success:hover::after {
                width: 300px;
                height: 300px;
            }

        .btn-success:active {
            transform: translateY(0px);
            box-shadow: 0 2px 15px rgba(0, 104, 56, 0.3);
        }

        .btn-success i {
            font-size: 16px;
            transition: transform 0.3s ease;
        }

        .btn-success:hover i {
            transform: scale(1.1);
        }

        .btn-success:disabled {
            background: #8cb3a0;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: none !important;
        }

        .btn-success.loading {
            background: #004d28;
            pointer-events: none;
        }

            .btn-success.loading i {
                animation: spin 1s linear infinite;
            }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* ========================================== */
    /* RESPONSIVE                                */
    /* ========================================== */
    @@media (max-width: 992px) {
        .container {
            padding: 15px;
        }

        .form-container {
            padding: 20px;
        }

        .page-header h3 {
            font-size: 20px;
        }

        .section-header h5 {
            font-size: 15px;
        }

        .table thead th {
            font-size: 11px;
            padding: 10px 6px;
        }

        .table tbody td {
            padding: 6px 4px;
        }
    }

    @@media (max-width: 768px) {
        .container {
            padding: 10px;
        }

        .page-header {
            padding: 18px 20px;
        }

            .page-header h3 {
                font-size: 17px;
            }

            .page-header .sub-text {
                font-size: 13px;
            }

        .form-container {
            padding: 15px;
        }

        .section-header {
            margin: 18px 0 12px 0;
            padding-bottom: 8px;
        }

            .section-header h5 {
                font-size: 14px;
            }

            .section-header i {
                font-size: 17px;
                width: 20px;
            }

            .section-header .badge-section {
                font-size: 10px;
                padding: 2px 10px;
            }

        .form-group label {
            font-size: 13px;
        }

        .form-control {
            font-size: 13px;
            padding: 6px 10px;
        }

        .table thead th {
            font-size: 9px;
            padding: 6px 4px;
            letter-spacing: 0px;
        }

        .table tbody td {
            padding: 4px 3px;
        }

        .table .form-control {
            font-size: 11px;
            padding: 4px 6px;
        }

        .table .kra-number {
            font-size: 13px;
            width: 35px;
        }

        .btn-success {
            padding: 10px 25px;
            font-size: 13px;
            width: 100%;
            justify-content: center;
        }

            .btn-success i {
                font-size: 14px;
            }

        .dispute-section,
        .signature-section {
            padding: 14px 16px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-container::before {
            display: none;
        }

        .page-header::before {
            display: none;
        }
    }

    @@media (max-width: 576px) {
        .container {
            padding: 6px;
        }

        .page-header h3 {
            font-size: 15px;
        }

        .page-header .sub-text {
            font-size: 12px;
        }

        .form-container {
            padding: 12px;
        }

        .section-header h5 {
            font-size: 13px;
        }

        .section-header i {
            font-size: 15px;
        }

        .table thead th {
            font-size: 8px;
            padding: 4px 3px;
        }

        .table tbody td {
            padding: 3px 2px;
        }

        .table .form-control {
            font-size: 10px;
            padding: 3px 4px;
            border-radius: 3px;
        }

        .table .kra-number {
            font-size: 11px;
            width: 30px;
        }

        .btn-success {
            padding: 8px 18px;
            font-size: 12px;
            letter-spacing: 1px;
        }

        .dispute-section,
        .signature-section {
            padding: 10px 12px;
        }

        .form-group {
            margin-bottom: 10px;
        }

        .form-control {
            font-size: 12px;
            padding: 5px 8px;
        }

        .form-group label {
            font-size: 12px;
        }
    }

    /* ========================================== */
    /* PRINT STYLES                              */
    /* ========================================== */
    @@media print {
        .btn-success {
            display: none !important;
        }

        .form-container {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        .page-header {
            background: #006838 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

            .page-header::after,
            .page-header::before {
                display: none !important;
            }

        .table thead th {
            background: #006838 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .section-header {
            border-bottom-color: #006838 !important;
        }

            .section-header::after {
                display: none;
            }

        .form-control {
            border: 1px solid #ddd !important;
        }

        .dispute-section,
        .signature-section {
            border-left: 1px solid #ddd !important;
            background: #f8f9fa !important;
        }

        .table tbody tr:hover {
            background: transparent !important;
        }

            .table tbody tr:hover td {
                background: transparent !important;
            }
    }

    /* ========================================== */
    /* ANIMATIONS                                */
    /* ========================================== */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-container {
        animation: fadeInUp 0.5s ease;
    }

    .page-header {
        animation: fadeInUp 0.4s ease;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.02);
        }

        100% {
            transform: scale(1);
        }
    }

    .btn-success {
        animation: pulse 2s infinite;
    }

        .btn-success:hover {
            animation: none;
        }

    /* ========================================== */
    /* UTILITY CLASSES                           */
    /* ========================================== */
    .mt-2 {
        margin-top: 10px;
    }

    .mt-3 {
        margin-top: 15px;
    }

    .mt-4 {
        margin-top: 20px;
    }

    .mb-2 {
        margin-bottom: 10px;
    }

    .mb-3 {
        margin-bottom: 15px;
    }

    .mb-4 {
        margin-bottom: 20px;
    }

    .fw-bold {
        font-weight: 700;
    }

    .text-center {
        text-align: center;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .border-top {
        border-top: 1px solid #dee2e6 !important;
    }

    .fs-7 {
        font-size: 0.85rem;
    }

    /* ==========================================
       ADD KRA BUTTONS
       ========================================== */

    .add-kra-container {
        display: flex;
        justify-content: center;
        margin: 15px 0 25px 0;
    }

    .btn-add-kra {
        background: linear-gradient(135deg, #006838 0%, #004d28 100%);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 10px 28px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0, 104, 56, 0.25);
        transition: all 0.3s ease;
    }

        .btn-add-kra:hover {
            background: linear-gradient(135deg, #004d28 0%, #003d1f 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0, 104, 56, 0.35);
            color: white;
        }

        .btn-add-kra i {
            font-size: 16px;
        }

    .btn-remove-kra {
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 5px 9px;
        cursor: pointer;
        font-size: 12px;
    }

        .btn-remove-kra:hover {
            background: #bb2d3b;
        }
</style>

<div class="container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <h3>
            <i class="bi bi-file-check"></i>
            PART D1 & D2: Annual Assessment
        </h3>
        <div class="sub-text">
            <i class="bi bi-calendar3 me-2"></i>
            Performance Cycle: 1 April 2024 – 31 March 2025
        </div>
    </div>

    <div class="form-container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2" style="color: #006838; font-size: 18px;"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <!-- Persal Number -->
            <div class="personal-field">
                <label for="PersalNumber" class="form-label-custom">
                    <span class="label-icon">
                        <i class="bi bi-person-vcard-fill"></i>
                    </span>
                    <span class="label-text">PERSAL NUMBER</span>
                </label>

                <input type="text"
                       id="PersalNumber"
                       name="PersalNumber"
                       value="@(Model?.PersalNumber ?? "")"
                       class="form-control"
                       readonly />
            </div>
            <!-- ========================= -->
            <!-- PART D1 -->
            <!-- ========================= -->

            <div class="section-header">
                <i class="bi bi-list-task"></i>
                <h5>Part D1: Motivation for KRA's</h5>
                <span class="badge-section" id="d1KraCount">4 KRAs</span>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 8%;">#</th>
                            <th style="width: 12%;">Weight</th>
                            <th style="width: 40%;">Achievement</th>
                            <th style="width: 35%;">Comment</th>
                            <th style="width: 5%;">Action</th>
                        </tr>
                    </thead>

                    <tbody id="d1KraBody">

                        <!-- KRA 1 -->
                        <tr class="d1-kra-row" data-kra="1">
                            <td class="kra-number">1</td>

                            <td>
                                <input name="KRA1Weight"
                                       class="form-control text-center"
                                       placeholder="%" />
                            </td>

                            <td>
                                <input name="KRA1Achievement"
                                       class="form-control"
                                       placeholder="Describe achievement..." />
                            </td>

                            <td>
                                <input name="KRA1Comment"
                                       class="form-control"
                                       placeholder="Supervisor comment..." />
                            </td>

                            <td class="text-center">
                                <button type="button"
                                        class="btn-remove-kra"
                                        onclick="removeKra(1)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- KRA 2 -->
                        <tr class="d1-kra-row" data-kra="2">
                            <td class="kra-number">2</td>

                            <td>
                                <input name="KRA2Weight"
                                       class="form-control text-center"
                                       placeholder="%" />
                            </td>

                            <td>
                                <input name="KRA2Achievement"
                                       class="form-control"
                                       placeholder="Describe achievement..." />
                            </td>

                            <td>
                                <input name="KRA2Comment"
                                       class="form-control"
                                       placeholder="Supervisor comment..." />
                            </td>

                            <td class="text-center">
                                <button type="button"
                                        class="btn-remove-kra"
                                        onclick="removeKra(2)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>

                        <!-- KRA 3 -->
