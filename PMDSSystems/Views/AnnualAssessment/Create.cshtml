<!-- ==========================================
     PAGE SCRIPTS
     ========================================== -->

<script>

    /* =====================================================
       GLOBAL SIGNATURE PAD VARIABLES
       ===================================================== */

    let employeeSignaturePad = null;
    let supervisorSignaturePad = null;
    let higherLineManagerSignaturePad = null;


    /* =====================================================
       PAGE INITIALIZATION
       ===================================================== */

    document.addEventListener("DOMContentLoaded", function () {

        initializeDisputeSection();
        initializeSignaturePads();
        initializeWeightValidation();
        initializeFormValidation();
        initializeSaveButton();

        updateKraCount();
    });


    /* =====================================================
       DISPUTE SHOW / HIDE
       ===================================================== */

    function initializeDisputeSection() {

        const disputeSelect = document.getElementById("HasDispute");
        const disputeDetails = document.getElementById("disputeDetails");
        const disputeKra = document.getElementById("DisputeKRA");

        if (!disputeSelect || !disputeDetails) return;

        function updateDisputeVisibility() {

            const hasDispute = disputeSelect.value === "true";

            if (hasDispute) {

                disputeDetails.style.display = "block";

                if (disputeKra) disputeKra.disabled = false;

            } else {

                disputeDetails.style.display = "none";

                if (disputeKra) {
                    disputeKra.value = "";
                    disputeKra.disabled = true;
                }

                const decision = document.getElementById("HigherLineManagerDecision");
                const surname = document.getElementById("HigherLineManagerSurnameInitials");
                const date = document.getElementById("HigherLineManagerDate");

                if (decision) decision.value = "";
                if (surname) surname.value = "";
                if (date) date.value = "";

                if (higherLineManagerSignaturePad) {
                    higherLineManagerSignaturePad.clear();
                }
            }
        }

        disputeSelect.addEventListener("change", updateDisputeVisibility);
        updateDisputeVisibility();
    }


    /* =====================================================
       INITIALIZE ALL SIGNATURE PADS
       ===================================================== */

    function initializeSignaturePads() {

        employeeSignaturePad = createSignaturePad(
            "employeeSignatureCanvas",
            "EmployeeSignature",
            "employeeSignatureStatus",
            "employeeSignatureWrapper"
        );

        supervisorSignaturePad = createSignaturePad(
            "supervisorSignatureCanvas",
            "SupervisorSignature",
            "supervisorSignatureStatus",
            "supervisorSignatureWrapper"
        );

        higherLineManagerSignaturePad = createSignaturePad(
            "higherLineManagerSignatureCanvas",
            "HigherLineManagerSignature",
            "higherLineManagerSignatureStatus",
            "higherLineManagerSignatureWrapper"
        );
    }


    /* =====================================================
       CREATE SIGNATURE PAD
       ===================================================== */

    function createSignaturePad(canvasId, hiddenInputId, statusId, wrapperId) {

        const canvas = document.getElementById(canvasId);
        const hiddenInput = document.getElementById(hiddenInputId);
        const status = document.getElementById(statusId);
        const wrapper = document.getElementById(wrapperId);

        if (!canvas || !hiddenInput || !status) {
            console.error("Signature elements missing:", canvasId, hiddenInputId, statusId);
            return null;
        }

        const ctx = canvas.getContext("2d");

        let drawing = false;
        let hasSignature = false;
        let lastX = 0;
        let lastY = 0;

        function setSignatureStyle() {
            ctx.strokeStyle = "#000000";
            ctx.fillStyle = "#000000";
            ctx.lineWidth = 2.5;
            ctx.lineCap = "round";
            ctx.lineJoin = "round";
        }

        function resizeCanvas() {

            const rect = canvas.getBoundingClientRect();

            if (rect.width === 0 || rect.height === 0) return;

            const savedSignature = hiddenInput.value;

            canvas.width = Math.floor(rect.width);
            canvas.height = Math.floor(rect.height);

            setSignatureStyle();

            if (savedSignature) {

                const image = new Image();

                image.onload = function () {
                    ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
                    hasSignature = true;
                    status.textContent = "Signed";
                    status.classList.add("signed");
                    if (wrapper) wrapper.classList.add("has-signature");
                };

                image.src = savedSignature;
            }
        }

        function getPosition(event) {

            const rect = canvas.getBoundingClientRect();
            let clientX, clientY;

            if (event.touches && event.touches.length > 0) {
                clientX = event.touches[0].clientX;
                clientY = event.touches[0].clientY;
            }
            else if (event.changedTouches && event.changedTouches.length > 0) {
                clientX = event.changedTouches[0].clientX;
                clientY = event.changedTouches[0].clientY;
            }
            else {
                clientX = event.clientX;
                clientY = event.clientY;
            }

            return {
                x: clientX - rect.left,
                y: clientY - rect.top
            };
        }

        function startDrawing(event) {

            event.preventDefault();
            drawing = true;
            setSignatureStyle();

            const position = getPosition(event);

            lastX = position.x;
            lastY = position.y;

            ctx.beginPath();
            ctx.arc(lastX, lastY, 1.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
        }

        function draw(event) {

            if (!drawing) return;

            event.preventDefault();
            setSignatureStyle();

            const position = getPosition(event);

            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(position.x, position.y);
            ctx.stroke();

            lastX = position.x;
            lastY = position.y;

            hasSignature = true;
            status.textContent = "Signature captured";
            status.classList.add("signed");
            if (wrapper) wrapper.classList.add("has-signature");
        }

        function stopDrawing(event) {

            if (!drawing) return;
            if (event) event.preventDefault();
            drawing = false;
            if (hasSignature) saveSignature();
        }

        function saveSignature() {
            if (!hasSignature) return;
            hiddenInput.value = canvas.toDataURL("image/png");
            status.textContent = "Signed";
            status.classList.add("signed");
        }

        canvas.addEventListener("mousedown", startDrawing);
        canvas.addEventListener("mousemove", draw);
        canvas.addEventListener("mouseup", stopDrawing);
        canvas.addEventListener("mouseleave", stopDrawing);

        canvas.addEventListener("touchstart", startDrawing, { passive: false });
        canvas.addEventListener("touchmove", draw, { passive: false });
        canvas.addEventListener("touchend", stopDrawing, { passive: false });
        canvas.addEventListener("touchcancel", stopDrawing, { passive: false });

        function clear() {

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            setSignatureStyle();

            hiddenInput.value = "";
            hasSignature = false;
            drawing = false;

            status.textContent = "Not signed";
            status.classList.remove("signed");

            if (wrapper) wrapper.classList.remove("has-signature");
        }

        resizeCanvas();
        window.addEventListener("resize", resizeCanvas);

        return {
            canvas: canvas,
            context: ctx,
            hiddenInput: hiddenInput,
            status: status,
            clear: clear
        };
    }


    /* =====================================================
       CLEAR SIGNATURE
       ===================================================== */

    function clearSignature(type) {

        if (type === "employee" && employeeSignaturePad) {
            employeeSignaturePad.clear();
        }

        if (type === "supervisor" && supervisorSignaturePad) {
            supervisorSignaturePad.clear();
        }

        if (type === "higherManager" && higherLineManagerSignaturePad) {
            higherLineManagerSignaturePad.clear();
        }
    }


    /* =====================================================
       KRA COUNT
       ===================================================== */

    let kraCount = 4;


    /* =====================================================
       ADD KRA
       ===================================================== */

    function addKra() {

        kraCount++;

        // ---------- D1 ----------

        const d1Body = document.getElementById("d1KraBody");

        const d1Row = document.createElement("tr");
        d1Row.className = "d1-kra-row";
        d1Row.setAttribute("data-kra", kraCount);

        d1Row.innerHTML = `
            <td class="kra-number">${kraCount}</td>

            <td>
                <input name="KRA${kraCount}Weight"
                       type="number"
                       class="form-control text-center weight-input"
                       placeholder="Weight"
                       min="0" max="100" step="1"
                       inputmode="numeric" />
            </td>

            <td>
                <input name="KRA${kraCount}Achievement"
                       class="form-control"
                       placeholder="Describe achievement..." />
            </td>

            <td>
                <input name="KRA${kraCount}Comment"
                       class="form-control"
                       placeholder="Supervisor comment..." />
            </td>

            <td class="text-center">
                <button type="button"
                        class="btn-remove-kra"
                        onclick="removeKra(${kraCount})">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

        d1Body.appendChild(d1Row);

        // ---------- D2 ----------

        const d2Body = document.getElementById("d2KraBody");

        const d2Row = document.createElement("tr");
        d2Row.className = "d2-kra-row";
        d2Row.setAttribute("data-kra", kraCount);

        d2Row.innerHTML = `
            <td class="kra-number text-center align-middle">${kraCount}</td>

            <td class="align-middle">
                <div class="input-group">
                    <input type="number"
                           name="KRA${kraCount}_Weight"
                           class="form-control kra-weight text-center"
                           min="10" max="30" step="1"
                           placeholder="0">
                    <span class="input-group-text">%</span>
                </div>
            </td>

            <td>
                <select name="KRA${kraCount}_OR"
                        class="form-control select-rating text-center">
                    <option value="">—</option>
                    <option value="1">1 – Not Effective</option>
                    <option value="2">2 – Partially Effective</option>
                    <option value="3">3 – Fully Effective</option>
                    <option value="4">4 – Highly Effective</option>
                </select>
            </td>

            <td>
                <select name="KRA${kraCount}_SR"
                        class="form-control select-rating text-center">
                    <option value="">—</option>
                    <option value="1">1 – Not Effective</option>
                    <option value="2">2 – Partially Effective</option>
                    <option value="3">3 – Fully Effective</option>
                    <option value="4">4 – Highly Effective</option>
                </select>
            </td>

            <td>
                <select name="KRA${kraCount}_AR"
                        class="form-control select-rating text-center"
                        style="border-color:#006838;background:#e8f5ee;">
                    <option value="">—</option>
                    <option value="1">1 – Not Effective</option>
                    <option value="2">2 – Partially Effective</option>
                    <option value="3">3 – Fully Effective</option>
                    <option value="4">4 – Highly Effective</option>
                </select>
            </td>

            <td class="text-center align-middle">
                <button type="button"
                        class="btn-remove-kra"
                        onclick="removeKra(${kraCount})">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

        d2Body.appendChild(d2Row);

        updateKraCount();
    }

  
    /* =====================================================
       REMOVE KRA
       ===================================================== */

    function removeKra(number) {

        const d1Rows = document.querySelectorAll(".d1-kra-row");

        if (d1Rows.length <= 4) {
            alert("At least 4 KRAs are required.");
            return;
        }

        const d1Row = document.querySelector(`.d1-kra-row[data-kra="${number}"]`);
        const d2Row = document.querySelector(`.d2-kra-row[data-kra="${number}"]`);

        if (d1Row) d1Row.remove();
        if (d2Row) d2Row.remove();

        updateKraCount();
    }


    /* =====================================================
       UPDATE KRA COUNT
       ===================================================== */

    function updateKraCount() {

        const d1Rows = document.querySelectorAll("#d1KraBody tr");
        const d2Rows = document.querySelectorAll("#d2KraBody tr");

        const d1Counter = document.getElementById("d1KraCount");
        const d2Counter = document.getElementById("d2KraCount");

        if (d1Counter) {
            d1Counter.textContent = d1Rows.length + " KRAs";
        }

        if (d2Counter) {
            d2Counter.textContent = d2Rows.length + " KRAs";
        }
    }


    /* =====================================================
       WEIGHT VALIDATION
       ===================================================== */

    function initializeWeightValidation() {

        document.addEventListener("input", function (event) {

            if (event.target.classList.contains("weight-input")) {

                event.target.value = event.target.value.replace(/[^0-9]/g, "");

                if (event.target.value !== "" && parseInt(event.target.value) > 100) {
                    event.target.value = "100";
                }
            }
        });
    }


    /* =====================================================
       FINAL PERFORMANCE CALCULATION
       ===================================================== */

    function calculateFinalPercentage() {

        const midTermInput = document.getElementById("midTermPercentage");
        const annualInput = document.getElementById("annualPercentage");
        const finalPercentageElement = document.getElementById("finalPercentage");
        const categoryElement = document.getElementById("finalCategory");

        if (!midTermInput || !annualInput || !finalPercentageElement || !categoryElement) {
            return;
        }

        let midTerm = parseFloat(midTermInput.value) || 0;
        let annual = parseFloat(annualInput.value) || 0;

        if (midTerm > 100) { midTerm = 100; midTermInput.value = 100; }
        if (annual > 100) { annual = 100; annualInput.value = 100; }

        const finalPercentage = (midTerm + annual) / 2;

        finalPercentageElement.textContent = finalPercentage.toFixed(2) + "%";

        let category = "";

        if (finalPercentage < 50) {
            category = "1 – Not Effective";
        }
        else if (finalPercentage < 75) {
            category = "2 – Partially Effective";
        }
        else if (finalPercentage < 100) {
            category = "3 – Fully Effective";
        }
        else {
            category = "4 – Highly Effective";
        }

        categoryElement.textContent = category;
    }


    /* =====================================================
       FORM VALIDATION
       ===================================================== */

    function initializeFormValidation() {

        const form = document.getElementById("annualAssessmentForm");
        if (!form) return;

        form.addEventListener("submit", function (event) {

            // Employee signature
            if (!employeeSignaturePad || !employeeSignaturePad.hiddenInput.value) {

                event.preventDefault();
                alert("Please provide the Employee Signature.");

                const canvas = document.getElementById("employeeSignatureCanvas");
                if (canvas) canvas.scrollIntoView({ behavior: "smooth", block: "center" });

                return;
            }

            // Supervisor signature
            if (!supervisorSignaturePad || !supervisorSignaturePad.hiddenInput.value) {

                event.preventDefault();
                alert("Please provide the Supervisor Signature.");

                const canvas = document.getElementById("supervisorSignatureCanvas");
                if (canvas) canvas.scrollIntoView({ behavior: "smooth", block: "center" });

                return;
            }

            // Required fields
            const requiredFields = form.querySelectorAll("[required]");
            let isValid = true;

            requiredFields.forEach(function (field) {

                if (!field.value || !field.value.trim()) {
                    field.classList.add("is-invalid");
                    isValid = false;
                }
                else {
                    field.classList.remove("is-invalid");
                }
            });

            if (!isValid) {

                event.preventDefault();

                const firstError = form.querySelector(".is-invalid");
                if (firstError) {
                    firstError.scrollIntoView({ behavior: "smooth", block: "center" });
                    firstError.focus();
                }

                alert("Please fill in all required fields.");
                return;
            }

            // Save button
            const saveButton = document.getElementById("saveAssessmentButton");
            if (saveButton) {
                saveButton.disabled = true;
                saveButton.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
            }
        });

        form.querySelectorAll(".form-control").forEach(function (field) {
            field.addEventListener("input", function () {
                this.classList.remove("is-invalid");
            });
            field.addEventListener("change", function () {
                this.classList.remove("is-invalid");
            });
        });
    }


    /* =====================================================
       SAVE BUTTON
       ===================================================== */

    function initializeSaveButton() {

        const button = document.getElementById("saveAssessmentButton");
        if (!button) return;

        button.addEventListener("click", function () {
            // Validation runs in form submit handler.
        });
    }

</script>