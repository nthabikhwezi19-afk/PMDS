<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Auto-resize textareas (if any)
        document.querySelectorAll('textarea').forEach(textarea => {
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = this.scrollHeight + 'px';
            });
        });

        // Form validation feedback
        document.querySelector('form').addEventListener('submit', function(e) {
            const requiredFields = this.querySelectorAll('[required]');
            let isValid = true;

            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    field.classList.add('is-invalid');
                    isValid = false;
                } else {
                    field.classList.remove('is-invalid');
                }
            });

            if (!isValid) {
                e.preventDefault();
                // Scroll to first error
                const firstError = document.querySelector('.is-invalid');
                if (firstError) {
                    firstError.focus();
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                alert('Please fill in all required fields.');
            }
        });

        // Remove invalid class on input
        document.querySelectorAll('.form-control').forEach(field => {
            field.addEventListener('input', function() {
                this.classList.remove('is-invalid');
            });
        });

        // Button loading state
        document.querySelector('.btn-success')?.addEventListener('click', function(e) {
            this.classList.add('loading');
            this.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
            this.disabled = true;
        });
    });
        // ==========================================
    // D1 & D2 KRA MANAGEMENT
    // ==========================================

    let kraCount = 4;

    // Add a new KRA to BOTH D1 and D2
    function addKra() {

        kraCount++;

        // ==============================
        // ADD KRA TO D1
        // ==============================

        const d1Body = document.getElementById("d1KraBody");

        const d1Row = document.createElement("tr");

        d1Row.className = "d1-kra-row";
        d1Row.setAttribute("data-kra", kraCount);

        d1Row.innerHTML = `
            <td class="kra-number">${kraCount}</td>

            <td>
                <input name="KRA${kraCount}Weight"
                       class="form-control text-center"
                       placeholder="%" />
            </td>

            <td>
                <input name="KRA${kraCount}Achievement"
                       class="form-control"
                       placeholder="Describe achievement..." />
            </td>

            <td>
                <input name="KRA${kraCount}Comment"
                       class="form-control"
                       placeholder="Supervisor comment..." />
            </td>

            <td class="text-center">
                <button type="button"
                        class="btn-remove-kra"
                        onclick="removeKra(${kraCount})">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

        d1Body.appendChild(d1Row);


        // ==============================
        // ADD KRA TO D2
        // ==============================

        const d2Body = document.getElementById("d2KraBody");

        const d2Row = document.createElement("tr");

        d2Row.className = "d2-kra-row";
        d2Row.setAttribute("data-kra", kraCount);

        d2Row.innerHTML = `
            <td class="kra-number">${kraCount}</td>

            <td>
                <select name="KRA${kraCount}_OR"
                        class="form-control select-rating text-center">

                    <option value="">—</option>
                    <option value="1">1 – Not Effective</option>
                    <option value="2">2 – Partially Effective</option>
                    <option value="3">3 – Fully Effective</option>
                    <option value="4">4 – Highly Effective</option>

                </select>
            </td>

            <td>
                <select name="KRA${kraCount}_SR"
                        class="form-control select-rating text-center">

                    <option value="">—</option>
                    <option value="1">1 – Not Effective</option>
                    <option value="2">2 – Partially Effective</option>
                    <option value="3">3 – Fully Effective</option>
                    <option value="4">4 – Highly Effective</option>

                </select>
            </td>

            <td>
                <select name="KRA${kraCount}_AR"
                        class="form-control select-rating text-center"
                        style="border-color:#006838;background:#e8f5ee;">

                    <option value="">—</option>
                    <option value="1">1 – Not Effective</option>
                    <option value="2">2 – Partially Effective</option>
                    <option value="3">3 – Fully Effective</option>
                    <option value="4">4 – Highly Effective</option>

                </select>
            </td>

            <td class="text-center">
                <button type="button"
                        class="btn-remove-kra"
                        onclick="removeKra(${kraCount})">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;

        d2Body.appendChild(d2Row);


        // Update counters
        updateKraCount();

    }


    // ==========================================
    // REMOVE KRA FROM BOTH D1 AND D2
    // ==========================================

    function removeKra(number) {

        // Do not allow less than 4 KRAs
        if (kraCount <= 4) {
            alert("At least 4 KRAs are required.");
            return;
        }

        const d1Row = document.querySelector(
            `.d1-kra-row[data-kra="${number}"]`
        );

        const d2Row = document.querySelector(
            `.d2-kra-row[data-kra="${number}"]`
        );

        if (d1Row) {
            d1Row.remove();
        }

        if (d2Row) {
            d2Row.remove();
        }

        updateKraCount();
    }


    // ==========================================
    // UPDATE KRA COUNTERS
    // ==========================================

    function updateKraCount() {

        const d1Rows = document.querySelectorAll(".d1-kra-row");
        const d2Rows = document.querySelectorAll(".d2-kra-row");

        const d1Counter = document.getElementById("d1KraCount");
        const d2Counter = document.getElementById("d2KraCount");

        if (d1Counter) {
            d1Counter.textContent = d1Rows.length + " KRAs";
        }

        if (d2Counter) {
            d2Counter.textContent = d2Rows.length + " KRAs";
        }
    }
</script>